#   dtb_sha256      c8018843…  == baseline (identical)
#   ramdisk_sha256  4d4834e6…  == baseline unpack (identical)
#   cmdline                    == baseline (identical)
#   kernel_uts      same UTS   => ramdisk module vermagic matches
