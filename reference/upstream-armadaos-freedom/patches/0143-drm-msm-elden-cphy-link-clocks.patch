@@ -362,12 +365,30 @@
 
 	dsi_pll_calc_ssc(pll_7nm, &config);
 
+	/* Repeated ideal-rate requests can encode the running rate. */
+	if (of_machine_is_compatible("lenovo,elden") &&
+	    of_device_is_compatible(pll_7nm->phy->pdev->dev.of_node,
