 }
@@ -365,6 +376,9 @@
 		return 0;
 
 	clk_bulk_disable_unprepare(msm_host->num_bus_clks, msm_host->bus_clks);
+
+	if (of_machine_is_compatible("lenovo,elden"))
+		WRITE_ONCE(msm_host->link_configured, false);
 
