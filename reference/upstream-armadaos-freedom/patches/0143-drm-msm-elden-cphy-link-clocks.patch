+		dsi_pll_disable_pll_bias(pll_7nm);
+		if (pll_7nm->slave)
+			dsi_pll_disable_pll_bias(pll_7nm->slave);
+		wmb(); /* Complete failed startup cleanup before returning. */
+	}
 	return rc;
 }
 
