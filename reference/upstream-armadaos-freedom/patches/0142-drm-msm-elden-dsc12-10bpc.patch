From: Armada <noreply@armada.local>
Date: Wed, 14 Oct 2026 00:00:00 +0800
Subject: [PATCH] drm/msm: opt-in DSC 1.2 and 10-bpc handling for Elden
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Enable DSC 1.2 RC tables, a pin-derived initial-line calculation and
the SM8750 full-ICH-precision encoder bit for the LENOVO Legion Y700
Gen4 (lenovo,elden) panel, which drives 10-bpc streams over a single
multi-slice DSI packet.

Every behaviour change is gated on of_machine_is_compatible(
"lenovo,elden") (plus DSC 1.2 / bpc > 8 where relevant); the previous
programming path is preserved verbatim for all other panels. The
initial-line algorithm and the ENC_DF_CTRL bit 12 handling are derived
from the tb322fc-linux-kernel driver. Provenance:
  https://github.com/h0cheung/tb322fc-linux-kernel/commit/6f97250ead155fc3b980856323e99a4623dae73d

This is patch 0142; it is meant to be applied on top of 0141.

---
 drivers/gpu/drm/msm/dsi/dsi_host.c | 56 +-
 drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c | 64 +-
 drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c | 34 +-
 drivers/gpu/drm/msm/disp/dpu1/dpu_hw_catalog.h | 2 +
 drivers/gpu/drm/msm/disp/dpu1/catalog/dpu_12_0_sm8750.h | 24 +-
 drivers/gpu/drm/msm/disp/dpu1/dpu_hw_dsc_1_2.c | 12 +
 6 files changed, 174 insertions(+), 18 deletions(-)
---

diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index 1b8b7ab18f50..b9b571ba316d 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -1887,8 +1887,37 @@
 	return -EINVAL;
 }
 
+static u8 dsi_dsc_1_2_first_line_bpg_offset(const struct drm_dsc_config *dsc)
+{
+	u8 bpg_offset;
+	u8 uncompressed_bpg_rate;
+	u8 bpp = drm_dsc_get_bpp_int(dsc);
+
+	if (dsc->slice_height < 8)
+		bpg_offset = 2 * (dsc->slice_height - 1);
+	else if (dsc->slice_height < 20)
+		bpg_offset = 12;
+	else if (dsc->slice_height <= 30)
+		bpg_offset = 13;
+	else if (dsc->slice_height < 42)
+		bpg_offset = 14;
+	else
+		bpg_offset = 15;
+
+	if (dsc->native_422)
+		uncompressed_bpg_rate = 3 * bpp * 4;
+	else if (dsc->native_420)
+		uncompressed_bpg_rate = 3 * bpp;
+	else
+		uncompressed_bpg_rate = (3 * bpp + 2) * 3;
+
+	return min_t(u8, bpg_offset, uncompressed_bpg_rate - 3 * bpp);
+}
+
 static int dsi_populate_dsc_params(struct msm_dsi_host *msm_host, struct drm_dsc_config *dsc)
 {
+	enum drm_dsc_params_type params_type = DRM_DSC_1_1_PRE_SCR;
+	bool elden_dsc_1_2;
 	int ret;
 
 	if (dsc->bits_per_pixel & 0xf) {
@@ -1920,12 +1949,35 @@
 	drm_dsc_set_const_params(dsc);
 	drm_dsc_set_rc_buf_thresh(dsc);
 
-	/* DPU supports only pre-SCR panels */
-	ret = drm_dsc_setup_rc_params(dsc, DRM_DSC_1_1_PRE_SCR);
+	/*
+	 * DSC 1.2 panels need version-specific RC tables and an explicit
+	 * first-line bpg offset. Gate the new programming on the Elden panel
+	 * (single-packet multi-slice DSC); every other panel keeps the
+	 * historical pre-SCR behaviour.
+	 */
+	elden_dsc_1_2 = of_machine_is_compatible("lenovo,elden") &&
+			(msm_host->mode_flags &
+			 MIPI_DSI_MODE_DSC_ALL_SLICES_IN_PKT) &&
+			dsc->dsc_version_minor == 2;
+
+	if (elden_dsc_1_2) {
+		if (dsc->native_422)
+			params_type = DRM_DSC_1_2_422;
+		else if (dsc->native_420)
+			params_type = DRM_DSC_1_2_420;
+		else
+			params_type = DRM_DSC_1_2_444;
+	}
+
+	ret = drm_dsc_setup_rc_params(dsc, params_type);
 	if (ret) {
 		DRM_DEV_ERROR(&msm_host->pdev->dev, "could not find DSC RC parameters\n");
 		return ret;
 	}
+
+	if (elden_dsc_1_2)
+		dsc->first_line_bpg_offset =
+			dsi_dsc_1_2_first_line_bpg_offset(dsc);
 
 	dsc->initial_scale_value = drm_dsc_initial_scale_value(dsc);
 	dsc->line_buf_depth = dsc->bits_per_component + 1;
