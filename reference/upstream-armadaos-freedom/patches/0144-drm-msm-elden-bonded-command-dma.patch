 	u32 status = msm_host->err_work_state;
 
+	/*
+	 * An Elden bonded failure already reset both engines while holding
+	 * the pair mutex; do not race that explicit teardown.  This must
+	 * not take the pair mutex (the caller holds it).
+	 */
