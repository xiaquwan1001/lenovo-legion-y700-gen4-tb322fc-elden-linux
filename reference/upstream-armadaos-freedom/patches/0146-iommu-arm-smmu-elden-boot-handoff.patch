--- a/drivers/iommu/arm/arm-smmu/arm-smmu.h
+++ b/drivers/iommu/arm/arm-smmu/arm-smmu.h
@@ -308,6 +308,9 @@
 #define ARM_SMMU_FEAT_FMT_AARCH32_S	(1 << 11)
 #define ARM_SMMU_FEAT_EXIDS		(1 << 12)
 	u32				features;
+
+	/* Preserve firmware/bootloader stream mappings (e.g. boot splash) */
+	bool				preserve_boot_mappings;
 
 	enum arm_smmu_arch_version	version;
 	enum arm_smmu_implementation	model;
diff --git a/drivers/gpu/drm/msm/msm_kms.c b/drivers/gpu/drm/msm/msm_kms.c
--- a/drivers/gpu/drm/msm/msm_kms.c
+++ b/drivers/gpu/drm/msm/msm_kms.c
@@ -6,7 +6,9 @@
  */
 
 #include <linux/aperture.h>
+#include <linux/iommu.h>
 #include <linux/kthread.h>
+#include <linux/of.h>
 #include <linux/sched/mm.h>
 #include <uapi/linux/sched/types.h>
 
@@ -177,6 +179,38 @@
 	return -ENOSYS;
 }
 
+/*
+ * The lenovo,elden display path keeps the bootloader's splash framebuffer
+ * identity mapped by the SMMU (qcom,preserve-boot-mappings on the SM8750
+ * application SMMU).  In that case the display VM must not hand out IOVAs
+ * over the live framebuffer.  Detect exactly that setup: the SM8750 DPU whose
+ * real SMMU provider is the non-Adreno SM8750 SMMU with the preserve flag.
+ */
+static bool msm_kms_keep_bootfb_reserved(struct device *iommu_dev)
+{
+	struct device_node *np = iommu_dev->of_node;
+	struct of_phandle_args args;
+	bool ret;
+
+	if (!np || !of_machine_is_compatible("lenovo,elden"))
+		return false;
+
+	if (!of_device_is_compatible(np, "qcom,sm8750-dpu"))
+		return false;
+
+	if (of_parse_phandle_with_args(np, "iommus", "#iommu-cells", 0,
+				       &args))
+		return false;
+
+	ret = of_device_is_compatible(args.np, "qcom,sm8750-smmu-500") &&
+	      !of_device_is_compatible(args.np, "qcom,adreno-smmu") &&
+	      of_property_present(args.np, "qcom,preserve-boot-mappings");
+
+	of_node_put(args.np);
+
+	return ret;
+}
+
 struct drm_gpuvm *msm_kms_init_vm(struct drm_device *dev, struct device *mdss_dev)
 {
 	struct drm_gpuvm *vm;
@@ -185,6 +219,7 @@
 	struct msm_drm_private *priv = dev->dev_private;
 	struct msm_kms *kms = priv->kms;
 	struct device *iommu_dev;
+	u64 va_start = 0x1000, va_end = 0x100000000;
 
 	/*
 	 * IOMMUs can be a part of MDSS device tree binding, or the
@@ -203,8 +238,42 @@
 	if (IS_ERR(mmu))
 		return ERR_CAST(mmu);
 
-	vm = msm_gem_vm_create(dev, mmu, "mdp_kms",
-			       0x1000, 0x100000000 - 0x1000, true);
+	if (msm_kms_keep_bootfb_reserved(iommu_dev)) {
+		struct iommu_resv_region *region;
+		LIST_HEAD(resv_regions);
+		bool found = false;
+
+		/*
+		 * The live boot framebuffer is exposed by the SMMU as an
+		 * IOMMU_RESV_RESERVED region.  Cap the VM at its start so we
+		 * never allocate over it; the tail above it is intentionally
+		 * left unused while the boot mapping lives (it is not backed
+		 * by any gem object).  MSI/SW_MSI reservations are ignored.
+		 */
+		iommu_get_resv_regions(iommu_dev, &resv_regions);
+		list_for_each_entry(region, &resv_regions, list) {
+			if (region->type != IOMMU_RESV_RESERVED)
+				continue;
+			if (!region->length)
+				continue;
+			if (region->start < va_start || region->start >= va_end)
+				continue;
+			va_end = min_t(u64, va_end, region->start);
+			found = true;
+			break;
+		}
+		iommu_put_resv_regions(iommu_dev, &resv_regions);
+
+		if (!found || va_end <= va_start) {
+			dev_err(mdp_dev,
+				"no boot framebuffer reservation for preserved display VM\n");
+			mmu->funcs->destroy(mmu);
+			return ERR_PTR(-ENODEV);
+		}
+	}
+
+	vm = msm_gem_vm_create(dev, mmu, "mdp_kms", va_start,
+			       va_end - va_start, true);
 	if (IS_ERR(vm)) {
 		dev_err(mdp_dev, "vm create, error %pe\n", vm);
 		mmu->funcs->destroy(mmu);
