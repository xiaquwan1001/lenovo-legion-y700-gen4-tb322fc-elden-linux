				sde_dsi1_active: sde_dsi1_active {
					phandle = <0xd9>;

					mux {
						function = "gpio";
						pins = "gpio97";
					};

					config {
						bias-disable = <0x00>;
						drive-strength = <0x08>;
						pins = "gpio97";
					};
				};

				sde_dsi1_suspend: sde_dsi1_suspend {
