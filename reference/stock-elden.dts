	fragment@10 {
		target = <&spmi_bus>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pmih010x@7 {
				compatible = "qcom,spmi-pmic";
				reg = <0x07 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pmih010x_tz: pmih010x-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x07 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <&pmk8550_vadc>, <0x703>;
					io-channel-names = "thermal";
					phandle = <0x18>;
				};

				pmih010x_lite_tz: pmih010x-temp-alarm-lite@c00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xc00>;
					interrupts = <0x07 0x0c 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <&pmk8550_vadc>, <0x718>;
					io-channel-names = "thermal";
					phandle = <0x19>;
				};

				pmih010x_gpios: pinctrl@8800 {
					compatible = "qcom,pmih010x-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x98>;

					ufs_therm {

						ufs_therm_default: ufs_therm_default {
							pins = "gpio15";
							bias-high-impedance;
							phandle = <0x20>;
						};
					};

					fcam_ntc {

						fcam_ntc_default: fcam_ntc_default {
							pins = "gpio18";
							bias-high-impedance;
							phandle = <0x21>;
						};
					};

					top_chg_therm {

						top_chg_therm_default: top_chg_therm_default {
							pins = "gpio12";
							bias-high-impedance;
							phandle = <0x22>;
						};
					};

					batt2_pack_therm {

						batt2_pack_therm_default: batt2_pack_therm_default {
							pins = "gpio16";
							bias-high-impedance;
							phandle = <0x23>;
						};
					};
				};

				pmih010x_eusb2_repeater: eusb2-repeater@fd00 {
					compatible = "qcom,pmic-eusb2-repeater";
					reg = <0xfd00>;
					vdd18-supply = <&pm_humu_l15>;
					vdd3-supply = <&pm_humu_l5>;
					phandle = <0x99>;
				};

				pmih010x_haptics: qcom,hv-haptics@f000 {
					compatible = "qcom,hv-haptics";
					reg = <0xf000 0xf100 0xf200>;
					interrupts = <0x07 0xf0 0x01 0x01>;
					interrupt-names = "fifo-empty";
					qcom,vmax-mv = <0xe10>;
					qcom,lra-period-us = <0x1a0b>;
					qcom,brake-mode = <0x01>;
					qcom,brake-pattern = [ff 3f 1f];
					qcom,drv-sig-shape = <0x01>;
					qcom,brake-sig-shape = <0x01>;
					qcom,rt-imp-detect;
					nvmem-names = "hap_cfg_sdam";
					nvmem = <&pmk8550_sdam_46>;
					phandle = <0x9a>;

					hap_swr_slave_reg: qcom,hap-swr-slave-reg {
						regulator-name = "hap-swr-slave-reg";
						phandle = <0x9b>;
					};

					effect_0 {
						qcom,effect-id = <0x00>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = <0x7f7f7f7f>;
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					effect_1 {
						qcom,effect-id = <0x01>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f 7f 7f 7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					effect_2 {
						qcom,effect-id = <0x02>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					effect_3 {
						qcom,effect-id = <0x03>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					effect_4 {
						qcom,effect-id = <0x04>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					effect_5 {
						qcom,effect-id = <0x05>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f 7f 7f 7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					primitive_0 {
						qcom,primitive-id = <0x00>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = <0x00>;
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					primitive_1 {
						qcom,primitive-id = <0x01>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					primitive_2 {
						qcom,primitive-id = <0x02>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					primitive_3 {
						qcom,primitive-id = <0x03>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					primitive_4 {
						qcom,primitive-id = <0x04>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					primitive_5 {
						qcom,primitive-id = <0x05>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					primitive_6 {
						qcom,primitive-id = <0x06>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					primitive_7 {
						qcom,primitive-id = <0x07>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					primitive_8 {
						qcom,primitive-id = <0x08>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};
				};

				pmih010x_bcl: bcl@4700 {
					compatible = "qcom,bcl-v5";
					reg = <0x4700 0x100>;
					interrupts = <0x07 0x47 0x00 0x00 0x07 0x47 0x01 0x00 0x07 0x47 0x02 0x00>;
					interrupt-names = "bcl-lvl0", "bcl-lvl1", "bcl-lvl2";
					qcom,pmic7-threshold;
					#thermal-sensor-cells = <0x01>;
					phandle = <0x1a>;
				};

				pmih010x_bcl2: bcl@4900 {
					compatible = "qcom,bcl-v5";
					reg = <0x4900 0x100>;
					interrupts = <0x07 0x49 0x00 0x00 0x07 0x49 0x01 0x00 0x07 0x49 0x02 0x00>;
					interrupt-names = "bcl-lvl0", "bcl-lvl1", "bcl-lvl2";
					qcom,pmic7-threshold;
					#thermal-sensor-cells = <0x01>;
					status = "disabled";
					phandle = <0x9c>;
				};

				bcl_soc: bcl-soc {
					compatible = "qcom,msm-bcl-soc";
					#thermal-sensor-cells = <0x00>;
					phandle = <0x1b>;
				};
			};
		};
	};

	fragment@11 {
		target = <&thermal_zones>;

		__overlay__ {

			pmih010x_temp_alarm: pmih010x_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pmih010x_tz>;
				phandle = <0x9d>;

				trips {

					pmih010x_trip0: trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x9e>;
					};

					pmih010x_trip1: trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "hot";
						phandle = <0x9f>;
					};

					pmih010x_trip2: trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "critical";
						phandle = <0xa0>;
					};
				};
			};

			pmih010x_lite_temp_alarm: pmih010x_lite_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pmih010x_lite_tz>;
				phandle = <0xa1>;

				trips {

					pmih010x_lite_trip0: trip0 {
						temperature = <0x1e848>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0xa2>;
					};

					pmih010x_lite_trip1: trip1 {
						temperature = <0x20f58>;
						hysteresis = <0x00>;
						type = "hot";
						phandle = <0xa3>;
					};

					pmih010x_lite_trip2: trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "critical";
						phandle = <0xa4>;
					};
				};
			};

			pmih010x-ibat-lvl0 {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-sensors = <&pmih010x_bcl>, <0x00>;

				trips {

					ibat_lvl0: ibat-lvl0 {
						temperature = <0x34bc>;
						hysteresis = <0xc8>;
						type = "passive";
						phandle = <0xa5>;
					};
				};
			};

			pmih010x-ibat-lvl1 {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-sensors = <&pmih010x_bcl>, <0x01>;

				trips {

					ibat_lvl1: ibat-lvl1 {
						temperature = <0x3a98>;
						hysteresis = <0xc8>;
						type = "passive";
						phandle = <0xa6>;
					};
				};
			};

			vbat {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-sensors = <&pmih010x_bcl>, <0x02>;

				trips {

					vbat_lvl0: vbat-lvl0 {
						temperature = <0xaf0>;
						hysteresis = <0x64>;
						type = "passive";
						phandle = <0xa7>;
					};

					vbat_lvl1: vbat-lvl1 {
						temperature = <0xa28>;
						hysteresis = <0x64>;
						type = "passive";
						phandle = <0xa8>;
					};

					vbat_lvl2: vbat-lvl2 {
						temperature = <0x8fc>;
						hysteresis = <0x64>;
						type = "passive";
						phandle = <0xa9>;
					};
				};
			};

			pmih010x-bcl-lvl0 {
				polling-delay-passive = <0x32>;
				polling-delay = <0x00>;
				thermal-sensors = <&pmih010x_bcl>, <0x05>;

				trips {

					thermal-engine-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					thermal-hal-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					b_bcl_lvl0: b-bcl-lvl0 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x2d>;
					};
				};
			};

			pmih010x-bcl-lvl1 {
				polling-delay-passive = <0x32>;
				polling-delay = <0x00>;
				thermal-sensors = <&pmih010x_bcl>, <0x06>;

				trips {

					thermal-engine-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					thermal-hal-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					b_bcl_lvl1: b-bcl-lvl1 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x2e>;
					};
				};
			};

			pmih010x-bcl-lvl2 {
				polling-delay-passive = <0x32>;
				polling-delay = <0x00>;
				thermal-sensors = <&pmih010x_bcl>, <0x07>;

				trips {

					thermal-engine-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					thermal-hal-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					b_bcl_lvl2: b-bcl-lvl2 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x2f>;
					};
				};
			};

			socd {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-sensors = <&bcl_soc>;

				trips {

					thermal-engine-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					thermal-hal-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					socd_trip: socd-trip {
						temperature = <0x5a>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0xaa>;
					};
				};
			};
		};
	};

	fragment@12 {
		target = <&spmi_bus>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pmk8550@0 {
				compatible = "qcom,spmi-pmic";
				reg = <0x00 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pmk8550_sdam_1: sdam@7000 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7000>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					phandle = <0xab>;

					sm1510_present: sm1510_present@5d {
						reg = <0x5d 0x01>;
						bits = <0x05 0x05>;
						phandle = <0xac>;
					};

					ocp_log: ocp-log@76 {
						reg = <0x76 0x06>;
						phandle = <0x29>;
					};
				};

				pmk8550_sdam_2: sdam@7100 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7100>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					phandle = <0xad>;

					restart_reason: restart@48 {
						reg = <0x48 0x01>;
						bits = <0x01 0x07>;
						phandle = <0x26>;
					};

					wr_thermal_flag: wr_thermal-flag@58 {
						reg = <0x58 0x01>;
						phandle = <0x2c>;
					};

					alarm_log: alarm-log@76 {
						reg = <0x76 0x06>;
						phandle = <0x2a>;
					};

					fmd_set: fmd-set@9a {
						reg = <0x9a 0x01>;
						phandle = <0xae>;
					};

					fmd_cont_after_pon: fmd-cont-after-pon@9c {
						reg = <0x9c 0x01>;
						phandle = <0xaf>;
					};

					fmd_chg_pon: fmd-chg-pon@9f {
						reg = <0x9f 0x01>;
						phandle = <0xb0>;
					};

					fmd_cnt2_stop: fmd-cnt2-stop@a2 {
						reg = <0xa2 0x01>;
						phandle = <0xb1>;
					};
				};

				pmk8550_sdam_5: sdam@7400 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7400>;
					phandle = <0x27>;
				};

				pmk8550_sdam_6: sdam@7500 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7500>;
					phandle = <0x28>;
				};

				pmk8550_sdam_13: sdam@7c00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7c00>;
					phandle = <0x12>;
				};

				pmk8550_sdam_14: sdam@7d00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7d00>;
					phandle = <0x13>;
				};

				pmk8550_sdam_21: sdam@8400 {
					compatible = "qcom,spmi-sdam";
					reg = <0x8400>;
					phandle = <0x04>;
				};

				pmk8550_sdam_22: sdam@8500 {
					compatible = "qcom,spmi-sdam";
					reg = <0x8500>;
					phandle = <0x05>;
				};

				pmk8550_sdam_41: sdam@9800 {
					compatible = "qcom,spmi-sdam";
					reg = <0x9800>;
					phandle = <0x14>;
				};

				pmk8550_sdam_43: sdam@9a00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x9a00>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					phandle = <0xb2>;

					ibb_spur_sqm_timer: sqm-timer@b8 {
						reg = <0xb8 0x02>;
						phandle = <0x15>;
					};
				};

				pmk8550_sdam_46: sdam@9d00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x9d00>;
					phandle = <0x17>;
				};

				pmk8550_sdam_71: sdam@b600 {
					compatible = "qcom,spmi-sdam";
					reg = <0xb600>;
					phandle = <0xb3>;

					usb_mode: usb-mode@50 {
						reg = <0x50 0x01>;
						phandle = <0x3a>;
					};
				};

				pon_hlos@1300 {
					compatible = "qcom,pm8998-pon";
					reg = <0x1300 0x800>;
					reg-names = "pon_hlos", "pon_pbs";

					pwrkey {
						compatible = "qcom,pmk8350-pwrkey";
						interrupts = <0x00 0x13 0x07 0x03>;
						linux,code = <0x74>;
					};

					resin {
						compatible = "qcom,pmk8350-resin";
						interrupts = <0x00 0x13 0x06 0x03>;
						linux,code = <0x72>;
					};
				};

				pmk8550_gpios: pinctrl@b800 {
					compatible = "qcom,pmk8550-gpio";
					reg = <0xb800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					pinctrl-0 = <&alt_sleep_clk_default>;
					pinctrl-names = "default";
					phandle = <0xb4>;

					alt_sleep_clk {

						alt_sleep_clk_default: alt_sleep_clk_default {
							pins = "gpio3";
							function = "func1";
							input-disable;
							output-enable;
							bias-disable;
							power-source = <0x00>;
							phandle = <0x1c>;
						};
					};

					lcm_therm {

						lcm_therm_default: lcm_therm_default {
							pins = "gpio2";
							bias-high-impedance;
							phandle = <0x24>;
						};
					};
				};

				pmk8550_rtc: rtc@6100 {
					compatible = "qcom,pmk8350-rtc";
					reg = <0x6100 0x6200>;
					reg-names = "rtc", "alarm";
					interrupts = <0x00 0x62 0x01 0x01>;
					phandle = <0xb5>;
				};

				pmk8550-pwm {
					compatible = "qcom,pmk8550-pwm";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#pwm-cells = <0x02>;
				};

				pmk8550_vadc: vadc@9000 {
					compatible = "qcom,spmi-adc5-gen3";
					reg = <0x9000 0x9100>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					interrupt-names = "adc-sdam0", "adc-sdam1";
					interrupts = <0x00 0x90 0x01 0x01 0x00 0x91 0x01 0x01>;
					#thermal-sensor-cells = <0x01>;
					#io-channel-cells = <0x01>;
					io-channel-ranges;
					pinctrl-names = "default";
					pinctrl-0 = <&xo_therm_cust_default>, <&quiet_therm_default>, <&fast_chg_therm_default>, <&ufs_therm_default>, <&fcam_ntc_default>, <&top_chg_therm_default>, <&batt2_pack_therm_default>, <&lcm_therm_default>;
					phandle = <0x03>;

					pmk8550_offset_ref {
						reg = <0x00>;
						label = "pmk8550_offset_ref";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmk8550_vref_1p25 {
						reg = <0x01>;
						label = "pmk8550_vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmk8550_die_temp {
						reg = <0x03>;
						label = "pmk8550_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8550_offset_ref {
						reg = <0x100>;
						label = "pm8550_offset_ref";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8550_vref_1p25 {
						reg = <0x101>;
						label = "pm8550_vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8550_die_temp {
						reg = <0x103>;
						label = "pm8550_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8550_vph_pwr {
						reg = <0x18e>;
						label = "pm8550_vph_pwr";
						qcom,pre-scaling = <0x01 0x03>;
					};

					pmih010x_offset_ref {
						reg = <0x700>;
						label = "pmih010x_offset_ref";
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc5-gen4;
					};

					pmih010x_vref_1p25 {
						reg = <0x701>;
						label = "pmih010x_vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc5-gen4;
					};

					pmih010x_die_temp {
						reg = <0x703>;
						label = "pmih010x_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc5-gen4;
					};

					pmih010x_vph_pwr {
						reg = <0x78e>;
						label = "pmih010x_vph_pwr";
						qcom,pre-scaling = <0x01 0x03>;
						qcom,adc5-gen4;
					};

					pmih010x_vbat_sns_qbg {
						reg = <0x78f>;
						label = "pmih010x_vbat_sns_qbg";
						qcom,pre-scaling = <0x01 0x03>;
						qcom,adc5-gen4;
					};

					pmih010x_iin {
						reg = <0x717>;
						label = "pmih010x_iin";
						qcom,adc5-gen4;
					};

					pmih010x_ichg_fb {
						reg = <0x7a1>;
						label = "pmih010x_ichg_fb";
						qcom,adc5-gen4;
					};

					pmih010x_chg_temp {
						reg = <0x710>;
						label = "pmih010x_chg_temp";
						qcom,adc5-gen4;
					};

					pmih010x_lite_die_temp {
						reg = <0x718>;
						label = "pmih010x_lite_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc5-gen4;
					};

					pm8550vs_f_die_temp {
						reg = <0x503>;
						label = "pm8550vs_f_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8550vs_j_die_temp {
						reg = <0x903>;
						label = "pm8550vs_j_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8550ve_d_die_temp {
						reg = <0x303>;
						label = "pm8550ve_d_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8550ve_g_die_temp {
						reg = <0x603>;
						label = "pm8550ve_g_die_temp";
						qom,pre-scaling = <0x01 0x01>;
					};

					pm8550ve_i_die_temp {
						reg = <0x803>;
						label = "pm8550ve_i_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8550_ap_therm {
						reg = <0x144>;
						label = "pm8550_ap_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};

					pm8550_flash_led_ntc {
						reg = <0x145>;
						label = "pm8550_flash_led_ntc";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};

					pm8550_wlan_therm_cust {
						reg = <0x146>;
						label = "pm8550_wlan_therm_cust";
						qcom,ratiometric;
