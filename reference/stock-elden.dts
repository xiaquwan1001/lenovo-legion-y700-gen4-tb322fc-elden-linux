					qcom,pll-supply-entry@0 {
						qcom,supply-disable-load = <0x00>;
						qcom,supply-enable-load = <0x00>;
						qcom,supply-max-voltage = <0xffff>;
						qcom,supply-min-voltage = <0x180>;
						qcom,supply-name = "vdd_mx";
						reg = <0x00>;
					};
				};
			};

			smmu_sde_iommu_region_partition: smmu_sde_iommu_region_partition {
				phandle = <0xcd>;
				iommu-addresses = <&smmu_sde_unsec>, <0x00 0x60000>, <&smmu_sde_unsec>, <0xd4e23000 0x2dd000>, <&smmu_sde_unsec>, <0xd2880000 0x5780000>, <&smmu_sde_unsec>, <0xa3500000 0x2c80000>, <&smmu_sde_unsec>, <0xfc800000 0x2b00000>, <&smmu_sde_sec>, <0x00 0x20000>;
			};

			smmu_sde_unsec: qcom,smmu_sde_unsec_cb {
				phandle = <0xc0>;
				clock-names = "mdp_core_clk";
				clocks = <&dispcc>, <0x41>;
				dma-coherent;
				qcom,iommu-earlymap;
				qcom,iommu-faults = "non-fatal";
				memory-region = <&smmu_sde_iommu_region_partition>;
				iommus = <&apps_smmu>, <0x800 0x02>;
				compatible = "qcom,smmu_sde_unsec";
			};

			smmu_sde_sec: qcom,smmu_sde_sec_cb {
				phandle = <0xc1>;
				clock-names = "mdp_core_clk";
				clocks = <&dispcc>, <0x41>;
				qcom,iommu-vmid = <0x0a>;
