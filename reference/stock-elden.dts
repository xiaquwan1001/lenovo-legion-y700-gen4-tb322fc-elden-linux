					config {
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio97";
					};
				};

				sde_iovdd_enable: sde_iovdd_enable {
					phandle = <0xd6>;

					mux {
						function = "gpio";
						pins = "gpio161";
					};

					config {
						bias-pull-up;
						output-high;
						drive-strength = <0x08>;
						pins = "gpio161";
					};
				};

				sde_iovdd_disable: sde_iovdd_disable {
					phandle = <0xd7>;

					mux {
						function = "gpio";
						pins = "gpio161";
					};

					config {
						input-enable;
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio161";
					};
				};
			};

			pmx_sde_te: pmx_sde_te {
				phandle = <0x10d>;

				sde_te_active: sde_te_active {
					phandle = <0xd3>;

					mux {
