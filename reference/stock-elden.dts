						drive-strength = <0x02>;
						pins = "gpio86";
					};
				};

				sde_te_suspend: sde_te_suspend {
					phandle = <0xd5>;

					mux {
						function = "mdp_vsync";
						pins = "gpio86";
					};

					config {
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio86";
					};
				};

				sde_te1_active: sde_te1_active {
					phandle = <0xda>;

					mux {
						function = "mdp_vsync";
						pins = "gpio87";
					};

					config {
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio87";
					};
				};

				sde_te1_suspend: sde_te1_suspend {
					phandle = <0xde>;

					mux {
						function = "mdp_vsync";
						pins = "gpio87";
					};

					config {
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio87";
					};
				};
			};

			pmx_sde_esync: pmx_sde_esync {
				phandle = <0x10e>;

				sde_esync0_active: sde_esync0_active {
					phandle = <0x10f>;

					mux {
						function = "mdp_esync0_out";
						pins = "gpio88";
					};

					config {
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio88";
					};
				};

				sde_esync0_suspend: sde_esync0_suspend {
					phandle = <0x110>;

					mux {
						function = "mdp_esync0_out";
						pins = "gpio88";
					};

					config {
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio88";
					};
				};

				sde_esync1_active: sde_esync1_active {
					phandle = <0xdc>;

					mux {
						function = "mdp_esync1_out";
						pins = "gpio100";
					};

					config {
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio100";
					};
				};

				sde_esync1_suspend: sde_esync1_suspend {
					phandle = <0xdb>;

					mux {
						function = "mdp_esync1_out";
						pins = "gpio100";
					};

					config {
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio100";
					};
				};
			};
		};
	};

	fragment@52 {
