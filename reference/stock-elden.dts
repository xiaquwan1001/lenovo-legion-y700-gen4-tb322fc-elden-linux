	fragment@53 {
		target = <&tlmm>;

		__overlay__ {

			pmx_bl: pmx_bl {
				phandle = <0x111>;

				bl_active: bl_active {
					phandle = <0xe3>;

					mux {
						function = "gpio";
						pins = "gpio88";
					};

					config {
						output-high;
						bias-disable;
						drive-strength = <0x08>;
						pins = "gpio88";
					};
				};

				bl_sleep: bl_sleep {
					phandle = <0xe4>;

					mux {
						function = "gpio";
						pins = "gpio88";
					};

					config {
						input-enable;
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio88";
					};
				};

				bias_enp_active: bias_enp_active {
					phandle = <0xdf>;

					mux {
						function = "gpio";
						pins = "gpio72";
					};

					config {
						output-high;
						bias-pull-up;
						drive-strength = <0x10>;
						pins = "gpio72";
					};
				};

				bias_enp_sleep: bias_enp_sleep {
					phandle = <0xe1>;

					mux {
						function = "gpio";
						pins = "gpio72";
					};

					config {
						output-low;
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio72";
					};
				};

				bias_enn_active: bias_enn_active {
					phandle = <0xe0>;

					mux {
						function = "gpio";
						pins = "gpio73";
					};

					config {
						output-high;
						bias-pull-up;
						drive-strength = <0x10>;
						pins = "gpio73";
					};
				};

				bias_enn_sleep: bias_enn_sleep {
					phandle = <0xe2>;

					mux {
						function = "gpio";
						pins = "gpio73";
					};

					config {
						output-low;
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio73";
					};
				};
			};
		};
	};

	fragment@54 {
		target = <&qupv3_se10_i2c>;

		__overlay__ {
			status = "okay";

			bias@3e {
				pinctrl-3 = <&bias_enn_sleep>;
				pinctrl-2 = <&bias_enp_sleep>;
				pinctrl-1 = <&bias_enn_active>;
				pinctrl-0 = <&bias_enp_active>;
				pinctrl-names = "enp_active", "enn_active", "enp_sleep", "enn_sleep";
				reg = <0x3e>;
				compatible = "bias";
			};

			bl@11 {
				pinctrl-1 = <&bl_sleep>;
				pinctrl-0 = <&bl_active>;
				pinctrl-names = "default", "sleep";
				reg = <0x11>;
				compatible = "i2c-backlight";
			};

			bl@76 {
				pinctrl-1 = <&bl_sleep>;
				pinctrl-0 = <&bl_active>;
				pinctrl-names = "default", "sleep";
				reg = <0x76>;
				compatible = "i2c-backlight";
			};
		};
	};

	fragment@56 {
		target = <&soc>;

		__overlay__ {

			sde_wb1: qcom,wb-display@1 {
				phandle = <0xc2>;
				clock-names = "mdp_core_clk";
				clocks = <&dispcc>, <0x41>;
				label = "wb_display1";
				cell-index = <0x00>;
				compatible = "qcom,wb-display";
			};

			sde_wb2: qcom,wb-display@2 {
				phandle = <0xc3>;
				clock-names = "mdp_core_clk";
				clocks = <&dispcc>, <0x41>;
				label = "wb_display2";
				cell-index = <0x01>;
				compatible = "qcom,wb-display";
			};

			display_panel_avdd: display_gpio_regulator@1 {
				phandle = <0xe5>;
				pinctrl-names = "default";
				qcom,proxy-consumer-enable;
				proxy-supply = <&display_panel_avdd>;
				regulator-boot-on;
				enable-active-high;
				gpio = <&pm8550_gpios>, <0x0b 0x00>;
				regulator-enable-ramp-delay = <0xe9>;
				regulator-max-microvolt = <0x53ec60>;
				regulator-min-microvolt = <0x53ec60>;
				regulator-name = "display_panel_avdd";
				compatible = "qti-regulator-fixed";
			};

			disp_rdump_memory: disp_rdump_region@0xd5500000 {
				phandle = <0x113>;
