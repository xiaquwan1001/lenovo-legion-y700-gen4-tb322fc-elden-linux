	fragment@37 {
		target = <&qupv3_se4_spi>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "ok";

			novatek@0 {
				compatible = "novatek,NVT-ts-spi";
				reg = <0x00>;
				status = "ok";
				spi-max-frequency = <0x989680>;
				novatek,irq-gpio = <&tlmm>, <0xa2 0x2001>;
				novatek,pen-support;
				novatek,mp-support-dt;
				pinctrl-names = "cs_active", "cs_sleep";
				pinctrl-0 = <&qupv3_se4_spi_cs_active>;
				pinctrl-1 = <&qupv3_se4_spi_cs_sleep>;

				novatek-mp-criteria-6097@0 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					compatible = "novatek-mp-criteria-6097";
					IC_X_CFG_SIZE = <0x1e>;
					IC_Y_CFG_SIZE = <0x30>;
					IC_KEY_CFG_SIZE = <0x04>;
					X_Channel = <0x1e>;
					Y_Channel = <0x30>;
					AIN_X = <0x00 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10 0x11 0x12 0x13 0x14 0x15 0x16 0x17 0x18 0x19 0x1a 0x1b 0x1c 0x1d>;
