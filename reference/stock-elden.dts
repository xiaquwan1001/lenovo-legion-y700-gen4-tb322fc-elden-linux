	fragment@63 {
		target = <&tlmm>;

		__overlay__ {

			cnss_pins {

				cnss_wlan_en_active: cnss_wlan_en_active {
					phandle = <0x117>;

					mux {
						function = "gpio";
						pins = "gpio16";
					};

					config {
						bias-pull-up;
						output-high;
						drive-strength = <0x10>;
						pins = "gpio16";
					};
				};

				cnss_wlan_en_sleep: cnss_wlan_en_sleep {
					phandle = <0x118>;

					mux {
						function = "gpio";
						pins = "gpio16";
					};

					config {
						bias-pull-down;
						output-low;
						drive-strength = <0x02>;
						pins = "gpio16";
					};
				};

				cnss_wlan_sw_ctrl: cnss_wlan_sw_ctrl {
					phandle = <0x119>;

					mux {
						function = "wcn_sw_ctrl";
						pins = "gpio18";
					};
				};

				cnss_wlan_sw_ctrl_wl_cx: cnss_wlan_sw_ctrl_wl_cx {
					phandle = <0x11a>;

					mux {
						function = "wcn_sw";
						pins = "gpio19";
					};
				};

				cnss_host_sol_default: cnss_host_sol_default {
					phandle = <0x11b>;

					mux {
						function = "gpio";
						pins = "gpio202";
					};

					config {
						bias-pull-down;
						drive-strength = <0x04>;
						pins = "gpio202";
					};
				};
			};
		};
	};

