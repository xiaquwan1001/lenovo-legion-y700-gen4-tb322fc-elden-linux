				qcom,smb1501@68 {
					compatible = "qcom,i2c-pmic";
					reg = <0x68>;
					qcom,can-sleep;
				};

				qcom,smb1501@69 {
					compatible = "qcom,i2c-pmic";
					reg = <0x69>;
					qcom,can-sleep;
				};

				qcom,idt9418@3b {
					compatible = "qcom,i2c-pmic";
					reg = <0x3b>;
					qcom,can-sleep;
				};
			};
		};
	};

	fragment@30 {
		target = <&tlmm>;

		__overlay__ {

			vib_reset_l: vib_reset_l {
				phandle = <0x3f>;

				mux {
					pins = "gpio127";
					function = "gpio";
				};

				config {
					pins = "gpio127";
					bias-pull-up;
				};
			};

			vib_reset_r: vib_reset_r {
				phandle = <0x40>;

				mux {
					pins = "gpio119";
					function = "gpio";
				};

				config {
					pins = "gpio119";
					bias-pull-up;
				};
			};
		};
	};

	fragment@31 {
		target = <&qupv3_se6_i2c>;

		__overlay__ {
			status = "ok";
			qcom,clk-freq-out = <0xf4240>;

			haptic_hv_l@5A {
				compatible = "awinic,haptic_hv_l";
				reg = <0x5a>;
				irq-gpio = <&tlmm>, <0x63 0x00>;
				reset-gpio = <&tlmm>, <0x7f 0x00>;
				pinctrl-names = "default";
				pinctrl-0 = <&vib_reset_l>;
				f0_pre = <0x6a4>;
				mode = [05];
				aw8693x_f0_cali_percent = [0f];
				aw8693x_gain_bypass = [01];
				aw8693x_uvlo_vol_default = [00];
				aw8693x_cont_smart_loop = [00];
				aw8693x_cont_drv1_lvl = [7f];
				aw8693x_cont_lra_vrms = <0x3e8>;
				aw8693x_cont_drv1_time = [04];
				aw8693x_cont_drv2_time = [14];
				aw8693x_cont_track_margin = [0f];
				aw8693x_cont_brk_gain = [08];
				aw8693x_cont_brk_time = [04];
				aw8693x_duration_time = [14 1e 3c];
				aw8693x_d2s_gain = [02];
				aw8693x_trig_config = <0x01 0x20000 0x01 0x20000 0x01 0x20000>;
				aw8693x_bst_vol_default = <0x2134>;
				aw8693x_is_enabled_track_en;
			};

			haptic_hv_r@5B {
				compatible = "awinic,haptic_hv_r";
				reg = <0x5b>;
				irq-gpio = <&tlmm>, <0x5f 0x00>;
				reset-gpio = <&tlmm>, <0x77 0x00>;
				pinctrl-names = "default";
				pinctrl-0 = <&vib_reset_r>;
				f0_pre = <0x6a4>;
				mode = [05];
				aw8693x_f0_cali_percent = [0f];
				aw8693x_gain_bypass = [01];
				aw8693x_uvlo_vol_default = [00];
				aw8693x_cont_smart_loop = [00];
				aw8693x_cont_drv1_lvl = [7f];
				aw8693x_cont_lra_vrms = <0x3e8>;
				aw8693x_cont_drv1_time = [04];
				aw8693x_cont_drv2_time = [14];
				aw8693x_cont_track_margin = [0f];
				aw8693x_cont_brk_gain = [08];
				aw8693x_cont_brk_time = [04];
				aw8693x_duration_time = [14 1e 3c];
				aw8693x_d2s_gain = [02];
				aw8693x_trig_config = <0x01 0x20000 0x01 0x20000 0x01 0x20000>;
				aw8693x_bst_vol_default = <0x2134>;
				aw8693x_is_enabled_track_en;
			};
		};
	};

	fragment@32 {
		target = <&qupv3_se5_i2c>;

		__overlay__ {
			status = "ok";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			nxp_eusb2_repeater: eusb2_repeater@4f {
				status = "ok";
				compatible = "nxp,eusb2-repeater";
				reg = <0x4f>;
				vdd18-supply = <&pm_humu_l15>;
				vdd3-supply = <&pm_humu_l5>;
				reset-gpio = <&pm8550ve_i_gpios>, <0x06 0x00>;
				pinctrl-names = "default";
				pinctrl-0 = <&eusb2_reset_ctrl_default>;
				qcom,param-override-seq-c1 = <0x40 0x06 0x22 0x07 0x65 0x08 0x03 0x0a>;
				qcom,param-override-seq-c2 = <0x40 0x06 0x22 0x07 0x65 0x08 0x03 0x0a>;
				phandle = <0x43>;
			};
		};
	};

	fragment@33 {
		target = <&ucsi>;

		__overlay__ {
			gpios = <&tlmm>, <0x1d 0x00>;
		};
	};

	fragment@34 {
		target = <&eusb2_phy0>;

		__overlay__ {
			dummy-supply = <&nxp_eusb2_repeater>;
			usb-repeater = <&nxp_eusb2_repeater>;
		};
	};

	fragment@35 {
		target = <&soc>;

		__overlay__ {

			sys_temp_support {
				compatible = "lenovo,sys-temp";
				lenovo,temperature-names = "front_temp", "back_temp", "user_temp", "user_front_temp", "user_back_temp";
				lenovo,sensor-listener-names = "fcam-ntc", "quiet-therm", "usb2-conn-therm", "flash-led-ntc", "batt-pack-therm", "batt2-pack-therm", "ap-therm", "lcm-thermal";
				cust,all-ntc-names = "ap-therm", "flash-led-ntc", "wlan-therm", "usb2-conn-therm", "rear-cam-ntc", "xo-therm", "quiet-therm", "fast-chg-therm", "ufs-therm", "fcam-ntc", "top-chg-therm", "batt2-pack-therm", "batt-pack-therm", "usb1-conn-therm", "lcm-thermal";
			};
		};
	};

