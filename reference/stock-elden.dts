	fragment@71 {
		target = <&qupv3_se10_i2c>;

		__overlay__ {
			status = "okay";
			#size-cells = <0x00>;
			#address-cells = <0x01>;

			i2c_wl2868c@2F {
				pinctrl-0 = <&cam_ldo_en_gpio>;
				pinctrl-names = "default";
				reg = <0x2f>;
				compatible = "will,wl2868c";

				wl2868c_l1: ldo_1 {
					phandle = <0x126>;
					regulator-max-microvolt = <0x171240>;
					regulator-min-microvolt = <0x79180>;
					regulator-name = "ldo_1";
					ldo-channel = <0x00>;
				};

				wl2868c_l2: ldo_2 {
					phandle = <0x12b>;
					regulator-max-microvolt = <0x171240>;
					regulator-min-microvolt = <0x79180>;
					regulator-name = "ldo_2";
					ldo-channel = <0x01>;
				};

				wl2868c_l3: ldo_3 {
					phandle = <0x12a>;
					regulator-max-microvolt = <0x3613c0>;
					regulator-min-microvolt = <0x16f300>;
					regulator-name = "ldo_3";
					ldo-channel = <0x02>;
				};

				wl2868c_l4: ldo_4 {
					phandle = <0x125>;
					regulator-max-microvolt = <0x3613c0>;
					regulator-min-microvolt = <0x16f300>;
					regulator-name = "ldo_4";
					ldo-channel = <0x03>;
				};

				wl2868c_l5: ldo_5 {
					phandle = <0x123>;
					regulator-max-microvolt = <0x3613c0>;
					regulator-min-microvolt = <0x16f300>;
					regulator-name = "ldo_5";
					ldo-channel = <0x04>;
				};

				wl2868c_l6: ldo_6 {
					phandle = <0x12e>;
					regulator-max-microvolt = <0x3613c0>;
					regulator-min-microvolt = <0x16f300>;
					regulator-name = "ldo_6";
					ldo-channel = <0x05>;
				};

				wl2868c_l7: ldo_7 {
					phandle = <0x124>;
					regulator-max-microvolt = <0x3613c0>;
					regulator-min-microvolt = <0x16f300>;
					regulator-name = "ldo_7";
					ldo-channel = <0x06>;
				};
			};
		};
	};

	fragment@72 {
		target = <&tlmm>;

		__overlay__ {

			cam_ldo_en_gpio: cam_ldo_en_gpio {
				phandle = <0x12d>;

				mux {
					function = "gpio";
					pins = "gpio126";
				};

				config {
					output-high;
					bias-disable;
					pins = "gpio126";
				};
			};
		};
	};

	fragment@74 {
		target = <&tlmm>;

		__overlay__ {

			cnss_bt_sw_ctrl: cnss_wlan_sw_ctrl {
				phandle = <0x130>;

				mux {
					function = "wcn_sw_ctrl";
					pins = "gpio18";
				};
			};
		};
	};

	fragment@75 {
		target = <&soc>;

		__overlay__ {

			bluetooth: bt_peach {
				phandle = <0x132>;
				qcom,pdc_init_table = "{class: wlan_pdc, ss: rf, res: s5f.m, enable: 1}", "{class: wlan_pdc, ss: rf, res: s5f.v, enable: 1}", "{class: wlan_pdc, ss: rf, res: s5f.v, upval: 876}", "{class: wlan_pdc, ss: rf, res: s5f.v, dwnval: 876}";
				qcom,bt-vdd-wlan-aon-config = <0xd5de0 0xfcee0 0x00 0x00 0x01>;
				qcom,bt-vdd-wlan-aon-supply = <&S4D>;
				qcom,bt-vdd-rfa1p25-config = <0x140500 0x147260 0x00 0x01 0x00>;
				qcom,bt-vdd-rfa1p8-config = <0x1c61a0 0x1e8480 0x00 0x01 0x00>;
				qcom,bt-vdd-rfa0p75-config = <0xd5de0 0xf4240 0x00 0x01 0x00>;
				qcom,bt-vdd-dig-config = <0x88b80 0xfcee0 0x00 0x01 0x00>;
				qcom,bt-vdd-aon-config = <0xd5de0 0xf4240 0x00 0x01 0x01>;
				qcom,bt-vdd12-io-config = <0x124f80 0x124f80 0x7530 0x01 0x01>;
				qcom,bt-vdd18-aon-config = <0x1b7740 0x1b7740 0x7530 0x01 0x01>;
				qcom,bt-vdd-rfa1p25-supply = <&S7I>;
				qcom,bt-vdd-rfa1p8-supply = <&S3G>;
				qcom,bt-vdd-rfa0p75-supply = <&S5F>;
				qcom,bt-vdd-aon-supply = <&S5F>;
				qcom,bt-vdd-dig-supply = <&S4D>;
				qcom,bt-vdd12-io-supply = <&L2F>;
				qcom,bt-vdd18-aon-supply = <&L3F>;
				qcom,qmp = <&aoss_qmp>;
				qcom,bt-reset-gpio = <&pm8550ve_f_gpios>, <0x03 0x00>;
				qcom,bt-fmd-clk-gpio = <&pm8550ve_f_gpios>, <0x06 0x00>;
				qcom,bt-sw-ctrl-gpio = <&tlmm>, <0x12 0x00>;
				qcom,wl-reset-gpio = <&tlmm>, <0x10 0x00>;
				mpm_wake_set_gpios = <0x12 0x09>;
				pinctrl-2 = <&bt_fmd_clk_en>;
				pinctrl-1 = <&cnss_bt_sw_ctrl>;
				pinctrl-0 = <&bt_uwb_en>;
				pinctrl-names = "bt_uwb_en", "sw_ctrl", "bt_fmd_clk_en";
				qcom,peach-bt;
				clock-names = "bt_rf_clk1";
				clocks = <&rpmhcc>, <0x06>;
				nvmem-cell-names = "fmd_set", "fmd_chg_pon", "fmd_cnt2_stop";
				nvmem-cells = <&fmd_set>, <&fmd_chg_pon>, <&fmd_cnt2_stop>;
				compatible = "qcom,peach-bt";
			};
		};
	};

