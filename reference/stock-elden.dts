				reg = <0x34>;
				compatible = "awinic,aw882xx_smartpa";
			};

			aw882xx_smartpa@37 {
				status = "okay";
				aw-cali-mode = "none";
				aw-re-max = <0x7530>;
				aw-re-min = <0xfa0>;
				rename-flag = <0x01>;
				sound-channel = <0x01>;
				sync-load = <0x01>;
				irq-gpio = <&tlmm>, <0xa3 0x2008>;
				reset-gpio = <&tlmm>, <0x80 0x00>;
				reg = <0x37>;
				compatible = "awinic,aw882xx_smartpa";
			};
		};
	};

	fragment@88 {
		target = <&qupv3_se0_i2c>;

		__overlay__ {
			#size-cells = <0x00>;
			#address-cells = <0x01>;
			qcom,clk-freq-out = <0xf4240>;
			status = "disabled";

			st21nfc: st21nfc@08 {
				phandle = <0x217>;
				pinctrl-1 = <&nfc_int_suspend>, <&nfc_enable_suspend>;
				pinctrl-0 = <&nfc_int_active>, <&nfc_enable_active>;
				pinctrl-names = "nfc_active", "nfc_suspend";
				interrupt-names = "nfc_irq";
				interrupts = <0x4b 0x00>;
				interrupt-parent = <&tlmm>;
				clkreq-gpios = <&tlmm>, <0x23 0x00>;
				reset-gpios = <&tlmm>, <0x22 0x00>;
				irq-gpios = <&tlmm>, <0x4b 0x00>;
				reg = <0x08>;
				compatible = "st,st21nfc";
			};
		};
	};
};
