/dts-v1/;
/plugin/;

/ {
	model = "Qualcomm Technologies, Inc. Sun QRD SKU2 V8 Power Grid";
	compatible = "qcom,sun-qrd", "qcom,sun", "qcom,sunp-qrd", "qcom,sunp", "qcom,qrd";
	qcom,msm-id = <0x100026a 0x20000 0x27f 0x10000 0x26a 0x10000 0x27f 0x20000 0x26a 0x20000 0x100027f 0x10000 0x100026a 0x10000 0x100027f 0x20000>;
	qcom,board-id = <0x2000b 0x00>;

	fragment@0 {
		target = <&spmi_bus>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			pm8010_m: qcom,pm8010@c {
				compatible = "qcom,spmi-pmic";
				reg = <0x0c 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x49>;

				pm8010m_tz: pm8010m-temp-alarm@2400 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0x2400>;
					interrupts = <0x0c 0x24 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					phandle = <0x01>;
				};
			};

			pm8010_n: qcom,pm8010@d {
				compatible = "qcom,spmi-pmic";
				reg = <0x0d 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x4a>;

				pm8010n_tz: pm8010n-temp-alarm@2400 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0x2400>;
					interrupts = <0x0d 0x24 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					phandle = <0x02>;
				};
			};
		};
	};

	fragment@1 {
		target = <&thermal_zones>;

		__overlay__ {

			pm8010m_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8010m_tz>;

				trips {

					trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
					};

					trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "hot";
					};

					trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "critical";
					};
				};
			};

			pm8010n_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8010n_tz>;

				trips {

					trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
					};

					trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "hot";
					};

					trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "critical";
					};
				};
			};
		};
	};

	fragment@2 {
		target = <&spmi_bus>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pm8550@1 {
				compatible = "qcom,spmi-pmic";
				reg = <0x01 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pm8550_tz: pm8550-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x01 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <&pmk8550_vadc>, <0x103>;
					io-channel-names = "thermal";
					phandle = <0x06>;
				};

				pm8550_gpios: pinctrl@8800 {
					compatible = "qcom,pm8550-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x2b>;

					key_vol_up {

						key_vol_up_default: key_vol_up_default {
							pins = "gpio6";
							function = "normal";
							input-enable;
							bias-pull-up;
							power-source = <0x01>;
							phandle = <0x39>;
						};
					};

					xo_therm_cust {

						xo_therm_cust_default: xo_therm_cust_default {
							pins = "gpio12";
							bias-high-impedance;
							phandle = <0x1d>;
						};
					};

					quiet_therm {

						quiet_therm_default: quiet_therm_default {
							pins = "gpio4";
							bias-high-impedance;
							phandle = <0x1e>;
						};
					};

					fast_chg_therm {

						fast_chg_therm_default: fast_chg_therm_default {
							pins = "gpio3";
							bias-high-impedance;
							phandle = <0x1f>;
						};
					};

					display_panel_avdd_default: display_panel_avdd_default {
						phandle = <0x112>;
						qcom,drive-strength = <0x03>;
						power-source = <0x01>;
						bias-disable;
						output-enable;
						input-disable;
						function = "normal";
						pins = "gpio11";
					};
				};

				led-controller {
					compatible = "qcom,pm8350c-pwm";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#pwm-cells = <0x02>;
					nvmem = <&pmk8550_sdam_21>, <&pmk8550_sdam_22>;
					nvmem-names = "lpg_chan_sdam", "lut_sdam";

					led@1 {
						reg = <0x01>;
						color = <0x01>;
						label = "red";
					};

					led@2 {
						reg = <0x02>;
						color = <0x02>;
						label = "green";
					};

					led@3 {
						reg = <0x03>;
						color = <0x03>;
						label = "blue";
					};
				};

				pm8550_bcl: bcl@4700 {
					compatible = "qcom,pm8550-bcl-v5";
					reg = <0x4700 0x100>;
					interrupts = <0x01 0x47 0x00 0x00 0x01 0x47 0x01 0x00 0x01 0x47 0x02 0x00>;
					interrupt-names = "bcl-lvl0", "bcl-lvl1", "bcl-lvl2";
					qcom,pmic7-threshold;
					#thermal-sensor-cells = <0x01>;
					phandle = <0x07>;
				};

				pm8550_flash: qcom,flash_led@ee00 {
					compatible = "qcom,qti-pm8350c-flash-led";
					reg = <0xee00>;
					interrupts = <0x01 0xee 0x00 0x01 0x01 0xee 0x03 0x01 0x01 0xee 0x04 0x01>;
					interrupt-names = "led-fault-irq", "all-ramp-down-done-irq", "all-ramp-up-done-irq";
					qcom,thermal-derate-current = <0xc8 0x1f4>;
					status = "ok";
					phandle = <0x4b>;

					pm8550_flash0: qcom,flash_0 {
						label = "flash";
						qcom,led-name = "led:flash_0";
						qcom,max-current-ma = <0x5dc>;
						qcom,default-led-trigger = "flash0_trigger";
						qcom,id = <0x00>;
						qcom,duration-ms = <0x500>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x4c>;
					};

					pm8550_flash1: qcom,flash_1 {
						label = "flash";
						qcom,led-name = "led:flash_1";
						qcom,max-current-ma = <0x5dc>;
						qcom,default-led-trigger = "flash1_trigger";
						qcom,id = <0x01>;
						qcom,duration-ms = <0x500>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x4d>;
					};

					pm8550_flash2: qcom,flash_2 {
						label = "flash";
						qcom,led-name = "led:flash_2";
						qcom,max-current-ma = <0x5dc>;
						qcom,default-led-trigger = "flash2_trigger";
						qcom,id = <0x02>;
						qcom,duration-ms = <0x500>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x4e>;
					};

					pm8550_flash3: qcom,flash_3 {
						label = "flash";
						qcom,led-name = "led:flash_3";
						qcom,max-current-ma = <0x5dc>;
						qcom,default-led-trigger = "flash3_trigger";
						qcom,id = <0x03>;
						qcom,duration-ms = <0x500>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x4f>;
					};

					pm8550_torch0: qcom,torch_0 {
						label = "torch";
						qcom,led-name = "led:torch_0";
						qcom,max-current-ma = <0x1f4>;
						qcom,default-led-trigger = "torch0_trigger";
						qcom,id = <0x00>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x50>;
					};

					pm8550_torch1: qcom,torch_1 {
						label = "torch";
						qcom,led-name = "led:torch_1";
						qcom,max-current-ma = <0x1f4>;
						qcom,default-led-trigger = "torch1_trigger";
						qcom,id = <0x01>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x51>;
					};

					pm8550_torch2: qcom,torch_2 {
						label = "torch";
						qcom,led-name = "led:torch_2";
						qcom,max-current-ma = <0x1f4>;
						qcom,default-led-trigger = "torch2_trigger";
						qcom,id = <0x02>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x52>;
					};

					pm8550_torch3: qcom,torch_3 {
						label = "torch";
						qcom,led-name = "led:torch_3";
						qcom,max-current-ma = <0x1f4>;
						qcom,default-led-trigger = "torch3_trigger";
						qcom,id = <0x03>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x53>;
					};

					pm8550_switch0: qcom,led_switch_0 {
						label = "switch";
						qcom,led-name = "led:switch_0";
						qcom,default-led-trigger = "switch0_trigger";
						qcom,led-mask = <0x09>;
						qcom,symmetry-en;
						phandle = <0x54>;
					};

					pm8550_switch1: qcom,led_switch_1 {
						label = "switch";
						qcom,led-name = "led:switch_1";
						qcom,default-led-trigger = "switch1_trigger";
						qcom,led-mask = <0x06>;
						qcom,symmetry-en;
						phandle = <0x55>;
					};

					pm8550_switch2: qcom,led_switch_2 {
						label = "switch";
						qcom,led-name = "led:switch_2";
						qcom,default-led-trigger = "switch2_trigger";
						qcom,led-mask = <0x0f>;
						qcom,symmetry-en;
						phandle = <0x56>;
					};
				};
			};
		};
	};

	fragment@3 {
		target = <&thermal_zones>;

		__overlay__ {

			pm8550_temp_alarm: pm8550_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8550_tz>;
				phandle = <0x57>;

				trips {

					pm8550_trip0: trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x58>;
					};

					pm8550_trip1: trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "hot";
						phandle = <0x59>;
					};

					pm8550_trip2: trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "critical";
						phandle = <0x5a>;
					};
				};
			};

			pm8550-bcl-lvl0 {
				polling-delay-passive = <0x32>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8550_bcl>, <0x05>;

				trips {

					bcl_lvl0: bcl-lvl0 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x30>;
					};
				};
			};

			pm8550-bcl-lvl1 {
				polling-delay-passive = <0x32>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8550_bcl>, <0x06>;

				trips {

					bcl_lvl1: bcl-lvl1 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x31>;
					};
				};
			};

			pm8550-bcl-lvl2 {
				polling-delay-passive = <0x32>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8550_bcl>, <0x07>;

				trips {

					bcl_lvl2: bcl-lvl2 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x32>;
					};
				};
			};
		};
	};

	fragment@4 {
		target = <&spmi_bus>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			pm8550ve_d: qcom,pm8550ve@3 {
				compatible = "qcom,spmi-pmic";
				reg = <0x03 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "ok";
				phandle = <0x5b>;

				pm8550ve_d_tz: pm8550ve-d-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x03 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <&pmk8550_vadc>, <0x303>;
					io-channel-names = "thermal";
					phandle = <0x08>;
				};

				pm8550ve_d_gpios: pinctrl@8800 {
					compatible = "qcom,pm8550ve-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x5c>;
				};
			};

			pm8550ve_f: qcom,pm8550ve@5 {
				compatible = "qcom,spmi-pmic";
				reg = <0x05 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "ok";
				phandle = <0x5d>;

				pm8550ve_f_tz: pm8550ve-f-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x05 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <&pmk8550_vadc>, <0x503>;
					io-channel-names = "thermal";
					phandle = <0x09>;
				};

				pm8550ve_f_gpios: pinctrl@8800 {
					compatible = "qcom,pm8550ve-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x5e>;

					bt_uwb_en: bt_uwb_en {
						phandle = <0x12f>;
						power-source = <0x01>;
						bias-disable;
						output-enable;
						input-disable;
						function = "normal";
						pins = "gpio3";
					};

					bt_fmd_clk_en: bt_fmd_clk_en {
						phandle = <0x131>;
						power-source = <0x01>;
						bias-disable;
						output-disable;
						input-enable;
						function = "normal";
						pins = "gpio6";
					};
				};
			};

			pm8550ve_g: qcom,pm8550ve@6 {
				compatible = "qcom,spmi-pmic";
				reg = <0x06 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "ok";
				phandle = <0x5f>;

				pm8550ve_g_tz: pm8550ve-g-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x06 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <&pmk8550_vadc>, <0x603>;
					io-channel-names = "thermal";
					phandle = <0x0a>;
				};

				pm8550ve_g_gpios: pinctrl@8800 {
					compatible = "qcom,pm8550ve-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x60>;
				};
			};

			pm8550ve_i: qcom,pm8550ve@8 {
				compatible = "qcom,spmi-pmic";
				reg = <0x08 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "ok";
				phandle = <0x61>;

				pm8550ve_i_tz: pm8550ve-i-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x08 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <&pmk8550_vadc>, <0x803>;
					io-channel-names = "thermal";
					phandle = <0x0b>;
				};

				pm8550ve_i_gpios: pinctrl@8800 {
					compatible = "qcom,pm8550ve-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x41>;

					eusb2_reset_ctrl {

						eusb2_reset_ctrl_default: eusb2_reset_ctrl_default {
							pins = "gpio6";
							function = "normal";
							input-enable;
							output-enable;
							bias-disable;
							power-source = <0x01>;
							qcom,drive-strength = <0x02>;
							phandle = <0x42>;
						};
					};
				};
			};
		};
	};

	fragment@5 {
		target = <&thermal_zones>;

		__overlay__ {

			pm8550ve_d_temp_alarm: pm8550ve_d_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8550ve_d_tz>;
				status = "ok";
				phandle = <0x62>;

				trips {

					pm8550ve_d_trip0: trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x36>;
					};

					pm8550ve_d_trip1: trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "hot";
						phandle = <0x63>;
					};

					pm8550ve_d_trip2: trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "critical";
						phandle = <0x64>;
					};
				};
			};

			pm8550ve_f_temp_alarm: pm8550ve_f_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8550ve_f_tz>;
				status = "ok";
				phandle = <0x65>;

				trips {

					pm8550ve_f_trip0: trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x34>;
					};

					pm8550ve_f_trip1: trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "hot";
						phandle = <0x66>;
					};

					pm8550ve_f_trip2: trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "critical";
						phandle = <0x67>;
					};
				};
			};

			pm8550ve_g_temp_alarm: pm8550ve_g_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8550ve_g_tz>;
				status = "ok";
				phandle = <0x68>;

				trips {

					pm8550ve_g_trip0: trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x37>;
					};

					pm8550ve_g_trip1: trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "hot";
						phandle = <0x69>;
					};

					pm8550ve_g_trip2: trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "critical";
						phandle = <0x6a>;
					};
				};
			};

			pm8550ve_i_temp_alarm: pm8550ve_i_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8550ve_i_tz>;
				status = "ok";
				phandle = <0x6b>;

				trips {

					pm8550ve_i_trip0: trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x38>;
					};

					pm8550ve_i_trip1: trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
