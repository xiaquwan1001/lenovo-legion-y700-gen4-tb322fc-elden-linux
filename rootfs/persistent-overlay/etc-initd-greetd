#!/sbin/openrc-run
# /etc/init.d/greetd — 项目补丁版（2026-10-18）
# 原版问题：depend() 只有 need localmount；冷起时 seatd/elogind 未就绪 → greetd 崩溃，
# 表现为「开机无桌面、loginctl 无会话、phoc 不启动」。
# 本版：① after seatd elogind；② 交给 supervise-daemon 守护（崩溃 5 s 后重起，最多 10 次）。

name="greetd"
description="Greeter daemon"

: ${cfgfile:="/etc/greetd/config.toml"}

command=/usr/sbin/greetd
command_args="--config $cfgfile ${command_args:-}"
pidfile="/run/$RC_SVCNAME.pid"

supervisor=supervise-daemon
respawn_delay_seconds=5
respawn_max=10
output_log=/var/log/greetd.log
error_log=/var/log/greetd.log

required_files="$cfgfile"

start_pre() {
	# note that this user is the user from the config.toml
	local homedir="$(getent passwd greetd | cut -d: -f6)"
	checkpath -d -m750 -o greetd:greetd "$homedir"
	checkpath -f -m640 -o root:root /var/log/greetd.log

	# 冷起竞态（2026-10-26 POR 实测）：`after elogind` 只保证启动顺序，不保证
	# elogind 的 D-Bus/seat 已就绪；pam_elogind 此时建会话失败 ⇒ greeter 立即退出，
	# respawn_max 耗尽后服务 stopped，表现=开机无桌面。等 seat0 可见（≤30 s）。
	local i=0
	while [ "$i" -lt 60 ]; do
		loginctl show-seat seat0 >/dev/null 2>&1 && break
		i=$((i + 1))
		sleep 0.5
	done
	[ "$i" -lt 60 ] || echo "greetd: warn: seat0 not ready after 30s" >&2

	# 启动日志降噪结束：恢复 console loglevel（dmesg 始终保留全量）。
	echo 7 > /proc/sys/kernel/printk 2>/dev/null || true
}

depend() {
	need localmount
	after seatd elogind
	provide display-manager
}
