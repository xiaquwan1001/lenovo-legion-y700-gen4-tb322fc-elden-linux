# ============================================================
# y700-elden 版本控制边界
# 纳管：文档 / 脚本 / 内核补丁与 config / AI 记忆与技能 / 小体积证据
# 排除：大二进制、可再生成产物、上游 clone、运行时状态、设备敏感数据
# 台账与清理标记见 RESOURCES.md §3；清理优先级见 RESOURCES.md §2.5
# 注意：gitignore 注释必须独占一行；整目录忽略会阻止 `!` 复活子文件
# ============================================================

# ---- 上游 clone / 可重下（含巨大构建产物）----
# geekidos-linux = 上游 GEEKiDoS/linux（13G，含构建产物）；内核进度以 patches/ 为准
/geekidos-linux
# 软链 linux -> geekidos-linux（2026-11-21 恢复源树时重建；勿入库）
/linux
/Y700-elden-linux
/stock-src/
/qdl/
# /tools 用 /* 而非整目录忽略（同 /out 的理由）：整目录忽略会让 `!` 复活失效。
# 2026-11-06：原 `/tools/` 档口使 tools/mkbootimg 换机后全丢（.pi/memory/MEMORY.md 2026-10-17 条）。
# 现纳管「小体积 / 自研 / 上游取件成本高」的文本工具，只挡构建产物与二进制。
/tools/*
!/tools/avbtool.py
!/tools/l2-extract/
!/tools/gunyah-modules/
/tools/gunyah-modules/*/*.dtb
/tools/gunyah-modules/*/*.bin
/tools/gunyah-modules/*/vmmtest
/tools/gunyah-modules/*/rmtest
/tools/gunyah-modules/*/hypprobe
/edk2-gunyah/
/edk2-gunyah-qemu/
# G1-29 资源：SM8750/TB322FC UEFI 设备包 + 原厂 DXE 备份（2026-10-05 落盘，见 RESOURCES §1.6/§3）
/mu_wide_platforms/
/uefi-firmware-backup/

# ---- 构建产物 / 可再生成 ----
# /build = 2026-10-10 起内核构建目录（scripts/build-kernel.sh 工作区，~4G 可再生）
/build
# 2026-11-02 起 lane 工作树与外部工作区归项目内（不再散落 $HOME）
/wt/
/external
# /out 用 /* 而非整目录忽略：否则 `!` 无法复活子文件（git 规则）；manifest 是可复现指纹，要入库
/out/*
!/out/*.manifest
/bootslot-b-u2/
/logs/
# /runs = lane 实跑回执工作区（2026-11-20 起；runs/<lane>/REPORT.md + 原始日志/取证件，含 pstoredump 一类百 MB 件）
# 与 /logs/ 同类：可再生成/体量大 ⇒ 整目录不入库；要长期留存的结论写进 reports/ 或 patches/ 下的 runs/
/runs/
/pkgs/
/pkgs-phosh/
/pkgs-x86/
/probe/
/twrp/
/y700四代工具/
/flashing-bundle/
/rootfs/alpine/
/rootfs/dl/
/rootfs/debs/

# ---- 大目录但保留少量文本 ----
/env-pass/*
!/env-pass/scripts/
!/env-pass/tools/

/bootslot-b/*
!/bootslot-b/README.md

/backup/*
!/backup/fw/
/backup/fw/*
!/backup/fw/README.md

# 保留证据文本（分区列表 / getvar / pre-unlock 基线 / dmesg）
!/backup/elden-dump.txt
!/backup/HA2EXB0E-16+512/
/backup/HA2EXB0E-16+512/*
!/backup/HA2EXB0E-16+512/*.txt
!/backup/HA2EXB0E-16+512/SHA256SUMS.unlock
!/backup/HA2EXB0E-16+512/pre-unlock/
!/backup/HA2EXB0E-16+512/pre-unlock/*.txt
!/backup/HA2EXB0E-16+512/pre-unlock/SHA256SUMS

/restore-259/*
!/restore-259/*.md

