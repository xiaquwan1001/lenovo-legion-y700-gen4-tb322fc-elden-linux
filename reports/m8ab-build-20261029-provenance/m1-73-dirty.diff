+/*
+ * B1: record one bonded-command failure and latch only once the retry budget
+ * is exhausted.  Before the budget runs out the caller is allowed to try
+ * again; `msm_dsi_manager_cmd_failed()` keeps returning false so the normal
+ * bridge callbacks (including their cleanup paths) still run.
+ */
+static void dsi_mgr_note_cmd_failure(const char *why)
+{
+	int n = ++dsi_bonded_cmd_fail_count;
+
+	if (n >= DSI_BONDED_CMD_MAX_RETRY) {
+		WRITE_ONCE(dsi_bonded_cmd_failed, true);
+		pr_err("dsi: bonded command failed %d times (%s), giving up\n",
+		       n, why);
+	} else {
+		pr_warn("dsi: bonded command failure %d/%d (%s), will retry\n",
+			n, DSI_BONDED_CMD_MAX_RETRY, why);
+	}
