-			bt_dev_err(hu->hdev, "SSR or FW download time out");
-			ret = -ETIMEDOUT;
-			goto error;
+			if (ssr) {
+				/* The controller is dumping its RAM; powering the
+				 * system down now would lose the dump and leave the
+				 * device in an unknown state.
+				 */
+				bt_dev_err(hu->hdev, "SSR time out");
+				ret = -ETIMEDOUT;
+				goto error;
+			}
