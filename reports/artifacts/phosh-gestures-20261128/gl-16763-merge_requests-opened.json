/phoc!786"},"web_url":"https://gitlab.gnome.org/World/Phosh/phoc/-/merge_requests/786","time_stats":{"time_estimate":0,"total_time_spent":0,"human_time_estimate":null,"human_total_time_spent":null},"squash":false,"squash_on_merge":false,"task_completion_status":{"count":2,"completed_count":0},"has_conflicts":false,"blocking_discussions_resolved":true},{"id":121570,"iid":753,"project_id":16763,"title":"Keep focus on the selected workspace","description":"Currently the view focus bounces across workspaces when switching workspaces or deleting views.\n\nSet focus to the first view in the selected workspace when switching the workspace with a keybinding. If the workspace does not have views, unfocus. (If there are other ways to change workspaces which do not involve selecting windows, then they also need fixing.)\n\nWhen a view is destroyed, set focus to the first view in the same workspace, on unfocus if there are no views.","state":"opened","created_at":"2026-01-24T19:40:36.130Z","updated_at":"2026-02-28T12:53:39.481Z","merged_by":null,"merge_user":null,"merged_at":null,"closed_by":null,"closed_at":null,"target_branch":"main","source_branch":"workspace-focus","user_notes_count":14,"upvotes":1,"downvotes":0,"author":{"id":15454,"username":"tpikonen","public_email":"","name":"Teemu Ikonen","state":"active","locked":false,"avatar_url":"https://secure.gravatar.com/avatar/23a747ef9781a50d4612a380e97ca8f5bde5702bbf29d27219245294567fa205?s=80\u0026d=identicon","web_url":"https://gitlab.gnome.org/tpikonen","bot":false},"assignees":[],"assignee":null,"reviewers":[],"source_project_id":37730,"target_project_id":16763,"labels":[],"draft":false,"imported":false,"imported_from":"none","work_in_progress":false,"milestone":null,"merge_when_pipeline_succeeds":false,"merge_status":"cannot_be_merged_recheck","detailed_merge_status":"need_rebase","merge_after":null,"sha":"583c1aef02f6e3a5bd2099814398b168afe33f7a","merge_commit_sha":null,"squash_commit_sha":null,"discussion_locked":null,