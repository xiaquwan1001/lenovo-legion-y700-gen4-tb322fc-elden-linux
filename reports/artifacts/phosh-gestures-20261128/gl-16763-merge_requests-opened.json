57:29.251Z","allow_collaboration":true,"allow_maintainer_to_push":true,"reference":"!819","references":{"short":"!819","relative":"!819","full":"World/Phosh/phoc!819"},"web_url":"https://gitlab.gnome.org/World/Phosh/phoc/-/merge_requests/819","time_stats":{"time_estimate":0,"total_time_spent":0,"human_time_estimate":null,"human_total_time_spent":null},"squash":false,"squash_on_merge":false,"task_completion_status":{"count":0,"completed_count":0},"has_conflicts":false,"blocking_discussions_resolved":true},{"id":125972,"iid":788,"project_id":16763,"title":"Draft: Allow to blur textures","description":"This adds the basic bits to blur textures. It depends on a two wlroots MRs\n\n- https://gitlab.freedesktop.org/wlroots/wlroots/-/merge_requests/5351\n- https://gitlab.freedesktop.org/wlroots/wlroots/-/merge_requests/5347\n\nThe decision what to blur is currently just a PoC. We do that based on the layer surface name and don't take any content into account. We can do that later on either via protocol or configuration. \n\nAdding this will allow us to do more visual effects on the compositor side if desired.","state":"opened","created_at":"2026-04-24T10:14:06.377Z","updated_at":"2026-08-04T08:59:50.003Z","merged_by":null,"merge_user":null,"merged_at":null,"closed_by":null,"closed_at":null,"target_branch":"main","source_branch":"render/blur","user_notes_count":0,"upvotes":0,"downvotes":0,"author":{"id":1029,"username":"guidog","public_email":"","name":"Guido Günther","state":"active","locked":false,"avatar_url":"https://secure.gravatar.com/avatar/2db348f1d0d0888423e5699c53ef899d81fc16e81d0aeddda0a1971ff1b2f7ec?s=80\u0026d=identicon","web_url":"https://gitlab.gnome.org/guidog","bot":false},"assignees":[],"assignee":null,"reviewers":[],"source_project_id":16793,"target_project_id":16763,"labels":[],"draft":true,"imported":false,"imported_from":"none","work_in_progress":true,"milestone":null,"merge_when_pipeline_succeeds":false,"merge_status":"cannot_be_merged_recheck","detail