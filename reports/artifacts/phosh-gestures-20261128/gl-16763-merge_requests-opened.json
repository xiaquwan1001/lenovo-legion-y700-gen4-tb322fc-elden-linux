[{"id":139217,"iid":828,"project_id":16763,"title":"layer-shell-effects: Compensate for offset when accepting drag gesture","description":"A drag is only accepted after the touch point moved a bit. Syncing the\nsurface with the finger position makes it jump on gesture acceptance.\nCompensate for that by substracting the acceptance offset.\n\nThis avoids flicker when pulling up phosh's bottom bar, right below\nthe bar as the animation on the phosh side can now start in sync.\n\n@niko this should help to sync with the overlay transition.\n\nCloses: https://gitlab.gnome.org/World/Phosh/phoc/-/work_items/374\nSigned-off-by: Guido Günther \u003cagx@sigxcpu.org\u003e","state":"opened","created_at":"2026-11-19T19:42:26.027Z","updated_at":"2026-11-20T18:35:50.400Z","merged_by":null,"merge_user":null,"merged_at":null,"closed_by":null,"closed_at":null,"target_branch":"main","source_branch":"drag-jump","user_notes_count":2,"upvotes":1,"downvotes":0,"author":{"id":1029,"username":"guidog","public_email":"","name":"Guido Günther","state":"active","locked":false,"avatar_url":"https://secure.gravatar.com/avatar/2db348f1d0d0888423e5699c53ef899d81fc16e81d0aeddda0a1971ff1b2f7ec?s=80\u0026d=identicon","web_url":"https://gitlab.gnome.org/guidog","bot":false},"assignees":[],"assignee":null,"reviewers":[],"source_project_id":16793,"target_project_id":16763,"labels":[],"draft":false,"imported":false,"imported_from":"none","work_in_progress":false,"milestone":{"id":3118,"iid":43,"group_id":61154,"title":"Phosh 0.60.0","description":"","state":"active","created_at":"2026-05-26T17:22:24.061Z","updated_at":"2026-05-26T17:22:24.061Z","due_date":"2026-12-24","start_date":null,"expired":false,"web_url":"https://gitlab.gnome.org/groups/World/Phosh/-/milestones/43"},"merge_when_pipeline_succeeds":false,"merge_status":"unchecked","detailed_merge_status":"unchecked","merge_after":null,"sha":"3e432b38f032cfadeeec8e401a0fc289c77a4bef","merge_commit_sha":null,"squash_commit_sha":null,"discussion_locked