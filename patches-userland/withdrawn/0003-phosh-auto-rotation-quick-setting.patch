diff -ruN a/plugins/auto-rotation-quick-setting/meson.build b/plugins/auto-rotation-quick-setting/meson.build
--- a/plugins/auto-rotation-quick-setting/meson.build	1970-01-01 08:00:00.000000000 +0800
+++ b/plugins/auto-rotation-quick-setting/meson.build	2026-10-11 12:53:41.469790468 +0800
@@ -0,0 +1,42 @@
+name = 'auto-rotation-quick-setting'
+
+auto_rotation_quick_setting_resources = gnome.compile_resources(
+  'phosh-plugin-auto-rotation-quick-setting-resources',
+  'phosh-plugin-auto-rotation-quick-setting.gresources.xml',
+  c_name: 'phosh_plugin_auto_rotation_quick_setting',
+)
+
+auto_rotation_quick_setting_plugin_sources = files(
+  'auto-rotation-quick-setting.c',
+  'phosh-plugin-auto-rotation-quick-setting.c',
+)
+
+phosh_auto_rotation_quick_setting_plugin = shared_module(
+  'phosh-plugin-auto-rotation-quick-setting',
+  auto_rotation_quick_setting_plugin_sources,
+  auto_rotation_quick_setting_resources,
+  c_args: [
+    '-DG_LOG_DOMAIN="phosh-plugin-@0@"'.format(name),
+    '-DPLUGIN_NAME="@0@"'.format(name),
+  ],
+  dependencies: [plugin_dep],
+  install: true,
+  install_dir: plugins_dir,
+)
+
+pluginconf = configuration_data()
+pluginconf.set('name', name)
+pluginconf.set('plugins_dir', plugins_dir)
+
+i18n.merge_file(
+  input: configure_file(
+    input: name + '.desktop.in.in',
+    output: name + '.desktop.in',
+    configuration: pluginconf,
+  ),
+  output: name + '.plugin',
+  po_dir: join_paths(meson.project_source_root(), 'po'),
+  install: true,
+  install_dir: plugins_dir,
+  type: 'desktop',
+)
