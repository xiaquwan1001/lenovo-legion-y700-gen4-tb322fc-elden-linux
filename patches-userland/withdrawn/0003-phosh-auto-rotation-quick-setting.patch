diff -ruN a/plugins/auto-rotation-quick-setting/auto-rotation-quick-setting.c b/plugins/auto-rotation-quick-setting/auto-rotation-quick-setting.c
--- a/plugins/auto-rotation-quick-setting/auto-rotation-quick-setting.c	1970-01-01 08:00:00.000000000 +0800
+++ b/plugins/auto-rotation-quick-setting/auto-rotation-quick-setting.c	2026-10-11 12:53:41.467486987 +0800
@@ -0,0 +1,107 @@
+/*
+ * Copyright (C) 2026 The Phosh Developers
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#include "auto-rotation-quick-setting.h"
+
+#include <glib/gi18n.h>
+
+/**
+ * PhoshAutoRotationQuickSetting:
+ *
+ * An explicit on/off switch for automatic screen orientation.
+ *
+ * It reads and writes the same persistent GSettings key as the built-in
+ * rotation tile (org.gnome.settings-daemon.peripherals.touchscreen::
+ * orientation-lock): when the orientation is locked the screen no longer
+ * follows the accelerometer, i.e. auto-rotation is off.
+ */
+
+#define ORIENTATION_LOCK_SCHEMA_ID "org.gnome.settings-daemon.peripherals.touchscreen"
+#define ORIENTATION_LOCK_KEY       "orientation-lock"
+
+struct _PhoshAutoRotationQuickSetting {
+  PhoshQuickSetting parent;
+
+  GSettings        *settings;
+  PhoshStatusIcon  *info;
+};
+
+G_DEFINE_TYPE (PhoshAutoRotationQuickSetting, phosh_auto_rotation_quick_setting, PHOSH_TYPE_QUICK_SETTING);
+
+
+static void
+update_state (PhoshAutoRotationQuickSetting *self)
+{
+  gboolean locked = g_settings_get_boolean (self->settings, ORIENTATION_LOCK_KEY);
+  gboolean auto_rotate = !locked;
+
+  g_object_set (self->info,
+                "icon-name", auto_rotate ? "rotation-allowed-symbolic"
+                                         : "rotation-locked-symbolic",
+                "info", auto_rotate ? _("Auto-rotation on") : _("Auto-rotation off"),
+                NULL);
+  phosh_quick_setting_set_active (PHOSH_QUICK_SETTING (self), auto_rotate);
+}
+
+
+static void
+on_clicked (PhoshAutoRotationQuickSetting *self)
+{
+  gboolean locked = g_settings_get_boolean (self->settings, ORIENTATION_LOCK_KEY);
+
+  g_settings_set_boolean (self->settings, ORIENTATION_LOCK_KEY, !locked);
+}
+
+
+static void
+on_orientation_lock_changed (PhoshAutoRotationQuickSetting *self,
+                             char                          *_key,
+                             GSettings                     *_settings)
+{
+  update_state (self);
+}
+
+
+static void
+phosh_auto_rotation_quick_setting_finalize (GObject *object)
+{
+  PhoshAutoRotationQuickSetting *self = PHOSH_AUTO_ROTATION_QUICK_SETTING (object);
+
+  g_clear_object (&self->settings);
+
+  G_OBJECT_CLASS (phosh_auto_rotation_quick_setting_parent_class)->finalize (object);
+}
+
+
+static void
+phosh_auto_rotation_quick_setting_class_init (PhoshAutoRotationQuickSettingClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
+
+  object_class->finalize = phosh_auto_rotation_quick_setting_finalize;
+
+  gtk_widget_class_set_template_from_resource (widget_class,
+    "/mobi/phosh/plugins/auto-rotation-quick-setting/qs.ui");
+
+  gtk_widget_class_bind_template_child (widget_class, PhoshAutoRotationQuickSetting, info);
+
+  gtk_widget_class_bind_template_callback (widget_class, on_clicked);
+}
+
+
+static void
+phosh_auto_rotation_quick_setting_init (PhoshAutoRotationQuickSetting *self)
+{
+  gtk_widget_init_template (GTK_WIDGET (self));
+
+  self->settings = g_settings_new (ORIENTATION_LOCK_SCHEMA_ID);
+
+  update_state (self);
+
+  g_signal_connect_swapped (self->settings, "changed::" ORIENTATION_LOCK_KEY,
+                            (GCallback) on_orientation_lock_changed, self);
+}
