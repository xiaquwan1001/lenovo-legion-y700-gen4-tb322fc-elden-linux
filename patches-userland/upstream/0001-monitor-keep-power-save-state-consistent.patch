From 88a0e2375404973e82565ad303ccd21dab2681c1 Mon Sep 17 00:00:00 2001
From: Qianhui Xu <xiaqinghuan@mail.ustc.edu.cn>
Date: Sat, 14 Nov 2026 20:13:59 +0800
Subject: [PATCH] monitor: Keep power save state consistent when output power
 setup fails

phosh requests a zwlr_output_power_v1 object for each output in
phosh_monitor_constructed(). That request can be refused: wlroots allows a
single power object per output, so when another client already owns one for
the panel, phosh gets the "failed" event and the compositor destroys the
resource on its side, leaving phosh with a proxy that can no longer be used.

wlr_output_power_handle_failed() only emitted a warning, which left
PhoshMonitor.power_mode at its initial value
PHOSH_MONITOR_POWER_SAVE_MODE_OFF. PhoshScreenSaverManager derives its
"active" state from that value:

    active = (mode == PHOSH_MONITOR_POWER_SAVE_MODE_OFF);

so the shell came up considering the panel already blanked. "active" then
never changed again, because no further power-mode notifications can arrive,
and on_power_button_pressed() returns early for both the press and the
release half while "active" is TRUE. The user visible symptoms are:

 * org.gnome.ScreenSaver.GetActive() returns TRUE although the panel is lit
   and GetActiveTime() stays at zero,
 * a short press on the power key does nothing at all,
 * idle blanking never happens either,
 * while suspending from the power menu keeps working, as that path goes
   through logind and never consults "active", which makes the failure mode
   hard to diagnose.

Remember the refusal, assume the output is on (the only state consistent
with the shell being able to draw), and stop talking to the compositor about
power for that output: requests on the dead proxy would go nowhere, and
reporting the requested mode locally keeps the screen saver manager, the
power key and the lock screen consistent. Whether the panel really blanks is
then up to the compositor that owns the power object.

Signed-off-by: Qianhui Xu <xiaqinghuan@mail.ustc.edu.cn>
---
 src/monitor/monitor.c | 34 ++++++++++++++++++++++++++++++++++
 src/monitor/monitor.h |  1 +
 2 files changed, 35 insertions(+)

diff --git a/src/monitor/monitor.c b/src/monitor/monitor.c
index 413e700..45ad4aa 100644
--- a/src/monitor/monitor.c
+++ b/src/monitor/monitor.c
@@ -261,6 +261,17 @@ wlr_output_power_handle_mode(void *data,
 }
 
 
+static void
+phosh_monitor_set_power_mode (PhoshMonitor *self, PhoshMonitorPowerSaveMode mode)
+{
+  if (self->power_mode == mode)
+    return;
+
+  self->power_mode = mode;
+  g_object_notify_by_pspec (G_OBJECT (self), props[PHOSH_MONITOR_PROP_POWER_MODE]);
+}
+
+
 static void
 wlr_output_power_handle_failed(void *data,
                                struct zwlr_output_power_v1 *output_power)
@@ -268,7 +279,20 @@ wlr_output_power_handle_failed(void *data,
   PhoshMonitor *self = PHOSH_MONITOR (data);
 
   g_return_if_fail (PHOSH_IS_MONITOR (self));
+
   g_warning("Failed to set output power mode for %s\n", self->name);
+
+  /* The compositor can't hand us power control for this output. That happens
+   * when it is already owned by another client (wlroots allows a single
+   * zwlr_output_power_v1 per output) or when the output is gone, and the
+   * request being refused destroys the proxy on the compositor side. We can
+   * no longer observe or request power mode changes, so assume the output is
+   * on instead of leaving the initial "off" state in place: a #PhoshMonitor
+   * that starts out as blanked makes the screen saver manager treat the
+   * screen as already blanked, which in turn disables the power button and
+   * idle blanking for the whole session. */
+  self->output_power_unavailable = TRUE;
+  phosh_monitor_set_power_mode (self, PHOSH_MONITOR_POWER_SAVE_MODE_ON);
 }
 
 
@@ -473,6 +497,7 @@ phosh_monitor_init (PhoshMonitor *self)
 {
   self->modes = g_array_new (FALSE, FALSE, sizeof(PhoshMonitorMode));
   self->power_mode = PHOSH_MONITOR_POWER_SAVE_MODE_OFF;
+  self->output_power_unavailable = FALSE;
 }
 
 
@@ -627,6 +652,15 @@ phosh_monitor_set_power_save_mode (PhoshMonitor *self, PhoshMonitorPowerSaveMode
   g_return_if_fail (phosh_monitor_is_configured (self));
   g_return_if_fail (self->wlr_output_power);
 
+  /* Without a working zwlr_output_power_v1 we can't reach the compositor.
+   * Keep our own state consistent so that the screen saver manager, the power
+   * button and the lock screen keep working; whether the panel really blanks
+   * is up to the compositor then. */
+  if (self->output_power_unavailable) {
+    phosh_monitor_set_power_mode (self, mode);
+    return;
+  }
+
   switch (mode) {
   case PHOSH_MONITOR_POWER_SAVE_MODE_OFF:
     wl_mode = ZWLR_OUTPUT_POWER_V1_MODE_OFF;
diff --git a/src/monitor/monitor.h b/src/monitor/monitor.h
index 30763dd..ecabf40 100644
--- a/src/monitor/monitor.h
+++ b/src/monitor/monitor.h
@@ -115,6 +115,7 @@ struct _PhoshMonitor {
   struct zxdg_output_v1 *xdg_output;
   struct zwlr_output_power_v1 *wlr_output_power;
   PhoshMonitorPowerSaveMode power_mode;
+  gboolean output_power_unavailable;
 
   int x, y, width, height;
   int subpixel;
-- 
