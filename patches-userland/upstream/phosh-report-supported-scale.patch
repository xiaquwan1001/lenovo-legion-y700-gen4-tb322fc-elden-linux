+/* The compositor reports the current output scale through the wlroots
+ * output-management protocol, which carries it as a 24.8 fixed-point value.
+ * Together with phoc's own 1/120 rounding this means the value we read back
+ * can differ slightly from the one we advertised as supported.  Since
+ * gnome-control-center matches the current scale against the advertised list
+ * with an exact (DBL_EPSILON) comparison, such a value fails to match any
+ * entry and the scale row falls back to showing 100%.
+ *
+ * Snap the reported scale back onto the nearest advertised scale so the
+ * round-trip stays stable and the correct scale is displayed.
+ */
+static double
+phosh_head_snap_to_supported_scale (PhoshHead *head, double scale)
+{
+  g_autofree float *scales = NULL;
+  double best = scale, best_dist = G_MAXDOUBLE;
+  int n;
+
+  if (head->mode == NULL)
+    return scale;
+
+  scales = phosh_util_calculate_supported_mode_scales (head->mode->width,
+                                                       head->mode->height,
+                                                       &n, TRUE);
+  for (int i = 0; i < n; i++) {
+    double dist = fabs ((double)scales[i] - scale);
+
+    if (dist < best_dist) {
+      best_dist = dist;
+      best = (double)scales[i];
+    }
+  }
+
+  /* Only snap when we're within the quantization error so that genuinely
+   * unsupported scales are still reported as-is. */
+  if (best_dist > 0.01)
+    return scale;
+
+  return best;
+}
+
 
 static gboolean
 phosh_monitor_manager_handle_get_current_state (PhoshDBusDisplayConfig *skeleton,
