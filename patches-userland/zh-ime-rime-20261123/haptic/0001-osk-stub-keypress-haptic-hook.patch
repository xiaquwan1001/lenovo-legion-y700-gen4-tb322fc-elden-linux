> 0001-osk-stub-keypress-haptic-hook.patch — phosh-osk-stub 0.46 每键震动钩子（env 开关）
> 基线：phosh-osk-stub 0.46.0 src/pos-input-surface.c，on_osk_key_symbol()（:380）
> 语义：ELDEN_OSK_HAPTIC_DEV 未设 ⇒ 与上游逐字节一致；设了 ⇒ 每键 spawn 一次 ffrumble。
> 幅度/时长默认 30 ms / 0x3333，ELDEN_OSK_HAPTIC_MS / ELDEN_OSK_HAPTIC_MAG 覆盖。
--- a/src/pos-input-surface.c
+++ b/src/pos-input-surface.c
@@ -386,6 +386,20 @@
 
   g_debug ("Key: '%s' symbol", symbol);
 
+  /* elden: per-keypress haptic feedback (env-gated; no env = upstream behavior) */
+  {
+    const char *hdev = g_getenv ("ELDEN_OSK_HAPTIC_DEV");
+
+    if (hdev && *hdev) {
+      g_autofree char *cmd = g_strdup_printf (
+        "/usr/local/bin/ffrumble %s %s %s",
+        hdev,
+        g_getenv ("ELDEN_OSK_HAPTIC_MS")  ?: "30",
+        g_getenv ("ELDEN_OSK_HAPTIC_MAG") ?: "0x3333");
+      g_spawn_command_line_async (cmd, NULL); /* fire-and-forget */
+    }
+  }
+
   /* Latched modifiers, send as virtual-keyboard */
   if (self->latched_modifiers) {
     PosKeycodeModifier modifier;
