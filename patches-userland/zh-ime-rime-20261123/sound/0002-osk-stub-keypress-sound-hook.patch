> sound/0002 — phosh-osk-stub 0.46 每键按键音钩子（v2，2026-11-25）
> 选点：pos_input_surface_notify_key_press() = click hook / keypad / emoji / symbol 的公共汇聚点，
>   一次按键恰好一次 spawn；与 haptic 补丁（on_osk_key_symbol）不同 hunk，可叠加。
> 语义：**默认总是调包装脚本**，由 /usr/local/bin/osk-keysound 读 /etc/elden-keyboard.conf
>   的 SOUND=1 决定播不播（GUI 改完立刻生效）；env 只用于强制关闭（ELDEN_OSK_SOUND=0）
>   与覆盖（ELDEN_OSK_SOUND_CMD / _VOL）。env 不能当开关的原因：/etc/environment 只在
>   会话登录时读一次，改完要重启会话才生效。
--- a/src/pos-input-surface.c
+++ b/src/pos-input-surface.c
@@ -239,6 +239,25 @@
 {
   g_autoptr (LfbEvent) event = NULL;
 
+  /* elden: per-keypress key sound.
+   * 2026-11-25 设计：默认「总是调包装脚本」，由 /usr/local/bin/osk-keysound 自己读
+   * /etc/elden-keyboard.conf 决定播不播（SOUND=0 时 1 行退出）。
+   * 为什么不用 env 当开关：/etc/environment 只在**会话登录时**读一次，改完要重启会话才生效，
+   * 而 GUI 改 conf 必须立刻生效。env 现在只用来**强制关闭**（ELDEN_OSK_SOUND=0）。 */
+  {
+    const char *snd = g_getenv ("ELDEN_OSK_SOUND");
+
+    if (!snd || strcmp (snd, "0") != 0) {
+      const char *vol = g_getenv ("ELDEN_OSK_SOUND_VOL");
+
+      if (vol && *vol)
+        g_setenv ("ELDEN_OSK_KEYSOUND_VOL", vol, TRUE);
+      g_spawn_command_line_async (
+        g_getenv ("ELDEN_OSK_SOUND_CMD") ?: "/usr/local/bin/osk-keysound",
+        NULL); /* fire-and-forget, silent on failure */
+    }
+  }
+
   g_assert (POS_IS_INPUT_SURFACE (self));
 
   event = lfb_event_new ("button-pressed");
