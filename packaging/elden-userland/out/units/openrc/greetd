name="greetd"
description="Greeter daemon (patched: respawn + after seatd/elogind)"

# 参数：conf.d 覆盖 services.tsv 里的默认值（同一份 conf.d 两种 init 都读）
[ -f "/etc/conf.d/greetd" ] && . "/etc/conf.d/greetd"
: "${LIBSEAT_BACKEND:=seatd}"
export LIBSEAT_BACKEND

command="/usr/sbin/greetd"
command_args="--config /etc/greetd/config.toml"
command_background="yes"
pidfile="/run/greetd.pid"
output_log="/var/log/greetd.log"
error_log="/var/log/greetd.log"
supervisor="supervise-daemon"
respawn_delay_seconds=5
respawn_max=10
depend() {
	need localmount
	after seatd elogind
	provide display-manager
}

start_pre() {
	# hooks/greetd.pre — 启动前置（等价原 /etc/init.d/greetd 的 start_pre）
	#
	# 原 start_pre 用 OpenRC 的 `checkpath` 建 greetd 用户 home 与日志文件。
	# 这里改成发行版无关的等价实现：**不能省** —— home 不存在时 greetd 直接退出，
	# 表现就是 PITFALLS #318 的「开机无桌面 / loginctl 无会话」。

	# 用户名按发行版不同：Alpine 用 `greetd`，Debian 用 `_greetd`（2026-10-26 实测，
	# Debian 根上按 `greetd` 查会直接 exit 1 ⇒ greetd 服务 203/EXEC ⇒ 无桌面）。
	# 两边都试，取第一个存在的；owner 也用解析出的名字，避免 install -o greetd 在 Debian 上失败。
	guser=
	for _u in greetd _greetd; do
		getent passwd "$_u" >/dev/null 2>&1 && { guser=$_u; break; }
	done
	if [ -z "$guser" ]; then
		echo "elden/greetd.pre: 用户 greetd/_greetd 都不存在（包未装？）" >&2
		exit 1
	fi
	homedir=$(getent passwd "$guser" | cut -d: -f6)
	[ -n "$homedir" ] || { echo "elden/greetd.pre: $guser 无 home" >&2; exit 1; }
	install -d -m 750 -o "$guser" -g "$guser" "$homedir"
	install -d -m 755 /var/log
	[ -e /var/log/greetd.log ] || : > /var/log/greetd.log
	chown root:root /var/log/greetd.log
	chmod 640 /var/log/greetd.log

	# 冷起竞态（2026-10-26 POR 实测）：`after elogind` 只保证启动顺序，不保证
	# elogind 的 D-Bus/seat 已就绪；pam_elogind 建会话失败 ⇒ greeter 退出、服务 stopped。
	# 等 seat0 可见（≤30 s）；超时只告警不阻塞。
	_i=0
	while [ "$_i" -lt 60 ]; do
		loginctl show-seat seat0 >/dev/null 2>&1 && break
		_i=$((_i + 1))
		sleep 0.5
	done
	[ "$_i" -lt 60 ] || echo "elden/greetd.pre: warn: seat0 not ready after 30s" >&2

	# 启动日志降噪结束：恢复 console loglevel（dmesg 始终保留全量）。
	echo 7 > /proc/sys/kernel/printk 2>/dev/null || true
}
