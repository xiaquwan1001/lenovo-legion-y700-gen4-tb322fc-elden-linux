name="iio-sensor-proxy"
description="iio-sensor-proxy (patched: waits for QRTR svc 400 = SSC)"

# 参数：conf.d 覆盖 services.tsv 里的默认值（同一份 conf.d 两种 init 都读）
[ -f "/etc/conf.d/iio-sensor-proxy" ] && . "/etc/conf.d/iio-sensor-proxy"
# 无默认参数

command="/usr/libexec/iio-sensor-proxy"
command_args=""
