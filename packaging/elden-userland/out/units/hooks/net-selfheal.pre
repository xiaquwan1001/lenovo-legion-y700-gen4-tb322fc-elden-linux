# hooks/net-selfheal.pre — 等 wlan 就绪再自愈（原 /etc/local.d/elden-bringup.start 的等待逻辑）
#
# 为什么必须等（reports/net-https-mtu-rootcause-20261018.md）：wlan 起来之前跑会漏掉 MTU，
# 而 PMTU 黑洞正是要修的东西 ⇒ 必须有界等待，超时照常执行（不劣于原行为）。
#
# ★2026-10-31 修（PITFALLS #475）：原判据是 `ip -br link | grep -q '^wlan.*UP'`。
#   那个名字是 **Alpine 的 `wlan0`**；Debian/NetworkManager 把同一块卡叫 **`wlp1s0`**
#   ⇒ 正则永远不匹配 ⇒ **每轮启动都白等满 120 s**（实测 net-selfheal 在 15:32:04 打
#   "wlan 未在 120 s 内 UP"，而 NetworkManager 日志显示 `wlp1s0` 在开机 ~9 s 就已 activated）。
#   现按「任意 wl* 无线接口、UP 且已有全局 IPv4」判据，上限压到 20 s：
#   在这台机上实测 wlan 约 9 s 可用 ⇒ 20 s 既留余量又不拖启动。
i=0
while [ "$i" -lt 20 ]; do
	if ip -br addr 2>/dev/null | grep -qE '^wl[^ ]+ +UP +([0-9]{1,3}\.){3}[0-9]{1,3}/'; then
		exit 0
	fi
	i=$((i + 1))
	sleep 1
done
echo "elden: net-selfheal: wlan 未在 20 s 内拿到 IPv4，照常执行（不阻断启动）" >&2
exit 0
