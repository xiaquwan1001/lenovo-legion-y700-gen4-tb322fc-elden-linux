#!/bin/sh
# greetd session target: xuqianhui1001 with proper XDG/Wayland env.
# greetd + PAM (pam_elogind) provides:
#   XDG_RUNTIME_DIR, XDG_SESSION_ID, XDG_SEAT, XDG_VTNR
#   DBUS_SESSION_BUS_ADDRESS (via dbus-launch in phosh-session)
#   WAYLAND_DISPLAY (set by phoc compositor)

export LIBSEAT_BACKEND=seatd
export XDG_CURRENT_DESKTOP=Phosh:GNOME
export XDG_SESSION_DESKTOP=phosh
export XDG_SESSION_TYPE=wayland
export GDK_BACKEND=wayland
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM=wayland
export SDL_VIDEODRIVER=wayland
export CLUTTER_BACKEND=wayland
export EGL_PLATFORM=surfaceless

# 输入法策略（2026-11-21 用户裁决，落实 11-15 台账 T4）：**GTK 客户端不走 fcitx IM 模块**。
# 原因 = PITFALLS #618：GTK 走 im-fcitx5.so 时客户端**不发** zwp_text_input_v3.enable
#   ⇒ phoc 收不到 ⇒ 虚拟键盘（sm.puri.OSK0 / phosh-osk-stub）**不会自动弹**。
# 代价 = GTK 应用内失去 fcitx 组词（#653 实测本栈 GTK3 本就不建 fcitx IC）⇒ 中文组词延后。
# 为什么先显式 export QT/XMODIFIERS：im-config 的 /etc/X11/Xsession.d/70im-config_launch
#   有「已设置则 hands off」分支（`[ -z "$XMODIFIERS" ] && [ -z "$GTK_IM_MODULE" ] …`），
#   先占住这两个变量它就不会再写回 GTK_IM_MODULE。
export QT_IM_MODULE=fcitx
export XMODIFIERS=@im=fcitx
unset GTK_IM_MODULE 2>/dev/null || true

# T19（2026-11-14）：**不要再让客户端用 dmabuf 修饰符导入**。
# 本机（msm + freedreno + wlroots 0.20 + phoc 0.59）上，带 `QCOM_COMPRESSED`
# (=0x0500000000000001) modifier 的 dmabuf 导入会产出：滚动撕裂/抽搐/方格/文字鬼影/
# 大幅移动变形（用户实测）。禁用后视觉全正常，代价=首次绘制多一次回拷（第一下略卡，
# 另有 GPU 爬频补偿，见 rootfs/debian/daily-baseline.sh §5）。
# 回归判据：`wayland-info` 仍会列出 QCOM_COMPRESSED（那是合成器侧），但本变量只影响客户端。
export MESA_EXTENSION_OVERRIDE="-EGL_EXT_image_dma_buf_import_modifiers${MESA_EXTENSION_OVERRIDE:+ $MESA_EXTENSION_OVERRIDE}"
# 与之配对：默认 GSK 渲染器（GTK 4.24 的 ngl/vulkan 档）在本机仍会抽搐+残留画面；
# 只有 `gl` 档 + 上面的 modifier 关闭才是实测干净组合（2026-11-14 用户目视，T19）。
export GSK_RENDERER=gl

# 软件合成档（2026-11-19 立）：开关 = /etc/elden-soft-render，缺省不开。
# 为什么要有：Debian 13 trixie 自带 Mesa 25.0.7 的 freedreno 不认识 Adreno 830
#   （`MESA: error: fd_pipe_new2: unsupported GPU id 0x0 / chip id 0xe844050000`）
#   ⇒ phoc 的 GL 后端起不来、greetd 5 s 内连挂 5 次后 `start-limit-hit`
#   （`check_children: greeter exited without creating a session`），屏上只有黑底转圈。
# 处置：`touch /etc/elden-soft-render` ⇒ phoc 走 pixman 软合成 + GSK 走 cairo，桌面起得来
#   （代价 = CPU 合成，动画/滚动不如 GPU）。**GPU 恢复条件** = 换上认识 a830 的 Mesa
#   （`/opt/mesa-a830`，Mesa 26.x）后删掉该开关，再按 T19 那套 GL 组合做一次目视回归。
# 判据：`touch` 后 `grim` 截图有顶栏/锁屏（不是黑底转圈），`journalctl -t phoc` 无
#   `fd_pipe_new2` / `egl: failed to create dri2 screen`。
if [ -e /etc/elden-soft-render ]; then
	export WLR_RENDERER=pixman
	export WLR_RENDERER_ALLOW_SOFTWARE=1
	export LIBGL_ALWAYS_SOFTWARE=1
	export GSK_RENDERER=cairo
fi

# elogind should provide XDG_RUNTIME_DIR; fallback if not
[ -n "$XDG_RUNTIME_DIR" ] || export XDG_RUNTIME_DIR=/run/user/$(id -u)
mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true
chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true

exec /usr/bin/phosh-session
