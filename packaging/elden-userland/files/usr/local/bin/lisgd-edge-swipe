#!/bin/sh
# lisgd-edge-swipe — 边缘侧滑返回（D13 路线①）：监听触摸屏 evdev，左边缘内滑 = KEY_BACK。
#
# 为什么不用 phoc 内部手势：上游 phoc issue #125（2020 开到现在）没有实现，也没有在审 MR；
# 零改动的做法 = lisgd 判边缘滑动 → 跑 `uinput-back`（只广告 KEY_BACK 的 uinput 设备）→
# xkb 把 158 映射成 XF86Back → 命中 phoc 既有 `org.gnome.desktop.wm.keybindings close`。
# ⚠️ 前提：`wm.keybindings close` 必须含 `XF86Back`（默认只有 `<Alt>F4`），由
#    `scripts/deploy-desktop-shell.sh` 负责并入。判据出处 `TASKS/README.md` §4 D13。
#
# 不硬编码任何设备节点/分辨率：节点按输入设备名从 /proc/bus/input/devices 找，
# 分辨率从 DRM 的 modes 读；两者都可用环境变量覆盖（调试用）。
set -eu

TOUCH_NAME=${ELDEN_TOUCH_NAME:-NVTCapacitiveTouchScreen}
NODE=${ELDEN_TOUCH_NODE:-}

if [ -z "$NODE" ]; then
	NODE=$(awk -v n="$TOUCH_NAME" '
		index($0, "N: Name=\"" n "\"") > 0 { hit = 1; next }
		hit && /^H: Handlers=/ {
			for (i = 1; i <= NF; i++) if ($i ~ /^event/) { print "/dev/input/" $i; exit }
		}' /proc/bus/input/devices)
fi

if [ -z "$NODE" ] || [ ! -e "$NODE" ]; then
	echo "lisgd-edge-swipe: 找不到触摸屏节点（name=$TOUCH_NAME，NODE=${NODE:-空}）" >&2
	echo "  复核：grep -A6 'N: Name=\"$TOUCH_NAME\"' /proc/bus/input/devices" >&2
	exit 1
fi

GEOM=${ELDEN_SCREEN_GEOM:-}
if [ -z "$GEOM" ]; then
	for m in /sys/class/drm/card*-*/modes; do
		[ -r "$m" ] || continue
		g=$(head -1 "$m" 2>/dev/null | cut -d' ' -f1)
		case "$g" in
			*[0-9]x[0-9]*) GEOM=$g; break ;;
		esac
	done
fi
case "$GEOM" in
	*[0-9]x[0-9]*) ;;
	*) echo "lisgd-edge-swipe: 读不到面板分辨率（ELDEN_SCREEN_GEOM=WxH 可覆盖）" >&2; exit 1 ;;
esac
W=${GEOM%%x*}
H=${GEOM##*x}

BACK_CMD=${ELDEN_BACK_CMD:-/usr/local/bin/elden-swipe-back}
# lisgd 用 fork+exec（**不经 shell**）执行回调 ⇒ 不能用 `ENV=.. cmd` 前缀形式（实测会静默不执行）。
# 故按左右各给一个薄包装：左用 event2、右用 event3（两只马达）。
BACK_L=${ELDEN_BACK_CMD_L:-/usr/local/bin/elden-swipe-back-left}
BACK_R=${ELDEN_BACK_CMD_R:-/usr/local/bin/elden-swipe-back-right}
if [ ! -x "$BACK_CMD" ]; then
	echo "lisgd-edge-swipe: $BACK_CMD 不存在/不可执行；先跑 tools/uinput-back-build.sh 并部署" >&2
	exit 1
fi

if ! command -v lisgd >/dev/null 2>&1; then
	echo "lisgd-edge-swipe: 未安装 lisgd（Debian trixie: apt-get install -y lisgd）" >&2
	exit 1
fi

echo "lisgd-edge-swipe: node=$NODE geom=${W}x${H} threshold=${ELDEN_SWIPE_THRESHOLD:-60} timeout=${ELDEN_SWIPE_TIMEOUT_MS:-800}ms leniency=${ELDEN_SWIPE_LENIENCY:-45} cmd=$BACK_CMD"

# 手势表（2026-11-28 按用户真机反馈放宽：拇指弧形轨迹不被当“必须水平”）：
#   lisgd 按**最近 45° 档**分类（-r <度> 是每档的宽容度，默认 15°、上限 45°）：
#   0=DU(上) 45=DLUR(右上) 90=LR(右) 135=ULDR(右下) 180=UD(下)
#   225=URDL(左下) 270=RL(左) 315=DRUL(左上)；**每档取第一个命中的**（if/else 链）。
#   -r 15 时 15°–30° 是死区（拇指弧线弦角）⇒ 设 -r 45 后全场无死区，
#   但相邻档位区间会重叠 ⇒ 按分类链实际切分（每档 45°）绑定，避免“一个动作多条命令”：
#     左边缘（向右/上/下）= DU + DLUR + LR + ULDR  ⇒ 覆盖 315°..180°（排除向左 180..315）
#     右边缘（向左/上/下）= UD + URDL + RL + DRUL + DU ⇒ 覆盖 135°..45°（排除向右 45..135）
#   两侧都要时用 ELDEN_SWIPE_EDGES 控制（默认 LR = 左右都开；=L 只左；=R 只右）。
LENIENCY=${ELDEN_SWIPE_LENIENCY:-45}
case "$LENIENCY" in
	''|*[!0-9]*) echo "lisgd-edge-swipe: ELDEN_SWIPE_LENIENCY=$LENIENCY 不是数字" >&2; exit 1 ;;
esac
[ "$LENIENCY" -ge 1 ] && [ "$LENIENCY" -le 45 ] || {
	echo "lisgd-edge-swipe: ELDEN_SWIPE_LENIENCY 必须在 1..45（lisgd 上限 45），现值 $LENIENCY" >&2; exit 1
}
GARGS=""
case "${ELDEN_SWIPE_EDGES:-LR}" in
	*L*)
		for g in DU DLUR LR ULDR; do GARGS="$GARGS -g 1,$g,L,*,R,$BACK_L"; done ;;
esac
case "${ELDEN_SWIPE_EDGES:-LR}" in
	*R*)
		for g in DU UD URDL RL DRUL; do GARGS="$GARGS -g 1,$g,R,*,R,$BACK_R"; done ;;
esac
[ -n "$GARGS" ] || { echo "lisgd-edge-swipe: ELDEN_SWIPE_EDGES=${ELDEN_SWIPE_EDGES} 不含 L/R" >&2; exit 1; }
# shellcheck disable=SC2086  # GARGS 需要按空格拆成多组 -g
exec lisgd \
	-d "$NODE" \
	-w "$W" -h "$H" \
	-r "$LENIENCY" \
	-t "${ELDEN_SWIPE_THRESHOLD:-60}" \
	-m "${ELDEN_SWIPE_TIMEOUT_MS:-800}" \
	$GARGS
