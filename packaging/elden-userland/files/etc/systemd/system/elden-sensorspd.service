[Unit]
Description=hexagonrpcd (patched: flat -R tree + write overlay) for elden SSC sensors
After=local-fs.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
# The FastRPC node only exists when the running kernel's DTB has the ADSP
# fastrpc non-secure-domain node (see PITFALLS #741 / TASKS G1-34).  Never
# enter a restart loop when it is missing: wait a bounded time, then finish
# successfully without attaching (a later boot with a fixed kernel will do it).
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/elden-sensorspd-start
TimeoutStartSec=180
Restart=on-failure
RestartPreventExitStatus=1
RestartSec=10
User=fastrpc
Group=fastrpc

[Install]
WantedBy=multi-user.target
