#!/sbin/openrc-run
# pstore-catch — 把 ramoops 里的「上次死挂」证据固化到盘上。
#
# 为什么需要：ramoops 只活在 RAM 里，暖复位还在、**一断电就没了**。#106 这种罕见死挂
# 抓到一次不能因为后来一次插拔/断电而丢掉，所以开机第一件事就把 /sys/fs/pstore/* 复制到
# /var/log/pstore/ 并带时间戳。
description="Archive pstore/ramoops records to /var/log/pstore at boot"

PSTORE=/sys/fs/pstore
KEEP=/var/log/pstore

depend() {
	after root
	before dmesg syslog
}

start() {
	ebegin "archiving pstore records"
	mkdir -p "$PSTORE" "$KEEP"
	if ! mountpoint -q "$PSTORE"; then
		mount -t pstore pstore "$PSTORE" || { eend 1 "pstore mount failed"; return 1; }
	fi
	n=0
	for f in "$PSTORE"/*; do
		[ -e "$f" ] || continue
		b=$(basename "$f")
		install -m 0644 "$f" "$KEEP/$(date +%Y%m%d-%H%M%S)-$b" && { einfo "archived $b"; n=$((n + 1)); }
	done
	[ "$n" = 0 ] && einfo "pstore empty (no previous crash)"
	# 只留最近 10 份，别把 /var 撑爆
	ls -1t "$KEEP" 2>/dev/null | tail -n +11 | while read -r x; do rm -f "$KEEP/$x"; done
	eend 0
}
