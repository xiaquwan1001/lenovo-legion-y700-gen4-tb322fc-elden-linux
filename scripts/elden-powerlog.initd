#!/sbin/openrc-run
# elden-powerlog — write a durable marker when OpenRC enters the shutdown
# runlevel.  Discriminator for G1-22/Q24 («熄屏 → 掉电»):
#   marker present after the event  -> a *clean, userland-initiated* poweroff
#                                      (logind / gsd / an explicit action)
#   marker absent (hard reset/panic) -> the kernel died (DSI/DPMS blank path)
# The device auto-powers-on from USB VBUS, so "it came back up" proves nothing;
# this marker is the only reliable split.
#
# Install: cp to /etc/init.d/elden-powerlog; chmod 755; rc-update add elden-powerlog shutdown

name="elden-powerlog"
description="Record a clean-shutdown marker for post-mortem"

start() {
	{
		printf 'CLEAN-STOP %s uptime=%s boot_id=%s\n' \
			"$(date '+%F %T')" \
			"$(cut -d. -f1 /proc/uptime)" \
			"$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)"
	} >>/root/powerlog.txt 2>/dev/null
	# also drop the running services so we can see *what* was up
	rc-status default >>/root/powerlog.txt 2>/dev/null
	sync
	eend 0
}
