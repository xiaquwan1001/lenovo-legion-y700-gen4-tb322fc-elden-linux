diff --git a/drivers/gpu/drm/msm/dsi/phy/dsi_phy_7nm.c b/drivers/gpu/drm/msm/dsi/phy/dsi_phy_7nm.c
index 1fc3b4f0c0..10061ec8d9 100644
--- a/drivers/gpu/drm/msm/dsi/phy/dsi_phy_7nm.c
+++ b/drivers/gpu/drm/msm/dsi/phy/dsi_phy_7nm.c
@@ -446,9 +446,21 @@ static void dsi_pll_enable_pll_bias(struct dsi_pll_7nm *pll)
 	u32 data;
 
 	spin_lock_irqsave(&pll->pll_enable_lock, flags);
+	pr_info("Q28-E1b bias_en enter id=%d cnt=%d ctrl0=0x%x muxes=0x%x\n",
+		pll->phy->id, pll->pll_enable_cnt,
+		readl(pll->phy->base + REG_DSI_7nm_PHY_CMN_CTRL_0),
+		readl(pll->phy->pll_base + REG_DSI_7nm_PHY_PLL_SYSTEM_MUXES));
+	/* E1b (elden Q28/M1-73): upstream refcount semantics kept verbatim.
+	 * dsi_7nm_phy_enable() pre-seeds pll_enable_cnt = 1, so this function
+	 * early-exits and its PLL_SYSTEM_MUXES = 0xc0 write is never reached on
+	 * the first (bonded) bring-up; the companion write was added there.
+	 */
 	if (pll->pll_enable_cnt++) {
 		spin_unlock_irqrestore(&pll->pll_enable_lock, flags);
 		WARN_ON(pll->pll_enable_cnt == INT_MAX);
+		pr_info("Q28-E1b bias_en EARLY-RET id=%d cnt=%d muxes=0x%x\n",
+			pll->phy->id, pll->pll_enable_cnt,
+			readl(pll->phy->pll_base + REG_DSI_7nm_PHY_PLL_SYSTEM_MUXES));
 		return;
 	}
 
@@ -457,6 +469,10 @@ static void dsi_pll_enable_pll_bias(struct dsi_pll_7nm *pll)
 	writel(data, pll->phy->base + REG_DSI_7nm_PHY_CMN_CTRL_0);
 
 	writel(0xc0, pll->phy->pll_base + REG_DSI_7nm_PHY_PLL_SYSTEM_MUXES);
+	pr_info("Q28-E1b bias_en done  id=%d cnt=%d ctrl0=0x%x muxes=0x%x\n",
+		pll->phy->id, pll->pll_enable_cnt,
+		readl(pll->phy->base + REG_DSI_7nm_PHY_CMN_CTRL_0),
+		readl(pll->phy->pll_base + REG_DSI_7nm_PHY_PLL_SYSTEM_MUXES));
 	spin_unlock_irqrestore(&pll->pll_enable_lock, flags);
 	ndelay(250);
 }
@@ -1144,6 +1160,15 @@ static int dsi_7nm_phy_enable(struct msm_dsi_phy *phy,
 	data = DSI_7nm_PHY_CMN_CTRL_0_DIGTOP_PWRDN_B |
 	       DSI_7nm_PHY_CMN_CTRL_0_PLL_SHUTDOWNB;
 	writel(data, base + REG_DSI_7nm_PHY_CMN_CTRL_0);
+	/* E1b (elden Q28/M1-73): program the PLL output muxes here as well. The
+	 * pre-seed above makes dsi_pll_enable_pll_bias() early-return, so without
+	 * this write PLL_SYSTEM_MUXES stays 0x0 on bonded panels. Kept in the
+	 * bias function too, for the warm re-enable path (cnt == 0).
+	 */
+	writel(0xc0, pll->phy->pll_base + REG_DSI_7nm_PHY_PLL_SYSTEM_MUXES);
+	pr_info("Q28-E1b phy_enable id=%d preseed cnt=1 muxes=0x%x ctrl0=0x%x\n",
+		phy->id, readl(pll->phy->pll_base + REG_DSI_7nm_PHY_PLL_SYSTEM_MUXES),
+		readl(base + REG_DSI_7nm_PHY_CMN_CTRL_0));
 	spin_unlock_irqrestore(&pll->pll_enable_lock, flags);
 
 	/* Assert PLL core reset */
@@ -1251,6 +1276,10 @@ static int dsi_7nm_phy_enable(struct msm_dsi_phy *phy,
 	/* DSI lane settings */
 	dsi_phy_hw_v4_0_lane_settings(phy);
 
+	pr_info("Q28-E1b phy_enable EXIT id=%d muxes=0x%x ctrl0=0x%x cnt=%d\n",
+		phy->id, readl(pll->phy->pll_base + REG_DSI_7nm_PHY_PLL_SYSTEM_MUXES),
+		readl(base + REG_DSI_7nm_PHY_CMN_CTRL_0), pll->pll_enable_cnt);
+
 	DBG("DSI%d PHY enabled", phy->id);
 
 	return 0;
