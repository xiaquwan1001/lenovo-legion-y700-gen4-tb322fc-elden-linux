# 内核配置片段：相机三件套 + 相机 PMIC（elden / SM8750）
#
# 背景：vk32 设备 .config 里 CONFIG_VIDEO_S5KJNS / VIDEO_GC08A8 /
# VIDEO_GT9764 / REGULATOR_WL2868C 全未开（且错开了 VIDEO_S5KJN1），
# 导致后摄 S5KJNS / 前摄 GC08A8 完全无法探测。camss 平台驱动本身已是 =m。
#
# 用法：见 scripts/apply-kernel-fragment.sh
#   FRAG=.../fragment-camera-sensors.config bash scripts/apply-kernel-fragment.sh

CONFIG_MEDIA_SUPPORT=m
CONFIG_VIDEO_DEV=m
CONFIG_V4L2_FWNODE=m
CONFIG_V4L2_CCI=m
CONFIG_V4L2_CCI_I2C=m

# 核心：相机 sensor / 镜头 / 供电
CONFIG_VIDEO_QCOM_CAMSS=m
CONFIG_VIDEO_S5KJNS=m
CONFIG_VIDEO_GC08A8=m
CONFIG_VIDEO_GT9764=m
CONFIG_REGULATOR_WL2868C=m

# 相机 flash 作为 v4l2 subdev 注册（sensor 的 flash-leds 异步依赖需要它，
# 否则 sensor 的 async notifier 永远 waiting → camss complete 不触发 → media graph 无 link）
CONFIG_LEDS_CLASS_FLASH=m
CONFIG_LEDS_QCOM_FLASH=m
CONFIG_V4L2_FLASH_LED_CLASS=m
