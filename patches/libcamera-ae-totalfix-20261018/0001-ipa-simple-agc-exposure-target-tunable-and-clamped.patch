+int Agc::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	exposureTarget_ = tuningData["exposureTarget"].get<double>(kDefaultExposureTarget);
+
+	/*
+	 * The MSV is quantized into kExposureBinsCount bins and is by
+	 * construction in the [1, kExposureBinsCount] range, so a target
+	 * below 1 / kExposureBinsCount is unreachable: the first measured
+	 * frame already satisfies the hysteresis band and the loop never
+	 * raises the exposure, leaving the image black. Clamp it.
+	 */
+	const double minTarget =
+		(1.0 + kExposureSatisfactory * 2) / kExposureBinsCount;
+	if (exposureTarget_ < minTarget) {
+		LOG(IPASoftExposure, Warning)
+			<< "exposureTarget " << exposureTarget_
+			<< " is below the reachable minimum " << minTarget
+			<< ", clamping";
+		exposureTarget_ = minTarget;
+	}
+	exposureTarget_ = std::clamp(exposureTarget_, minTarget, 1.0);
+	LOG(IPASoftExposure, Debug)
+		<< "Exposure target " << exposureTarget_;
+
+	return 0;
+}
