# fragment-modular-v2.config — 模块化第二层（2026-10-26，基准 build/vk151 @ 24223e4）
#
# 与第一层（fragment-modular.config，载荷驱动）互补：本片段只放「root/面板/存储/console
# 起来之后才需要」的基础设施与外设驱动。判据不是「能编过」，而是「启动早期不需要」。
# 逐行理由见 reports/modular-driver-audit-20261026.md §1/§2。
#
# 不放这里（锚点，必须保持 =y）：ARCH_QCOM、DRM_MSM(+DSI/PANEL_NT36536)、
# CLK_GLYMUR_GCC、QCOM_CLK_RPMH、QCOM_RPMH(+RPMHPD)、QCOM_COMMAND_DB、
# PINCTRL_SM8750/GLYMUR、INTERCONNECT_QCOM_SM8750、SPMI_MSM_PMIC_ARB、
# MFD_SPMI_PMIC、REGULATOR_QCOM_SPMI/RPMH、SERIAL_QCOM_GENI(+CONSOLE)、
# QCOM_GENI_SE、SCSI/UFS/PHY_QCOM_QMP_UFS（root=@sda18 UFS）、QCOM_SCM/TZMEM/
# SMEM/SMP2P/AOSS_QMP/IPCC/CPUCP_MBOX/LLCC/PDC/MPM、REMOTEPROC/QCOM_SYSMON、
# QCOM_TSENS（CPU 降温依赖）、NVMEM_QCOM_QFPROM（TSENS 校准依赖）、I2C_QCOM_GENI、
# SPI_QCOM_GENI/SPI_QUP（触屏 SPI 控制器，收益低不动）。

# --- TF 卡（MMC/SDHCI）：root 在 UFS(sda18)，TF 非启动依赖 ---
CONFIG_MMC=m
CONFIG_MMC_BLOCK=m
CONFIG_MMC_CQHCI=m
CONFIG_MMC_SDHCI=m
CONFIG_MMC_SDHCI_PLTFM=m
CONFIG_MMC_SDHCI_MSM=m

# --- rpmsg / QRTR / remoteproc 加载链（随音频/WiFi 载荷在 root 上加载）---
CONFIG_QRTR=m
CONFIG_QRTR_SMD=m
CONFIG_QRTR_MHI=m
CONFIG_QRTR_TUN=m
CONFIG_RPMSG=m
CONFIG_RPMSG_CHAR=m
CONFIG_RPMSG_NS=m
CONFIG_RPMSG_QCOM_GLINK=m
CONFIG_RPMSG_QCOM_GLINK_RPM=m
CONFIG_RPMSG_QCOM_GLINK_SMEM=m
CONFIG_RPMSG_QCOM_SMD=m
CONFIG_RPMSG_VIRTIO=m
CONFIG_QCOM_APR=m
CONFIG_QCOM_PDR_HELPERS=m
CONFIG_QCOM_PDR_MSG=m
CONFIG_QCOM_QMI_HELPERS=m
CONFIG_QCOM_Q6V5_COMMON=m
CONFIG_QCOM_Q6V5_PAS=m
# 注意：QCOM_PAS / QCOM_MDT_LOADER 被 DRM_MSM=y `select`（gpu/drm/msm/Kconfig:17,25），
# 属「被 bool/select 锁死」类，不放片段（保持 =y 内置 helper，无副作用）。
CONFIG_QCOM_PIL_INFO=m

# --- USB / Type-C / PD（启动不需要；adb gadget 在 root 起来后才用）---
CONFIG_USB_DWC3=m
CONFIG_USB_DWC3_OF_SIMPLE=m
CONFIG_USB_DWC3_QCOM=m
CONFIG_PHY_QCOM_QMP_USB=m
CONFIG_PHY_QCOM_QMP_COMBO=m
CONFIG_PHY_QCOM_EUSB2_REPEATER=m
CONFIG_PHY_QCOM_M31_EUSB=m
CONFIG_TYPEC_UCSI=m
CONFIG_TYPEC_DP_ALTMODE=m
CONFIG_QCOM_PMIC_GLINK=m
CONFIG_BATTERY_QCOM_BATTMGR=m

# --- 温度 ADC 叶子（TSENS 保持 =y，CPU 降温不受影响）---
CONFIG_QCOM_VADC_COMMON=m
CONFIG_QCOM_SPMI_ADC5=m
CONFIG_QCOM_SPMI_ADC5_GEN3=m
CONFIG_QCOM_SPMI_ADC_TM5=m
CONFIG_QCOM_SPMI_TEMP_ALARM=m

# --- RTC / 音频 LPI pinctrl ---
CONFIG_RTC_DRV_PM8XXX=m
CONFIG_PINCTRL_LPASS_LPI=m
CONFIG_PINCTRL_SM8650_LPASS_LPI=m
