@@ -306,28 +306,81 @@ static void msm_mdss_destroy(struct msm_mdss *msm_mdss)
 	irq_set_chained_handler_and_data(irq, NULL, NULL);
 }
 
+/*
+ * The display block is one of the few peripherals that the bootloader may
+ * leave fully running: PLLs locked, MDP configured and any framebuffer it
+ * was handed actively scanning out. Bringing the driver up on top of that
+ * live state is what makes command-mode panel initialisation fail on some
+ * boards (the first DCS command runs into a bus that is still busy).
+ *
+ * Some SoCs gate the block through more than one reset line - MDSS_CORE
+ * alone does not cover the interrupt/register block (CORE_INT2) or the RSCC
+ * wrapper. Reset all declared lines so the block starts from a known-zero
+ * state, and hold long enough for the logic to settle.
+ */
 static int msm_mdss_reset(struct device *dev)
 {
-	struct reset_control *reset;
+	struct reset_control_bulk_data *resets;
+	unsigned int num_resets;
+	int ret;
+
+	num_resets = of_property_count_strings(dev->of_node, "reset-names");
+	if (num_resets < 0) {
+		/* Legacy single unnamed reset */
+		struct reset_control *reset;
+
+		reset = reset_control_get_optional_exclusive(dev, NULL);
+		if (!reset)
+			return 0;
+		if (IS_ERR(reset))
+			return dev_err_probe(dev, PTR_ERR(reset),
+					     "failed to acquire mdss reset\n");
+
+		reset_control_assert(reset);
+		/*
+		 * Tests indicate that reset has to be held for some period of
+		 * time, make it one frame in a typical system
+		 */
+		msleep(20);
+		reset_control_deassert(reset);
+
+		reset_control_put(reset);
+
+		return 0;
+	}
 
-	reset = reset_control_get_optional_exclusive(dev, NULL);
-	if (!reset) {
-		/* Optional reset not specified */
+	if (!num_resets) {
+		/* reset-names present but empty: nothing to do */
 		return 0;
-	} else if (IS_ERR(reset)) {
-		return dev_err_probe(dev, PTR_ERR(reset),
-				     "failed to acquire mdss reset\n");
 	}
 
-	reset_control_assert(reset);
+	resets = devm_kcalloc(dev, num_resets, sizeof(*resets), GFP_KERNEL);
+	if (!resets)
+		return -ENOMEM;
+
+	ret = devm_reset_control_bulk_get_optional_exclusive(dev, num_resets,
+							    resets);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to acquire mdss resets\n");
+
+	/* If not a single line was described, treat it as "no reset". */
+	if (!resets[0].rstc)
+		return 0;
+
+	ret = reset_control_bulk_assert(num_resets, resets);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to assert mdss resets\n");
+
 	/*
-	 * Tests indicate that reset has to be held for some period of time,
-	 * make it one frame in a typical system
+	 * Hold long enough for the whole block to settle. This runs before the
+	 * MDSS clocks and PLLs are configured, so nothing is scanning out yet
+	 * and the reset cannot disturb a live pipeline.
 	 */
 	msleep(20);
-	reset_control_deassert(reset);
 
-	reset_control_put(reset);
+	ret = reset_control_bulk_deassert(num_resets, resets);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to deassert mdss resets\n");
 
 	return 0;
 }
