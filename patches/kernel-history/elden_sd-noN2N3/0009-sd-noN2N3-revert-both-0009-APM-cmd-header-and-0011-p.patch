From 7368e9a92c7205a09f5a291bdfd8b772e7580105 Mon Sep 17 00:00:00 2001
From: xuqianhui1001 <xuqianhui1001@localhost>
Date: Tue, 6 Oct 2026 20:33:16 +0800
Subject: [PATCH 9/9] sd-noN2N3: revert both 0009 (APM cmd header) and 0011
 (prepare-time graph start)

---
 sound/soc/qcom/qdsp6/q6apm-lpass-dais.c | 36 +------------------------
 sound/soc/qcom/qdsp6/q6apm.c            | 13 ++++-----
 2 files changed, 8 insertions(+), 41 deletions(-)

diff --git a/sound/soc/qcom/qdsp6/q6apm-lpass-dais.c b/sound/soc/qcom/qdsp6/q6apm-lpass-dais.c
index f54d721ca..e68e8b000 100644
--- a/sound/soc/qcom/qdsp6/q6apm-lpass-dais.c
+++ b/sound/soc/qcom/qdsp6/q6apm-lpass-dais.c
@@ -348,40 +348,6 @@ static int q6i2s_set_sysclk(struct snd_soc_dai *dai, int clk_id, unsigned int fr
 	return ret;
 }
 
-static int q6i2s_prepare(struct snd_pcm_substream *substream, struct snd_soc_dai *dai)
-{
-	struct q6apm_lpass_dai_data *dai_data = dev_get_drvdata(dai->dev);
-	int rc;
-
-	rc = q6apm_lpass_dai_prepare(substream, dai);
-	if (rc)
-		return rc;
-
-	/*
-	 * Start the graph at prepare time, like the vendor q6apm stack and
-	 * the legacy q6afe stack do.  The MI2S interface clocks only drive
-	 * the pads once APM_CMD_GRAPH_START has completed, so the codec DAPM
-	 * power-up (which runs later, at trigger time) needs a live bit
-	 * clock; and the ADSP expects the sink (BE) graph to be started
-	 * before the source (FE) graph, which also starts in its own prepare.
-	 * The trigger callback keeps its start as a fallback, guarded by
-	 * is_port_started.
-	 */
-	rc = q6apm_graph_start(dai_data->graph[dai->id]);
-	if (rc < 0) {
-		dev_err(dai->dev, "Failed to start APM port %d\n", dai->id);
-		if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK) {
-			q6apm_graph_close(dai_data->graph[dai->id]);
-			dai_data->graph[dai->id] = NULL;
-		}
-		return rc;
-	}
-
-	dai_data->is_port_started[dai->id] = true;
-
-	return 0;
-}
-
 static int q6i2s_set_fmt(struct snd_soc_dai *dai, unsigned int fmt)
 {
 	struct q6apm_lpass_dai_data *dai_data = dev_get_drvdata(dai->dev);
@@ -402,7 +368,7 @@ static const struct snd_soc_dai_ops q6dma_ops = {
 };
 
 static const struct snd_soc_dai_ops q6i2s_ops = {
-	.prepare	= q6i2s_prepare,
+	.prepare	= q6apm_lpass_dai_prepare,
 	.startup	= q6i2s_dai_startup,
 	.shutdown	= q6i2s_lpass_dai_shutdown,
 	.set_channel_map  = q6dma_set_channel_map,
diff --git a/sound/soc/qcom/qdsp6/q6apm.c b/sound/soc/qcom/qdsp6/q6apm.c
index 511d6b228..f5cbc552b 100644
--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -151,8 +151,9 @@ static void q6apm_put_audioreach_graph(struct kref *ref)
 static int q6apm_get_apm_state(struct q6apm *apm)
 {
 	int ret;
-	struct gpr_pkt *pkt __free(kfree) = audioreach_alloc_apm_cmd_pkt(0,
-						APM_CMD_GET_SPF_STATE, 0);
+	/* GET_SPF_STATE has no APM command header or payload. */
+	struct gpr_pkt *pkt __free(kfree) = audioreach_alloc_apm_pkt(0,
+				APM_CMD_GET_SPF_STATE, 0, audioreach_get_apm_src_port());
 	if (IS_ERR(pkt))
 		return PTR_ERR(pkt);
 
@@ -227,8 +228,8 @@ static int __q6apm_map_memory_fixed_region(struct device *dev, unsigned int grap
 	uint32_t buf_sz;
 	void *p;
 	uint32_t pos_mask = is_pos_buf ? APM_MMAP_TOKEN_MAP_TYPE_POS_BUF : 0;
-	struct gpr_pkt *pkt __free(kfree) = audioreach_alloc_apm_cmd_pkt(payload_size,
-					APM_CMD_SHARED_MEM_MAP_REGIONS, graph_id | pos_mask);
+	struct gpr_pkt *pkt __free(kfree) = audioreach_alloc_apm_pkt(payload_size,
+			APM_CMD_SHARED_MEM_MAP_REGIONS, graph_id | pos_mask, audioreach_get_apm_src_port());
 
 	if (IS_ERR(pkt))
 		return PTR_ERR(pkt);
@@ -339,8 +340,8 @@ static int __q6apm_unmap_memory_fixed_region(struct device *dev, unsigned int gr
 	struct audioreach_graph_info *info;
 	uint32_t mem_map_handle;
 	u32 pos_mask = is_pos_buf ? APM_MMAP_TOKEN_MAP_TYPE_POS_BUF : 0;
-	struct gpr_pkt *pkt __free(kfree) = audioreach_alloc_apm_cmd_pkt(sizeof(*cmd),
-					APM_CMD_SHARED_MEM_UNMAP_REGIONS, graph_id | pos_mask);
+	struct gpr_pkt *pkt __free(kfree) = audioreach_alloc_apm_pkt(sizeof(*cmd),
+			APM_CMD_SHARED_MEM_UNMAP_REGIONS, graph_id | pos_mask, audioreach_get_apm_src_port());
 	if (IS_ERR(pkt))
 		return PTR_ERR(pkt);
 
