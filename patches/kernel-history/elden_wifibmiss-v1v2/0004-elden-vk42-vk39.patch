 	/* Stock CPU/GPU thermal HAL junction limit: 105 C, 5 C hysteresis. */
 	thermal-zones {
+		/*
+		 * Graded passive cooling (recalibrated 2026-10-02).
+		 * State == cpufreq/devfreq cdev level (higher = lower freq).
+		 *   perf cluster (cpu0, max 3.53 GHz):
+		 *     70 C -> ~2400 MHz (68%)  82 C -> ~1786 MHz (51%)
+		 *     90 C -> ~1363 MHz (39%) 105 C -> min 384 MHz
+		 *   prime cluster (cpu6, max 4.09 GHz):
+		 *     70 C -> ~2842 MHz (69%)  82 C -> ~1958 MHz (48%)
+		 *     90 C -> ~1402 MHz (34%) 105 C -> min 1018 MHz
+		 *   GPU (max 1100 MHz):
+		 *     70 C -> 734 MHz  82 C -> 525 MHz  90 C -> 389 MHz  105 C -> 160 MHz
+		 * hot(120)/critical(125) trips inherited from sm8750.dtsi, untouched.
+		 */
 		cpu-0-0-0-thermal {
 			polling-delay-passive = <100>;
 
 			trips {
-				cpu_0_0_0_passive: passive {
+				cpu_0_0_0_passive0: passive0 {
+					temperature = <70000>;
+					hysteresis = <3000>;
+					type = "passive";
+				};
+				cpu_0_0_0_passive1: passive1 {
+					temperature = <82000>;
+					hysteresis = <3000>;
+					type = "passive";
+				};
+				cpu_0_0_0_passive2: passive2 {
+					temperature = <90000>;
+					hysteresis = <3000>;
+					type = "passive";
+				};
+				cpu_0_0_0_passive3: passive3 {
 					temperature = <105000>;
 					hysteresis = <5000>;
 					type = "passive";
@@ -39,17 +67,43 @@ cpu_0_0_0_passive: passive {
 
 			cooling-maps {
 				map0 {
-					trip = <&cpu_0_0_0_passive>;
-					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
