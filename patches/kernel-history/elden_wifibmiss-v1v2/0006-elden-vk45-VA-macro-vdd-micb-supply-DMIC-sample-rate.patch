From a923477be3a9a63fbfd2e54b747f7c2d690cca2f Mon Sep 17 00:00:00 2001
From: xuqianhui1001 <xuqianhui1001@localhost>
Date: Sun, 4 Oct 2026 00:50:27 +0800
Subject: [PATCH 06/10] =?UTF-8?q?elden:=20vk45=20=E2=80=94=20VA=20macro=20?=
 =?UTF-8?q?vdd-micb=20supply=20+=20DMIC=20sample=20rate?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- &lpass_vamacro: vdd-micb-supply=<&vreg_l1b_1p8>（MTP 同源）、
  qcom,dmic-sample-rate=<4800000>。
- sound audio-routing: "VA DMIC0..3","vdd-micb"（让 DAPM 打开偏置
  regulator；实测缺它时 vdd-micb=Off、录音全 0）。
---
 arch/arm64/boot/dts/qcom/sm8750-lenovo-elden.dts | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8750-lenovo-elden.dts b/arch/arm64/boot/dts/qcom/sm8750-lenovo-elden.dts
index 76ba46f29..ad0532a2b 100644
--- a/arch/arm64/boot/dts/qcom/sm8750-lenovo-elden.dts
+++ b/arch/arm64/boot/dts/qcom/sm8750-lenovo-elden.dts
@@ -1128,7 +1128,11 @@ sound {
 		pinctrl-0 = <&secondary_mi2s_default>;
 		widgets = "Speaker", "Left Speaker", "Speaker", "Right Speaker";
 		audio-routing = "Left Speaker", "Left OUT",
-				"Right Speaker", "Right OUT";
+				"Right Speaker", "Right OUT",
+				"VA DMIC0", "vdd-micb",
+				"VA DMIC1", "vdd-micb",
+				"VA DMIC2", "vdd-micb",
+				"VA DMIC3", "vdd-micb";
 
 		mi2s-dai-link {
 			link-name = "Secondary MI2S";
@@ -3035,4 +3039,6 @@ &apps_smmu {
 &lpass_vamacro {
 	pinctrl-names = "default";
 	pinctrl-0 = <&dmic01_default>, <&dmic23_default>;
+	vdd-micb-supply = <&vreg_l1b_1p8>;
+	qcom,dmic-sample-rate = <4800000>;
 };
