cdsp-split-1 实机：dp0 enabled 时 dmesg 狂刷 vblank wait timed out、
无 card0；回退后 0 警告 + card0/DSI-1 在 + phosh 正常。
usb-role-switch 同步回退到 /delete-property/（DP 实验前基线）。
CDSP split 修复保留。DP 实验改走独立零写盘載具。
---
 arch/arm64/boot/dts/qcom/sm8750-lenovo-elden.dts | 13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8750-lenovo-elden.dts b/arch/arm64/boot/dts/qcom/sm8750-lenovo-elden.dts
index 194bc8685..b099f9e12 100644
--- a/arch/arm64/boot/dts/qcom/sm8750-lenovo-elden.dts
+++ b/arch/arm64/boot/dts/qcom/sm8750-lenovo-elden.dts
@@ -2359,11 +2359,11 @@ &mdss_mdp {
 
 &mdss_dp0 {
 	/*
-	 * 2026-10-06 DP2: 使能 DP0。前提已具备：fsa4480 已绑（两 mux 5-0042/5-0043）、
-	 * pmic_glink_altmode 已绑且生成 aux_hpd_bridge.dp_hpd_bridge.0/1、usb-role-switch 已恢复。
-	 * （UCSI PPM init 仍失败，但那只影响 /sys/class/typec，不影响 DP altmode 通路。）
+	 * 2026-10-07 回退到 disabled：使能 DP0 后 msm_dp（DRM 组件）在 ADSP UCSI
+	 * 未起时永久 defer，**阻塞 msm_drm_bind → 无 card0 → 背光亮但无显示**
+	 * （cdsp-split-1 实机观测）。DP 实验改走独立零写盘載具，不进 boot_b。
 	 */
-	status = "okay";
+	status = "disabled";
 };
 
 &mdss_dp0_out {
@@ -3066,8 +3066,9 @@ &ufs_mem_hc {
 &usb {
 	dr_mode = "peripheral";
 	usb-psy-name = "qcom-battmgr-usb";
-	/* DP1: 恢复 usb-role-switch（原 /delete-property/ 使 UCSI 反复 defer → 无 /sys/class/typec；
-	 * 按 TASKS G1-9 修复顺序 mux→role-switch/UCSI→dp0，本步只做这一步）。 */
+	/* 2026-10-07 回退：/delete-property/ usb-role-switch（DP 实验前基线）。
+	 * 恢复 role-switch 会让 UCSI 反复 defer，且 DP0 已 disabled。 */
+	/delete-property/ usb-role-switch;
 	port-select-gpios = <&tlmm 29 GPIO_ACTIVE_HIGH>;
 	pinctrl-0 = <&eusb_mux>;
 	pinctrl-names = "default";
