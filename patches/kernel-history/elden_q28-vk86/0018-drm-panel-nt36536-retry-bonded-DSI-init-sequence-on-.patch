From d02658e63cf607e71231b077ddd73f42408463c0 Mon Sep 17 00:00:00 2001
From: xuqianhui1001 <xuqianhui1001@localhost>
Date: Thu, 8 Oct 2026 16:46:36 +0800
Subject: [PATCH 18/20] drm/panel: nt36536: retry bonded-DSI init sequence on
 -110 (Q28)

---
 drivers/gpu/drm/panel/panel-novatek-nt36536.c | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/panel/panel-novatek-nt36536.c b/drivers/gpu/drm/panel/panel-novatek-nt36536.c
index 8d4fbc2b5..745605df1 100644
--- a/drivers/gpu/drm/panel/panel-novatek-nt36536.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36536.c
@@ -91,6 +91,7 @@ static int novatek_prepare(struct drm_panel *panel)
 	struct drm_dsc_picture_parameter_set pps;
 	struct device *dev = &dsi->dev;
 	int ret;
+	int tries;
 
 	ret = regulator_bulk_enable(ARRAY_SIZE(novatek_supplies),
 				    ctx->supplies);
@@ -99,7 +100,19 @@ static int novatek_prepare(struct drm_panel *panel)
 
 	novatek_reset(ctx);
 
-	ret = ctx->desc->init_sequence(&dsi_ctx);
+	/* elden: the bonded-DSI first DCS write intermittently times out
+	 * (-110, ~60% of boots on sm8750).  Redo the reset and retry the
+	 * init sequence before giving up.
+	 */
+	for (tries = 0; ; tries++) {
+		dsi_ctx.accum_err = 0;
+		ret = ctx->desc->init_sequence(&dsi_ctx);
+		if (ret == 0 || tries >= 2)
+			break;
+		dev_warn(dev, "panel init attempt %d failed: %d, resetting and retrying\n",
+			 tries + 1, ret);
+		novatek_reset(ctx);
+	}
 	if (ret < 0) {
 		dev_err(dev, "Failed to initialize panel: %d\n", ret);
 		goto power_off;
