+/*
+ * Vendor AW8693X continuous (auto dynamic sine) playback path, reverse
+ * engineered from Lenovo's stock haptic.ko (aw8693x_cont_config).
+ * The chip generates the drive waveform internally at f0, so no SRAM
+ * waveform needs to be streamed. Parameters match the elden device tree
+ * (haptic_hv_l/r: cont_drv1_lvl=0x7f, cont_drv1_time=0x04).
+ */
+static int aw8693x_cont_play(struct aw86927_data *haptics)
+{
+	int err;
+
+	/* PLAYCFG3[1:0] = 2 -> continuous mode; bit2 = 1 (vendor quirk). */
+	err = regmap_update_bits(haptics->regmap, AW86927_PLAYCFG3_REG,
+				 GENMASK(1, 0), 2);
+	if (err)
+		return err;
+	err = regmap_update_bits(haptics->regmap, AW86927_PLAYCFG3_REG,
+				 BIT(2), BIT(2));
+	if (err)
+		return err;
+
+	/* PLAYCFG1 bit5 = 0 (vendor BST config). */
+	err = regmap_update_bits(haptics->regmap, AW86927_PLAYCFG1_REG,
+				 BIT(5), 0);
+	if (err)
+		return err;
+
+	/* VBATCTRL bit6 = 1. */
+	err = regmap_update_bits(haptics->regmap, AW86927_VBATCTRL_REG,
+				 BIT(6), BIT(6));
+	if (err)
+		return err;
+
+	/* CONTCFG6: bit7 flag = 0, [6:0] = drive level (DT cont_drv1_lvl). */
+	err = regmap_update_bits(haptics->regmap, AW8693X_CONTCFG6_REG, BIT(7), 0);
+	if (err)
+		return err;
+	err = regmap_update_bits(haptics->regmap, AW8693X_CONTCFG6_REG,
+				 GENMASK(6, 0), 0x7f);
+	if (err)
+		return err;
+
+	/* CONTCFG7 = cont_drv1_time, CONTCFG9 = 0xff (vendor values). */
+	err = regmap_write(haptics->regmap, AW8693X_CONTCFG7_REG, 0x04);
+	if (err)
+		return err;
+	err = regmap_write(haptics->regmap, AW8693X_CONTCFG9_REG, 0xff);
+	if (err)
+		return err;
+
+	/* GO */
+	return regmap_write(haptics->regmap, AW86927_PLAYCFG4_REG,
+			    AW86927_PLAYCFG4_GO);
