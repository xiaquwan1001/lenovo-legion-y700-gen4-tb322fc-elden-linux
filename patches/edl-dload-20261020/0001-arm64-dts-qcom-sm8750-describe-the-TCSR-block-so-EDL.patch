+		/*
+		 * Qualcomm Top Control and Status Register block.  Boot firmware reads
+		 * the download-mode (EDL) cookie from offset 0x19000 of this block, see
+		 * the qcom,dload-mode property on the SCM node below.  Note this is a
+		 * *different* block from tcsrcc@f204008 above (that one is 0x3004 long
+		 * and only carries clocks); base and size match the SM8750 reference
+		 * platform.
+		 */
+		tcsr: syscon@1fc0000 {
+			compatible = "qcom,sm8750-tcsr-mfd", "syscon";
+			reg = <0x0 0x01fc0000 0x0 0x30000>;
+		};
