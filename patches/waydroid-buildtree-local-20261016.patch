+namespace {
+
+struct SensorDesc {
+    int32_t handle;
+    SensorType type;
+    const char *name;
+    const char *stringType;
+    float maxRange;
+    float resolution;
+    float power;
+    int32_t minDelay;  // us, continuous
+    uint32_t flags;
+};
+
+/* flags: 0 = continuous, 2 = on-change, 3 = on-change + wake-up (prox) */
+static const SensorDesc kSensors[] = {
+    {1, SensorType::ACCELEROMETER,  "elden accel (UDP)", "android.sensor.accelerometer",
+     78.4f,  0.001f, 0.1f, 1000,  0},
+    {2, SensorType::MAGNETIC_FIELD, "elden mag (UDP)",   "android.sensor.magnetic_field",
+     4900.0f, 0.1f,  1.0f, 10000, 0},
+    {4, SensorType::GYROSCOPE,      "elden gyro (UDP)",  "android.sensor.gyroscope",
+     35.0f,  0.001f, 1.0f, 1000,  0},
+    {5, SensorType::LIGHT,          "elden light (UDP)", "android.sensor.light",
+     100000.0f, 1.0f, 0.0f, 0,    2},
+    {8, SensorType::PROXIMITY,      "elden prox (UDP)",  "android.sensor.proximity",
+     10.0f,  1.0f,   0.5f, 0,    3},
+};
+static const int kSensorCount = sizeof(kSensors) / sizeof(kSensors[0]);
+
+static int sensorIndexByType(const char *t) {
+    if (!strcmp(t, "acc"))   return 0;
+    if (!strcmp(t, "mag"))   return 1;
+    if (!strcmp(t, "gyr"))   return 2;
+    if (!strcmp(t, "light")) return 3;
+    if (!strcmp(t, "prox"))  return 4;
+    return -1;
+}
+
+/* ---- 共享事件队列 ---- */
+static std::mutex gMutex;
+static std::condition_variable gCv;
+static std::deque<Event> gQueue;
+static bool gEnabled[kSensorCount] = {false, false, false, false, false};
+static bool gThreadRunning = false;
+
+static void pushEventLocked(const Event &e) {
+    if (gQueue.size() > 512) gQueue.pop_front();  // 背压：丢最旧
+    gQueue.push_back(e);
+}
+
+/* ---- UDP 监听线程 ---- */
+static void *udpLoop(void *) {
+    char portProp[PROPERTY_VALUE_MAX] = {0};
+    property_get("waydroid.sensors.udp_port", portProp, "52012");
+    int port = atoi(portProp);
+    if (port <= 0 || port > 65535) port = 52012;
+
+    int fd = socket(AF_INET, SOCK_DGRAM, 0);
+    if (fd < 0) {
+        ALOGE("sensors udp: socket failed");
+        return nullptr;
+    }
+    int one = 1;
+    setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+    struct sockaddr_in addr;
+    memset(&addr, 0, sizeof(addr));
+    addr.sin_family = AF_INET;
+    addr.sin_port = htons((uint16_t)port);
+    addr.sin_addr.s_addr = htonl(INADDR_ANY);
+    if (bind(fd, (struct sockaddr *)&addr, sizeof(addr)) < 0) {
+        ALOGE("sensors udp: bind :%d failed", port);
+        close(fd);
+        return nullptr;
+    }
+    ALOGI("sensors udp: listening on 0.0.0.0:%d (acc/gyr/mag/light/prox)", port);
+
+    char buf[256];
+    while (gThreadRunning) {
+        struct sockaddr_in src;
+        socklen_t slen = sizeof(src);
+        ssize_t n = recvfrom(fd, buf, sizeof(buf) - 1, 0,
+                             (struct sockaddr *)&src, &slen);
+        if (n <= 0) {
+            if (gThreadRunning) usleep(10000);
+            break;
+        }
+        buf[n] = '\0';
+        char t[16];
+        float a = 0, b = 0, c = 0;
+        if (sscanf(buf, " %15s %f %f %f", t, &a, &b, &c) < 2) continue;
+        int idx = sensorIndexByType(t);
+        if (idx < 0 || !gEnabled[idx]) continue;
+
+        Event e;
+        e.sensorType = kSensors[idx].type;
+        e.sensorHandle = kSensors[idx].handle;
+        e.timestamp = ::android::elapsedRealtimeNano();
+        if (idx <= 2) {
+            Vec3 v;
+            v.x = a; v.y = b; v.z = c;
+            v.status = ::android::hardware::sensors::V1_0::SensorStatus::ACCURACY_HIGH;
+            e.u.vec3 = v;
+        } else {
+            e.u.scalar = a;
+        }
+        {
+            std::lock_guard<std::mutex> lk(gMutex);
+            pushEventLocked(e);
+        }
+        gCv.notify_one();
+    }
+    close(fd);
+    return nullptr;
+}
+
+}  // anonymous namespace
+
 Sensors::Sensors() {
+    for (int i = 0; i < kSensorCount; i++) gEnabled[i] = false;
+    if (!gThreadRunning) {
+        gThreadRunning = true;
+        std::thread(udpLoop, nullptr).detach();
+    }
+}
+
+Sensors::~Sensors() {
+    gThreadRunning = false;
 }
 
