# vk188 fbcon 可见性（2026-11-12）：让 EFI 路径的内核有 fbcon 后端
# 背景：PITFALLS #620 / reports/uefi-efistub-stage-summary-20261111.md §8 ——
#   「GRUB 菜单能显」≠「内核能显」：arm64 EFI stub 把 GOP 填进 sysfb_display_info，
#   但没 SYSFB_SIMPLEFB 就不注册 simple-framebuffer ⇒ simpledrm 无设备 ⇒ fbcon 无后端。
# 依赖（本树已满足）：EFI=y、DRM=y、DRM_SIMPLEDRM=y、DRM_FBDEV_EMULATION=y、DRM_CLIENT_DEFAULT=fbdev。
# 注：该选项上游标 deprecated；将来若被删，等价物 = CONFIG_DRM_EFIDRM（二者互斥）。
CONFIG_SYSFB_SIMPLEFB=y
# UTS 必须与旧模块树（-vk184）明显区分：config 变了，复用同名 /lib/modules 会静默错位
# （PITFALLS #55 / #62）。本内核 msm/DRM/fbcon 全 =y ⇒ 无模块也能出屏。
CONFIG_LOCALVERSION="-debug-vk188-sysfbfb"
