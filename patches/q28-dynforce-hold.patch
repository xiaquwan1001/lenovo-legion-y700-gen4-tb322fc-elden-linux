+/*
+ * elden (TB322FC/SM8750): the bonded command engine can time out on the very
+ * first DCS write while the panel is being initialized.  The failure pointer
+ * stays set afterwards, so every later transfer fails with -EIO before the
+ * hardware is even touched - that is what used to make the failure permanent
+ * for the rest of the boot.  Reset both controllers together with their PHYs
+ * (controller reset + PLL re-lock) and drop the pointer so the caller can
+ * retry the command on a clean link.
+ *
+ * Only valid while the video engines are still off, which is exactly the panel
+ * prepare/pre-enable window: at that point the DPU interface has not been
+ * enabled yet.  A failure on a live link leaves the pointer set, so runtime
+ * transfers keep behaving as before.
+ */
+static bool dsi_mgr_recover_link(void)
+{
+	int mid = msm_dsim_glb.master_dsi_link_id;
+	struct msm_dsi *master, *slave;
+	int sid;
+
+	if (!dsi_mgr_uses_bonded_cmd() || mid < 0 || mid >= DSI_MAX)
+		return false;
+
+	sid = (mid + 1) % DSI_MAX;
+	master = dsi_mgr_get_dsi(mid);
+	slave = dsi_mgr_get_dsi(sid);
+	if (!master || !slave || !master->host || !slave->host)
+		return false;
+
+	if (msm_dsi_host_is_enabled(master->host) ||
+	    msm_dsi_host_is_enabled(slave->host))
+		return false;
+
+	dev_warn(&master->pdev->dev,
+		 "command DMA failed before video enable, resetting DSI link\n");
+
+	WRITE_ONCE(dsi_bonded_cmd_failed, false);
+	/*
+	 * Mirror dsi_mgr_bridge_post_disable(): power_off() ends with
+	 * dsi_mgr_phy_disable(), which already turns both PHYs off when both
+	 * 'phy_enabled' flags are down.  Calling it a second time for the peer
+	 * would disable the PHY regulators twice (unbalanced disables) and drop
+	 * the PHY runtime PM refcount, so don't.
+	 */
+	msm_dsi_host_dump_link_state(master->host, "before-reset");
+	dsi_mgr_link_power_off(mid);
+
+	if (dsi_mgr_link_power_on(mid)) {
+		dev_err(&master->pdev->dev, "failed to bring the DSI link back\n");
+		WRITE_ONCE(dsi_bonded_cmd_failed, true);
+		return false;
+	}
+
+	msm_dsi_host_dump_link_state(master->host, "after-reset");
+
+	return true;
+}
