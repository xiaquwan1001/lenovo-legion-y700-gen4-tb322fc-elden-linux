index 86c81428d..c1c780436 100644
--- a/drivers/media/i2c/gc08a8.c
+++ b/drivers/media/i2c/gc08a8.c
@@ -536,6 +536,7 @@ static int gc08a8_set_ctrl(struct v4l2_ctrl *ctrl)
 	struct gc08a8 *sensor = container_of(ctrl->handler, struct gc08a8, ctrls);
 	struct device *dev = sensor->sd.dev;
 	u16 reg;
+	u32 val;
 	int ret = 0, release;
 
 	switch (ctrl->id) {
@@ -555,8 +556,11 @@ static int gc08a8_set_ctrl(struct v4l2_ctrl *ctrl)
 	ret = 0;
 
 	cci_write(sensor->regmap, CCI_REG8(0x0104), 1, &ret);
-	cci_write(sensor->regmap, CCI_REG8(reg), ctrl->val >> 8, &ret);
-	cci_write(sensor->regmap, CCI_REG8(reg + 1), ctrl->val & 0xff, &ret);
+	/* V4L2 exposes the real analogue gain (1/1024 steps); the register takes
+	 * the raw sensor gain code (code = gain * 1024). */
+	val = ctrl->id == V4L2_CID_ANALOGUE_GAIN ? ctrl->val * 1024 : ctrl->val;
+	cci_write(sensor->regmap, CCI_REG8(reg), val >> 8, &ret);
+	cci_write(sensor->regmap, CCI_REG8(reg + 1), val & 0xff, &ret);
 	/* Release group hold even when a control write failed. */
 	release = cci_write(sensor->regmap, CCI_REG8(0x0104), 0, NULL);
 	pm_runtime_put(dev);
