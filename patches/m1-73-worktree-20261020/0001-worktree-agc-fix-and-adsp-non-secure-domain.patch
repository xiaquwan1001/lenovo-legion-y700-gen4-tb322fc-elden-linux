 	v4l2_ctrl_new_std(hdl, &gc08a8_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
-			  1024, 16384, 1, 1024);
+			  1, 16, 1, 1);
 	v4l2_ctrl_new_fwnode_properties(hdl, &gc08a8_ctrl_ops, &props);
