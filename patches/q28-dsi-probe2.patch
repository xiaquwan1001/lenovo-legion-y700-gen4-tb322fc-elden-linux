+		msm_dsi_host_dump_link_state(master, "before-first-cmd");
+		msm_dsi_host_dump_link_clocks(master, "before-first-cmd");
+	}
+
 	if (msm_dsi_manager_cmd_failed())
 		return -EIO;
 
@@ -643,10 +724,21 @@ static int dsi_mgr_bonded_cmd_xfer(const struct mipi_dsi_msg *msg)
