         return false;
     };
 
-    if (req->frameIn->mFourcc != V4L2_PIX_FMT_MJPEG && req->frameIn->mFourcc != V4L2_PIX_FMT_Z16) {
+    // ELDEN: raw YUV (v4l2loopback / libcamera bridge) is accepted too.
+    if (req->frameIn->mFourcc != V4L2_PIX_FMT_MJPEG && req->frameIn->mFourcc != V4L2_PIX_FMT_Z16 &&
+            req->frameIn->mFourcc != V4L2_PIX_FMT_YUYV &&
+            req->frameIn->mFourcc != V4L2_PIX_FMT_NV12 &&
+            req->frameIn->mFourcc != V4L2_PIX_FMT_YUV420) {
         return onDeviceError("%s: do not support V4L2 format %c%c%c%c", __FUNCTION__,
                 req->frameIn->mFourcc & 0xFF,
                 (req->frameIn->mFourcc >> 8) & 0xFF,
@@ -1519,6 +1523,47 @@ bool ExternalCameraDeviceSession::OutputThread::threadLoop() {
             signalRequestDone();
             return true;
         }
+    } else {
+        // ELDEN: raw YUV input -> intermediate YU12 (libyuv, same target as the JPEG path).
+        ATRACE_BEGIN("YUVtoI420");
+        int res = 0;
+        if (req->frameIn->mFourcc == V4L2_PIX_FMT_YUYV) {
+            res = libyuv::YUY2ToI420(
+                    inData, mYu12Frame->mWidth * 2,
+                    static_cast<uint8_t*>(mYu12FrameLayout.y), mYu12FrameLayout.yStride,
+                    static_cast<uint8_t*>(mYu12FrameLayout.cb), mYu12FrameLayout.cStride,
+                    static_cast<uint8_t*>(mYu12FrameLayout.cr), mYu12FrameLayout.cStride,
+                    mYu12Frame->mWidth, mYu12Frame->mHeight);
+        } else if (req->frameIn->mFourcc == V4L2_PIX_FMT_NV12) {
+            res = libyuv::NV12ToI420(
+                    inData, mYu12Frame->mWidth,
+                    inData + mYu12Frame->mWidth * mYu12Frame->mHeight, mYu12Frame->mWidth,
+                    static_cast<uint8_t*>(mYu12FrameLayout.y), mYu12FrameLayout.yStride,
+                    static_cast<uint8_t*>(mYu12FrameLayout.cb), mYu12FrameLayout.cStride,
+                    static_cast<uint8_t*>(mYu12FrameLayout.cr), mYu12FrameLayout.cStride,
+                    mYu12Frame->mWidth, mYu12Frame->mHeight);
+        } else {  // V4L2_PIX_FMT_YUV420
+            res = libyuv::I420Copy(
+                    inData, mYu12Frame->mWidth,
+                    inData + mYu12Frame->mWidth * mYu12Frame->mHeight, mYu12Frame->mWidth / 2,
+                    inData + mYu12Frame->mWidth * mYu12Frame->mHeight * 5 / 4,
+                    mYu12Frame->mWidth / 2,
+                    static_cast<uint8_t*>(mYu12FrameLayout.y), mYu12FrameLayout.yStride,
+                    static_cast<uint8_t*>(mYu12FrameLayout.cb), mYu12FrameLayout.cStride,
+                    static_cast<uint8_t*>(mYu12FrameLayout.cr), mYu12FrameLayout.cStride,
+                    mYu12Frame->mWidth, mYu12Frame->mHeight);
+        }
+        ATRACE_END();
+        if (res != 0) {
+            ALOGE("%s: Convert raw YUV frame to YU12 failed! res %d", __FUNCTION__, res);
+            lk.unlock();
+            Status st = parent->processCaptureRequestError(req);
+            if (st != Status::OK) {
+                return onDeviceError("%s: failed to process capture request error!", __FUNCTION__);
+            }
+            signalRequestDone();
+            return true;
+        }
