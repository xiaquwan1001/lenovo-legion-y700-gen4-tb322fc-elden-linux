+static int qcom_battmgr_set_usb_current_limit(struct qcom_battmgr *battmgr, int ua)
+{
+	int ret;
+
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_GET,
+					    USB_ADAP_TYPE, 0);
+	if (ret)
