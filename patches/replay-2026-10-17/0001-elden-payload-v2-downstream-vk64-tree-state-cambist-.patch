+		*sep = '\0';
+		(*map)[i].from = entry;
+		(*map)[i].to = sep + 1;
+
+		for (j = 0; j < i; j++) {
+			if (!strcmp((*map)[j].from, (*map)[i].from))
+				return dev_err_probe(ctx->dev, -EINVAL,
+						     "%s contains duplicate key %s\n",
+						     property, (*map)[i].from);
+		}
