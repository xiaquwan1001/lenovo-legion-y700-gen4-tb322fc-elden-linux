+	ret = qcom_battmgr_set_usb_current_limit(battmgr, val->intval);
+	if (!ret) {
+		battmgr->usb.requested_current_limit = val->intval;
+		battmgr->usb.current_limit_set = true;
+	}
+out:
+	mutex_unlock(&battmgr->lock);
+	return ret;
+}
