+	u8 pin_name[PWRSEQ_QCOM_WCN_PMU_PIN_NAME_LEN];
+	u32 wake_volt_valid;
+	u32 wake_volt;
+	u32 sleep_volt_valid;
+	u32 sleep_volt;
+};
