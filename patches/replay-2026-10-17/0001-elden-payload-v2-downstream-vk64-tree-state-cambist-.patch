diff --git a/Documentation/devicetree/bindings/input/touchscreen/novatek,nt36536-ts.yaml b/Documentation/devicetree/bindings/input/touchscreen/novatek,nt36536-ts.yaml
new file mode 100644
index 000000000..9e1a90cfb
--- /dev/null
+++ b/Documentation/devicetree/bindings/input/touchscreen/novatek,nt36536-ts.yaml
@@ -0,0 +1,69 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/touchscreen/novatek,nt36536-ts.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Novatek NT36536 SPI touchscreen controller
+
+maintainers:
+  - phone-devel maintainers <phone-devel@vger.kernel.org>
+
+description:
+  The NT36536 is a no-flash capacitive touchscreen controller. Its firmware
+  must be downloaded to SRAM by the host after reset and after power loss.
+
+allOf:
+  - $ref: touchscreen.yaml#
+  - $ref: /schemas/spi/spi-peripheral-props.yaml#
+
+properties:
+  compatible:
+    const: novatek,nt36536-ts
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  firmware-name:
+    maxItems: 1
+    description: Firmware file containing the Novatek host-download image.
+
+  spi-max-frequency:
+    maximum: 10000000
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - firmware-name
+  - spi-max-frequency
+  - touchscreen-size-x
+  - touchscreen-size-y
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    spi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        touchscreen@0 {
+            compatible = "novatek,nt36536-ts";
+            reg = <0>;
+
+            interrupt-parent = <&tlmm>;
+            interrupts = <162 IRQ_TYPE_EDGE_FALLING>;
+
+            spi-max-frequency = <10000000>;
+            firmware-name = "novatek_ts_fw.bin";
+            touchscreen-size-x = <19041>;
+            touchscreen-size-y = <30401>;
+        };
+    };
+...
