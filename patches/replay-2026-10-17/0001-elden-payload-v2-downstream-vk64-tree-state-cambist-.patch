+	case DWC3_GCTL_PRTCAP_DEVICE:
+		reg = dwc3_readl(dwc, DWC3_DSTS);
+		if (reg == U32_MAX)
+			return -EIO;
+		return reg & DWC3_DSTS_DEVCTRLHLT ? 0 : -EBUSY;
+	default:
+		return 0;
+	}
