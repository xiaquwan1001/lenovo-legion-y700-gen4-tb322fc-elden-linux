+/* Removal callbacks cannot report halt errors. Do not reroute a running core. */
+static int dwc3_check_halted(struct dwc3 *dwc)
+{
+	struct resource *res = &dwc->xhci_resources[0];
+	void __iomem *base;
+	u32 reg, offset, command;
