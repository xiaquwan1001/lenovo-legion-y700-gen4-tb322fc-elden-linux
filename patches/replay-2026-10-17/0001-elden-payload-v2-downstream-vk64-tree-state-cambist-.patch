+/* ST21NFC on QUPV3_SE0 (i2c0, gpio32/33). Vendor compatible is "st,st21nfc";
+ * the mainline driver only matches "st,st21nfca-i2c" and needs enable-gpios.
+ *
+ * 2026-10-06: 本机无 NFC 硬件（G1-10 取消）。`&i2c0 status="okay"` 会导致**硬关机**
+ * （PITFALLS #108）；此前文档记“已从驱动批次移除”，但树里仍为 okay ⇒ 任何由本树
+ * 构建的 DTB 都会启动失败（dp1 实测回退 boot_b）。此处改回 disabled。
+ */
+&i2c0 {
+	status = "disabled";
+
+	nfc@8 {
+		compatible = "st,st21nfca-i2c";
+		reg = <0x08>;
+
+		interrupt-parent = <&tlmm>;
+		interrupts = <75 IRQ_TYPE_EDGE_FALLING>;
+
+		enable-gpios = <&tlmm 34 GPIO_ACTIVE_HIGH>;
+
+		pinctrl-0 = <&nfc_int_active>, <&nfc_enable_active>;
+		pinctrl-1 = <&nfc_int_suspend>, <&nfc_enable_suspend>;
+		pinctrl-names = "default", "sleep";
+	};
+};
+
+&i2c5 {
+	status = "okay";
+
+	typec-mux@42 {
+		compatible = "fcs,fsa4480";
+		reg = <0x42>;
+
+		vcc-supply = <&vreg_bob1>;
+
+		mode-switch;
+		orientation-switch;
+
+		port {
+			fsa4480_hs_sbu_mux: endpoint {
+				remote-endpoint = <&pmic_glink_hs_sbu>;
+			};
+		};
+	};
+
+	typec-mux@43 {
+		compatible = "fcs,fsa4480";
+		reg = <0x43>;
+
+		vcc-supply = <&vreg_bob1>;
+
+		mode-switch;
+		orientation-switch;
+
+		port {
+			fsa4480_sbu_mux: endpoint {
+				remote-endpoint = <&pmic_glink_sbu>;
+			};
+		};
+	};
+
+	eusb_repeater: redriver@4f {
+		compatible = "nxp,ptn3222"; /* PTN3222DUK */
+		reg = <0x4f>;
