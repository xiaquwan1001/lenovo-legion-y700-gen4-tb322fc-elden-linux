+		port@2 {
+			reg = <2>;
+
+			usb_dwc3_hs2: endpoint {
+				remote-endpoint = <&pmic_glink_hs_c2_in>;
+				usb-role-switch;
+				mux-state = <1>;
+			};
+		};
+	};
