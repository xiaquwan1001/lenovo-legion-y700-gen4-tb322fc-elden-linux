+++ b/Documentation/devicetree/bindings/leds/qcom,spmi-flash-led.yaml
@@ -36,6 +36,35 @@ properties:
   reg:
     maxItems: 1
 
+  power-supplies:
+    description:
+      Provider of the battery supplying the flash controller. If the provider
+      exposes multiple power supplies, exactly one must be of battery type.
+      The battery must supply open-circuit voltage, current and internal resistance.
+    maxItems: 1
+
+  qcom,battery-current-limit-microamp:
+    description: Maximum battery discharge current allowed during a flash.
+    minimum: 1
+    maximum: 4500000
+
+  qcom,battery-voltage-min-microvolt:
+    description: Minimum loaded battery voltage, including the required droop margin.
+    minimum: 1
+
+allOf:
+  - if:
+      required:
+        - power-supplies
+    then:
+      required:
+        - qcom,battery-current-limit-microamp
+        - qcom,battery-voltage-min-microvolt
+
+dependentRequired:
+  qcom,battery-current-limit-microamp: [power-supplies]
+  qcom,battery-voltage-min-microvolt: [power-supplies]
+
 patternProperties:
   "^led-[0-3]$":
     type: object
diff --git a/Documentation/devicetree/bindings/media/i2c/galaxycore,gc08a8.yaml b/Documentation/devicetree/bindings/media/i2c/galaxycore,gc08a8.yaml
new file mode 100644
index 000000000..3ddcc1600
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/galaxycore,gc08a8.yaml
@@ -0,0 +1,117 @@
+# SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause)
+# Copyright (c) 2023 MediaTek Inc.
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/galaxycore,gc08a8.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: GalaxyCore gc08a8 1/4" 8M Pixel MIPI CSI-2 sensor
+
+maintainers:
+  - Elden Mainline Agent <elden-mainline@localhost>
+
+description:
+  The gc08a8 is a raw image sensor with an MIPI CSI-2 image data
+  interface and CCI (I2C compatible) control bus. The output format
+  is raw Bayer.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: galaxycore,gc08a8
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+    description: 19.2 MHz input clock.
+
+  dovdd-supply: true
+
+  avdd-supply: true
+
+  dvdd-supply: true
+
+  power-domains:
+    maxItems: 1
+
+  reset-gpios:
+    description: Reference to the GPIO connected to the RESETB pin.
+    maxItems: 1
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+    description:
+      Output port node, single endpoint describing the CSI-2 transmitter.
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+              - const: 3
+              - const: 4
+
+          link-frequencies:
+            items:
+              - const: 336000000
+
+        required:
+          - data-lanes
+          - link-frequencies
+
+    required:
+      - endpoint
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - dovdd-supply
+  - avdd-supply
+  - dvdd-supply
+  - reset-gpios
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        sensor@31 {
