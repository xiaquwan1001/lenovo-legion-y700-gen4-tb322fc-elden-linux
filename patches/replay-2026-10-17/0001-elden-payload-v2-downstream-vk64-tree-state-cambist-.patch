+/*
+ * SM8750 (Lenovo "elden" TB322FC) reboot-mode -> PSCI SYSTEM_RESET2 vendor resets.
+ *
+ * Upstream drives this through the psci-reboot-mode driver plus a 13-patch
+ * reboot-mode/MFD series that is not merged as of v7.2.  This is a minimal
+ * device-side hook so that `reboot bootloader` / `reboot edl` reach firmware.
+ * reset_type/cookie values match the upstream sm8750 DT
+ * ([PATCH v22] arm64: dts: qcom: sm8750: add reboot-mode support).
+ *
+ * If the SMC returns (firmware rejected or ignored the vendor reset) we fall
+ * through to the normal reboot path, so an unsupported type cannot wedge boot.
+ */
+#define PSCI_ELDEN_RESET_TYPE_EDL		0x80000000
+#define PSCI_ELDEN_RESET_TYPE_BOOTLOADER	0x80010001
+
+static void psci_elden_try_vendor_reset(const char *cmd)
+{
+	u32 reset_type, cookie;
+
+	if (!cmd)
+		return;
+
+	if (!strcmp(cmd, "edl")) {
+		reset_type = PSCI_ELDEN_RESET_TYPE_EDL;
+		cookie = 0x1;
+	} else if (!strcmp(cmd, "bootloader")) {
+		reset_type = PSCI_ELDEN_RESET_TYPE_BOOTLOADER;
+		cookie = 0x2;
+	} else {
+		return;
+	}
+
+	pr_info("psci: SYSTEM_RESET2 vendor reset_type=0x%08x cookie=0x%x (cmd=%s)\n",
+		reset_type, cookie, cmd);
+	invoke_psci_fn(PSCI_FN_NATIVE(1_1, SYSTEM_RESET2), reset_type,
+		       cookie, 0);
+	/* Only reached if firmware did not reset the SoC. */
+}
