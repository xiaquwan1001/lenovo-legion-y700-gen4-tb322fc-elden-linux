+		sep = strchr(entry, ':');
+		if (!sep || sep == entry || !sep[1] || strchr(sep + 1, ':'))
+			return dev_err_probe(ctx->dev, -EINVAL,
+					     "%s entry %s must be exactly from:to\n",
+					     property, value);
