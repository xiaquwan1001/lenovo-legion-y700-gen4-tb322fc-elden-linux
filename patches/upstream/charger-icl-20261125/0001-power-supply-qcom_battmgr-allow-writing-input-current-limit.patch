From: Qianhui Xu <xiaqinghuan@mail.ustc.edu.cn>
Subject: [PATCH v2] power: supply: qcom_battmgr: allow writing USB input current limit

The Battery Management (battmgr) service on SM8350 and later platforms
advertises a USB input current limit property (BATTMGR property
USB_INPUT_CURR_LIMIT, id 5), and the driver already reads and caches it
through BATTMGR_USB_PROPERTY_GET.  The corresponding write opcode,
BATTMGR_USB_PROPERTY_SET (0x33), is defined in the driver but has never
been wired up, so userspace can only read the limit the firmware reports.

On these platforms the firmware boots with the USB input current limit
clamped to a very conservative default (reported as 100 mA on several
devices) until the USB stack negotiates a higher budget.  Userspace (e.g.
upower or a thermal/USB-PD policy daemon) needs a way to raise the limit
to match what the attached adapter actually supplies.

Add a set_property callback for the sm8350 USB power supply that sends
BATTMGR_USB_PROPERTY_SET with property USB_INPUT_CURR_LIMIT, using the
existing qcom_battmgr_request_property() helper.  The requested value is
clamped to [500 mA, max(current_max, 900 mA)] before it is sent, with the
conservative 900 mA fallback when the firmware has not reported
CURRENT_MAX yet, because the ADSP rejects out-of-range requests.  Errors
from the firmware are propagated to the caller instead of being silently
dropped, and the acknowledgement of BATTMGR_USB_PROPERTY_SET is handled
so it no longer shows up as "unknown message".

Tested on a Lenovo Legion Y700 Gen4 (SM8750): the request is acknowledged
by the ADSP and the value reads back through the property.

Signed-off-by: Qianhui Xu <xiaqinghuan@mail.ustc.edu.cn>
---
diff --git a/drivers/power/supply/qcom_battmgr.c b/drivers/power/supply/qcom_battmgr.c
index 58e238e6fb..f5fefd31f8 100644
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -1044,6 +1044,55 @@ static int qcom_battmgr_usb_get_property(struct power_supply *psy,
 	return 0;
 }
 
+#define USB_INPUT_CURR_LIMIT_MIN	500000	/* uA */
+#define USB_INPUT_CURR_LIMIT_FALLBACK	900000	/* uA */
+
+static int qcom_battmgr_usb_is_writeable(struct power_supply *psy,
+					 enum power_supply_property psp)
+{
+	switch (psp) {
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		return 1;
+	default:
+		return 0;
+	}
+}
+
+static int qcom_battmgr_usb_set_property(struct power_supply *psy,
+					 enum power_supply_property psp,
+					 const union power_supply_propval *pval)
+{
+	struct qcom_battmgr *battmgr = power_supply_get_drvdata(psy);
+	unsigned int limit;
+	int ret;
+
+	if (!battmgr->service_up)
+		return -EAGAIN;
+
+	if (battmgr->variant == QCOM_BATTMGR_SC8280XP ||
+	    battmgr->variant == QCOM_BATTMGR_X1E80100)
+		return -EINVAL;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		limit = max(battmgr->usb.current_max,
+			    USB_INPUT_CURR_LIMIT_FALLBACK);
+		limit = clamp((unsigned int)pval->intval,
+			      USB_INPUT_CURR_LIMIT_MIN, limit);
+
+		mutex_lock(&battmgr->lock);
+		ret = qcom_battmgr_request_property(battmgr,
+						    BATTMGR_USB_PROPERTY_SET,
+						    USB_INPUT_CURR_LIMIT, limit);
+		mutex_unlock(&battmgr->lock);
+		if (!ret)
+			battmgr->usb.current_limit = limit;
+		return ret;
+	default:
+		return -EINVAL;
+	}
+}
+
 static const enum power_supply_property sc8280xp_usb_props[] = {
 	POWER_SUPPLY_PROP_ONLINE,
 };
@@ -1082,6 +1131,8 @@ static const struct power_supply_desc sm8350_usb_psy_desc = {
 	.properties = sm8350_usb_props,
 	.num_properties = ARRAY_SIZE(sm8350_usb_props),
 	.get_property = qcom_battmgr_usb_get_property,
+	.set_property = qcom_battmgr_usb_set_property,
+	.property_is_writeable = qcom_battmgr_usb_is_writeable,
 	.usb_types = BIT(POWER_SUPPLY_USB_TYPE_UNKNOWN) |
 		     BIT(POWER_SUPPLY_USB_TYPE_SDP)     |
 		     BIT(POWER_SUPPLY_USB_TYPE_DCP)     |
@@ -1381,6 +1432,12 @@ static void qcom_battmgr_sc8280xp_callback(struct qcom_battmgr *battmgr,
 		battmgr->status.charge_time = le32_to_cpu(resp->time);
 		break;
 	case BATTMGR_CHG_CTRL_LIMIT_EN:
+	case BATTMGR_USB_PROPERTY_SET:
+		/* Ack of our own USB_INPUT_CURR_LIMIT write (see
+		 * qcom_battmgr_usb_set_property()); without this case the
+		 * firmware reply is reported as an unknown message and the
+		 * error code carried by the ack is lost.
+		 */
 		battmgr->error = 0;
 		break;
 	default:
@@ -1585,6 +1642,12 @@ static void qcom_battmgr_sm8350_callback(struct qcom_battmgr *battmgr,
 		break;
 	case BATTMGR_REQUEST_NOTIFICATION:
 	case BATTMGR_CHG_CTRL_LIMIT_EN:
+	case BATTMGR_USB_PROPERTY_SET:
+		/* Ack of our own USB_INPUT_CURR_LIMIT write (see
+		 * qcom_battmgr_usb_set_property()); without this case the
+		 * firmware reply is reported as an unknown message and the
+		 * error code carried by the ack is lost.
+		 */
 		battmgr->error = 0;
 		break;
 	default:
