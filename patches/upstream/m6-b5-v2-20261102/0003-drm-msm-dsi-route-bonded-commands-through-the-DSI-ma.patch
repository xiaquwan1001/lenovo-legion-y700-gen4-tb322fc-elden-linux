From f38983e7b4531e07e7e7adedef9aa2ada3ccbf77 Mon Sep 17 00:00:00 2001
From: Qianhui Xu <xiaqinghuan@mail.ustc.edu.cn>
Date: Mon, 2 Nov 2026 17:48:27 +0800
Subject: [PATCH 3/4] drm/msm/dsi: route bonded commands through the DSI
 manager

A panel write on a bonded pair has to reach both links. Until now the
manager only prepared the peer host and let one engine carry the command,
so a single-link DMA engine was armed for a command the panel expects on
both paths.

Route such writes through the bonded command transaction instead: the
manager picks the master from the device tree, asks the master host to run
the transaction against its peer and keeps the rest of the flow untouched.
The master link is the one marked with "qcom,master-dsi" in the device
tree, which dsi_mgr_parse_of() stores in master_dsi_link_id; the link ids
are the DSI host indices and are not assigned by probe order. The DT stays
the authority for the role.

Whether the pair can do this at all is a property of the controller
generation, so the manager asks the host ops rather than checking a
compatible itself. SoCs without the hook keep taking the old path.

The sequence number in the transaction and the failure flag belong to the
bonded state, so both live in msm_dsim_glb next to is_bonded_dsi and
is_sync_needed; the mutex that serialises the transactions stays
file-scoped. A failed transfer leaves one engine unresolved, so the flag
blocks further bonded commands and is cleared when the controllers are
powered off again.

Signed-off-by: Qianhui Xu <xiaqinghuan@mail.ustc.edu.cn>
---
 drivers/gpu/drm/msm/dsi/dsi.h         |   2 +
 drivers/gpu/drm/msm/dsi/dsi_host.c    |   6 ++
 drivers/gpu/drm/msm/dsi/dsi_manager.c | 102 ++++++++++++++++++++++++++
 3 files changed, 110 insertions(+)

diff --git a/drivers/gpu/drm/msm/dsi/dsi.h b/drivers/gpu/drm/msm/dsi/dsi.h
index 89bdbc1fcc..5dcc5a423f 100644
--- a/drivers/gpu/drm/msm/dsi/dsi.h
+++ b/drivers/gpu/drm/msm/dsi/dsi.h
@@ -58,6 +58,8 @@ void msm_dsi_manager_tpg_enable(void);
 
 /* dsi host */
 struct msm_dsi_host;
+struct msm_dsi_host_cfg_ops;
+const struct msm_dsi_host_cfg_ops *msm_dsi_host_get_cfg_ops(struct mipi_dsi_host *host);
 int msm_dsi_host_xfer_prepare(struct mipi_dsi_host *host,
 					const struct mipi_dsi_msg *msg);
 void msm_dsi_host_xfer_restore(struct mipi_dsi_host *host,
diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index 687cbcc04d..9175370d94 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -2228,6 +2228,12 @@ void msm_dsi_host_unregister(struct mipi_dsi_host *host)
 	}
 }
 
+const struct msm_dsi_host_cfg_ops *
+msm_dsi_host_get_cfg_ops(struct mipi_dsi_host *host)
+{
+	return to_msm_dsi_host(host)->cfg_hnd->ops;
+}
+
 static void dsi_bonded_wait_video(struct mipi_dsi_host *host)
 {
 	dsi_wait4video_eng_busy(to_msm_dsi_host(host));
diff --git a/drivers/gpu/drm/msm/dsi/dsi_manager.c b/drivers/gpu/drm/msm/dsi/dsi_manager.c
index 531d4ff78f..4bff105566 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_manager.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_manager.c
@@ -7,6 +7,7 @@
 
 #include "msm_kms.h"
 #include "dsi.h"
+#include "dsi_cfg.h"
 
 #define DSI_CLOCK_MASTER	DSI_0
 #define DSI_CLOCK_SLAVE		DSI_1
@@ -25,11 +26,19 @@ struct msm_dsi_manager {
 
 	bool is_bonded_dsi;
 	bool is_sync_needed;
+	bool bonded_cmd_failed;
 	int master_dsi_link_id;
 };
 
 static struct msm_dsi_manager msm_dsim_glb;
 
+/*
+ * Serialises bonded command transactions, so that the two engines are never
+ * staged by two callers at once. The failure flag it guards lives in
+ * msm_dsim_glb, like the rest of the bonded state.
+ */
+static DEFINE_MUTEX(dsi_bonded_cmd_lock);
+
 #define IS_BONDED_DSI()		(msm_dsim_glb.is_bonded_dsi)
 #define IS_SYNC_NEEDED()	(msm_dsim_glb.is_sync_needed)
 #define IS_MASTER_DSI_LINK(id)	(msm_dsim_glb.master_dsi_link_id == id)
@@ -44,6 +53,43 @@ static inline struct msm_dsi *dsi_mgr_get_other_dsi(int id)
 	return msm_dsim_glb.dsi[(id + 1) % DSI_MAX];
 }
 
+/*
+ * A bonded command path exists only if this pair is bonded and the controller
+ * generation provides the broadcast hooks. Which generation that is stays a
+ * property of the host, not of the manager.
+ */
+static bool dsi_mgr_uses_bonded_cmd(void)
+{
+	struct msm_dsi *dsi;
+	const struct msm_dsi_host_cfg_ops *ops;
+	int id = msm_dsim_glb.master_dsi_link_id;
+
+	if (!IS_BONDED_DSI() || id < 0 || id >= DSI_MAX)
+		return false;
+
+	dsi = dsi_mgr_get_dsi(id);
+	if (!dsi || !dsi->host)
+		return false;
+
+	ops = msm_dsi_host_get_cfg_ops(dsi->host);
+	return ops && ops->bonded_cmd_xfer;
+}
+
+static bool dsi_mgr_bonded_cmd_failed(void)
+{
+	return READ_ONCE(msm_dsim_glb.bonded_cmd_failed);
+}
+
+/*
+ * A failed bonded transfer leaves at least one DMA engine unresolved, so its
+ * packet buffer must not be reused. Stop using the path until the next
+ * display cycle reprograms both links.
+ */
+static void dsi_mgr_mark_bonded_cmd_failed(void)
+{
+	WRITE_ONCE(msm_dsim_glb.bonded_cmd_failed, true);
+}
+
 static int dsi_mgr_parse_of(struct device_node *np, int id)
 {
 	struct msm_dsi_manager *msm_dsim = &msm_dsim_glb;
@@ -273,6 +319,9 @@ static void dsi_mgr_bridge_power_off(struct drm_bridge *bridge)
 	}
 	msm_dsi_host_power_off(host);
 	dsi_mgr_phy_disable(id);
+
+	/* Both engines are reset here, so the next cycle starts clean. */
+	WRITE_ONCE(msm_dsim_glb.bonded_cmd_failed, false);
 }
 
 static void dsi_mgr_bridge_pre_enable(struct drm_bridge *bridge,
@@ -493,6 +542,47 @@ int msm_dsi_manager_connector_init(struct msm_dsi *msm_dsi,
 	return 0;
 }
 
+static bool dsi_mgr_use_bonded_write(const struct mipi_dsi_msg *msg)
+{
+	if (!IS_SYNC_NEEDED() || !dsi_mgr_uses_bonded_cmd())
+		return false;
+
+	/* Only a plain write can be broadcast: no readback, no acknowledge. */
+	return !(msg->rx_buf && msg->rx_len) &&
+	       !(msg->flags & MIPI_DSI_MSG_REQ_ACK);
+}
+
+/*
+ * The master link is the one the device tree marks with "qcom,master-dsi":
+ * dsi_mgr_parse_of() stores it in master_dsi_link_id and the link ids are the
+ * DSI host indices. The per-SoC data only describes the transfer itself.
+ */
+static int dsi_mgr_bonded_cmd_xfer(const struct mipi_dsi_msg *msg)
+{
+	struct msm_dsi *master_dsi, *slave_dsi;
+	const struct msm_dsi_host_cfg_ops *ops;
+	int master_id = msm_dsim_glb.master_dsi_link_id;
+	int ret;
+
+	if (master_id < 0 || master_id >= DSI_MAX)
+		return -EINVAL;
+
+	master_dsi = dsi_mgr_get_dsi(master_id);
+	slave_dsi = dsi_mgr_get_other_dsi(master_id);
+	if (!master_dsi || !slave_dsi || !master_dsi->host || !slave_dsi->host)
+		return -ENODEV;
+
+	ops = msm_dsi_host_get_cfg_ops(master_dsi->host);
+	if (!ops || !ops->bonded_cmd_xfer)
+		return -EOPNOTSUPP;
+
+	ret = ops->bonded_cmd_xfer(master_dsi->host, slave_dsi->host, msg);
+	if (ret < 0)
+		dsi_mgr_mark_bonded_cmd_failed();
+
+	return ret;
+}
+
 int msm_dsi_manager_cmd_xfer(int id, const struct mipi_dsi_msg *msg)
 {
 	struct msm_dsi *msm_dsi = dsi_mgr_get_dsi(id);
@@ -505,6 +595,18 @@ int msm_dsi_manager_cmd_xfer(int id, const struct mipi_dsi_msg *msg)
 	if (!msg->tx_buf || !msg->tx_len)
 		return 0;
 
+	if (dsi_mgr_use_bonded_write(msg)) {
+		int ret;
+
+		if (dsi_mgr_bonded_cmd_failed())
+			return -EIO;
+		mutex_lock(&dsi_bonded_cmd_lock);
+		ret = dsi_mgr_bonded_cmd_xfer(msg);
+		mutex_unlock(&dsi_bonded_cmd_lock);
+
+		return ret;
+	}
+
 	/* In bonded master case, panel requires the same commands sent to
 	 * both DSI links. Host issues the command trigger to both links
 	 * when DSI_1 calls the cmd transfer function, no matter it happens
-- 
2.53.0

