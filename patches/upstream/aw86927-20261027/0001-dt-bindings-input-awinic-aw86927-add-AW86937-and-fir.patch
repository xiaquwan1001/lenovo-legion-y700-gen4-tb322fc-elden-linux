From cab95913068cc3f8b1ed79a00f26721c8efd38a5 Mon Sep 17 00:00:00 2001
From: Qianhui Xu <xiaqinghuan@mail.ustc.edu.cn>
Date: Tue, 27 Oct 2026 19:49:16 +0800
Subject: [PATCH 1/5] dt-bindings: input: awinic,aw86927: add AW86937 and
 firmware properties

The AW86937 is register compatible with the AW86927 but exposes twice the
SRAM window and can only be driven from a waveform image supplied at
runtime, so describe both the compatible string and the firmware
properties the driver needs to locate and select a waveform:

  - "awinic,aw86937" as a standalone compatible, keeping the existing
    "aw86938 + aw86927" fallback pair as is;
  - firmware-name, the RAM image holding the checksum header and the
    waveform table;
  - awinic,ram-waveform-index, the one-based index of the periodic
    rumble waveform to loop inside that image.

Devices with the AW86937 compatible have no in-driver waveform to fall
back to, so firmware-name is mandatory for them.

Lane: aw86927-series
Agent: aw86927-series
Baseline: base/20261027-5d6400f
Task: U4

Signed-off-by: Qianhui Xu <xiaqinghuan@mail.ustc.edu.cn>
---
 .../bindings/input/awinic,aw86927.yaml        | 25 ++++++++++++++++++-
 1 file changed, 24 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/input/awinic,aw86927.yaml b/Documentation/devicetree/bindings/input/awinic,aw86927.yaml
index bd74b8148..092ce0e77 100644
--- a/Documentation/devicetree/bindings/input/awinic,aw86927.yaml
+++ b/Documentation/devicetree/bindings/input/awinic,aw86927.yaml
@@ -12,12 +12,25 @@ maintainers:
 properties:
   compatible:
     oneOf:
-      - const: awinic,aw86927
+      - enum:
+          - awinic,aw86927
+          - awinic,aw86937
       - items:
           - enum:
               - awinic,aw86938
           - const: awinic,aw86927
 
+  firmware-name:
+    description: RAM waveform image containing checksum, base address and waveform table.
+    maxItems: 1
+
+  awinic,ram-waveform-index:
+    description: One-based index of the periodic rumble waveform in the RAM image.
+    $ref: /schemas/types.yaml#/definitions/uint32
+    minimum: 1
+    maximum: 127
+    default: 1
+
   reg:
     maxItems: 1
 
@@ -33,6 +46,16 @@ required:
   - reset-gpios
   - interrupts
 
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: awinic,aw86937
+    then:
+      required:
+        - firmware-name
+
 additionalProperties: false
 
 examples:
-- 
