From eda49f0adf6a04ee91d8e81e802ca327c6461bdf Mon Sep 17 00:00:00 2001
From: Xu Qianhui <xiaqinghuan@mail.ustc.edu.cn>
Date: Tue, 13 Oct 2026 19:03:23 +0800
Subject: [PATCH 2/2] power: sequencing: pwrseq-qcom-wcn: add WCN7861 PMU
 support

WCN7861 (Peach) uses the same external PMU rails as WCN7850, so reuse the
existing "wcn7850" supply list, but it requires a reset interval around
BT_EN: BT_EN must be held low for a short time after the shared regulators
were voted, the AON output must be allowed to discharge while WLAN_EN is
low, and BT_EN must stay low briefly before the regulators are turned off
again.

Describe this as optional per-device timing data and wire it up in the
Bluetooth enable/disable callbacks, then add the "qcom,wcn7861-pmu"
compatible.

Signed-off-by: Xu Qianhui <xiaqinghuan@mail.ustc.edu.cn>
---
 drivers/power/sequencing/pwrseq-qcom-wcn.c | 48 ++++++++++++++++++++++
 1 file changed, 48 insertions(+)

diff --git a/drivers/power/sequencing/pwrseq-qcom-wcn.c b/drivers/power/sequencing/pwrseq-qcom-wcn.c
index d41793e1fc..580b6279e4 100644
--- a/drivers/power/sequencing/pwrseq-qcom-wcn.c
+++ b/drivers/power/sequencing/pwrseq-qcom-wcn.c
@@ -22,6 +22,9 @@ struct pwrseq_qcom_wcn_pdata {
 	size_t num_vregs;
 	unsigned int pwup_delay_ms;
 	unsigned int gpio_enable_delay_ms;
+	unsigned int bt_reset_delay_ms;
+	unsigned int bt_wlan_off_delay_ms;
+	unsigned int bt_power_off_delay_ms;
 	const struct pwrseq_target_data **targets;
 	bool has_vddio; /* separate VDD IO regulator */
 	int (*match)(struct pwrseq_device *pwrseq, struct device *dev);
@@ -29,6 +32,7 @@ struct pwrseq_qcom_wcn_pdata {
 
 struct pwrseq_qcom_wcn_ctx {
 	struct pwrseq_device *pwrseq;
+	struct device *dev;
 	struct device_node *of_node;
 	const struct pwrseq_qcom_wcn_pdata *pdata;
 	struct regulator_bulk_data *regs;
@@ -166,6 +170,32 @@ static const struct pwrseq_unit_data *pwrseq_qcom_wcn6855_unit_deps[] = {
 static int pwrseq_qcom_wcn_bt_enable(struct pwrseq_device *pwrseq)
 {
 	struct pwrseq_qcom_wcn_ctx *ctx = pwrseq_device_get_drvdata(pwrseq);
+	int wlan_state;
+
+	/*
+	 * Some WCN platforms need a fresh reset interval after their shared
+	 * regulators have been voted.  This callback runs after its regulator
+	 * dependencies, so hold BT_EN low here instead of relying on the value
+	 * selected when the GPIO was first acquired at probe time.
+	 */
+	if (ctx->pdata->bt_reset_delay_ms) {
+		gpiod_set_value_cansleep(ctx->bt_gpio, 0);
+		msleep(ctx->pdata->bt_reset_delay_ms);
+	}
+
+	/*
+	 * When WLAN_EN is low, give the shared AON output time to discharge
+	 * before releasing BT_EN.  WLAN may already be owned by another
+	 * consumer, so observe its current level without changing it.
+	 */
+	if (ctx->pdata->bt_wlan_off_delay_ms && ctx->wlan_gpio) {
+		wlan_state = gpiod_get_value_cansleep(ctx->wlan_gpio);
+		if (wlan_state < 0)
+			dev_warn(ctx->dev, "Failed to read WLAN_EN: %d\n",
+				 wlan_state);
+		else if (!wlan_state)
+			msleep(ctx->pdata->bt_wlan_off_delay_ms);
+	}
 
 	pwrseq_qcom_wcn_ensure_gpio_delay(ctx);
 	gpiod_set_value_cansleep(ctx->bt_gpio, 1);
@@ -179,6 +209,8 @@ static int pwrseq_qcom_wcn_bt_disable(struct pwrseq_device *pwrseq)
 	struct pwrseq_qcom_wcn_ctx *ctx = pwrseq_device_get_drvdata(pwrseq);
 
 	gpiod_set_value_cansleep(ctx->bt_gpio, 0);
+	if (ctx->pdata->bt_power_off_delay_ms)
+		msleep(ctx->pdata->bt_power_off_delay_ms);
 
 	return 0;
 }
@@ -401,6 +433,17 @@ static const struct pwrseq_qcom_wcn_pdata pwrseq_wcn7850_of_data = {
 	.targets = pwrseq_qcom_wcn_targets,
 };
 
+/* WCN7861 reuses the WCN7850 rails but needs a reset interval around BT_EN. */
+static const struct pwrseq_qcom_wcn_pdata pwrseq_wcn7861_of_data = {
+	.vregs = pwrseq_wcn7850_vregs,
+	.num_vregs = ARRAY_SIZE(pwrseq_wcn7850_vregs),
+	.pwup_delay_ms = 50,
+	.bt_reset_delay_ms = 50,
+	.bt_wlan_off_delay_ms = 100,
+	.bt_power_off_delay_ms = 100,
+	.targets = pwrseq_qcom_wcn_targets,
+};
+
 static int pwrseq_qcom_wcn_match_regulator(struct pwrseq_device *pwrseq,
 					   struct device *dev,
 					   const char *name)
@@ -465,6 +508,7 @@ static int pwrseq_qcom_wcn_probe(struct platform_device *pdev)
 	if (!ctx)
 		return -ENOMEM;
 
+	ctx->dev = dev;
 	ctx->of_node = dev->of_node;
 
 	ctx->pdata = device_get_match_data(dev);
@@ -576,6 +620,10 @@ static const struct of_device_id pwrseq_qcom_wcn_of_match[] = {
 		.compatible = "qcom,wcn7850-pmu",
 		.data = &pwrseq_wcn7850_of_data,
 	},
+	{
+		.compatible = "qcom,wcn7861-pmu",
+		.data = &pwrseq_wcn7861_of_data,
+	},
 	{
 		.compatible = "qcom,wcn6750-pmu",
 		.data = &pwrseq_wcn6750_of_data,
