                                            <G4 占位: 诊断数=…>
  G5 dtbs_check  make ARCH=arm64 CHECK_DTBS=1 qcom/sm8250-mtp.dtb
                 qcom/sm8650-mtp.dtb qcom/sm8750-mtp.dtb qcom/sm8750-qrd.dtb
                 (no DT_SCHEMA_FILES)
                                            <G5 占位: 每份 DTC [C]；USB/dwc3 相关诊断 0；baseline 对照 …>
  G6 samples     dt-validate -u .../bindings -p processed-schema.json
                                            <G6 占位: 正样例 0 诊断；负样例 4 类被拒（…）>
