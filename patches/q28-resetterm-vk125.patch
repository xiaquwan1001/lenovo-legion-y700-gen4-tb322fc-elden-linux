+bool msm_dsi_host_is_enabled(struct mipi_dsi_host *host)
+{
+	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
+
+	return READ_ONCE(msm_host->enabled);
+}
+
+void msm_dsi_host_dump_link_state(struct mipi_dsi_host *host, const char *tag)
+{
+	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
+
+	dev_warn(&msm_host->pdev->dev,
+		 "Q28 link[%s]: CTRL=%#x STATUS0=%#x CLK_STATUS=%#x INTR_CTRL=%#x CMD_DMA_CTRL=%#x\n",
+		 tag, dsi_read(msm_host, REG_DSI_CTRL),
+		 dsi_read(msm_host, REG_DSI_STATUS0),
+		 dsi_read(msm_host, REG_DSI_CLK_STATUS),
+		 dsi_read(msm_host, REG_DSI_INTR_CTRL),
+		 dsi_read(msm_host, REG_DSI_CMD_DMA_CTRL));
+}
+
+/*
+ * elden (TB322FC/SM8750): mirror the terminal state of the stock
+ * dsi_ctrl_hw_cmn_ctrl_reset() sequence - engines off and *all* dynamic clock
+ * requests de-asserted (CLK_CTRL = 0) instead of restoring the previous
+ * CLK_CTRL value.  On a failed panel bring-up the DSI side can otherwise leave
+ * a clock request asserted, which the reset path used to restore verbatim.
+ *
+ * Caller must guarantee the controller is powered and not video-enabled.
+ */
+void msm_dsi_host_ctrl_reset_terminal(struct mipi_dsi_host *host)
+{
+	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
+	u32 ctrl = dsi_read(msm_host, REG_DSI_CTRL);
+
+	/* engines off first (stock order: video mode, then controller) */
+	dsi_write(msm_host, REG_DSI_CTRL, ctrl & ~DSI_CTRL_VID_MODE_EN);
+	wmb();
+	dsi_write(msm_host, REG_DSI_CTRL,
+		  ctrl & ~(DSI_CTRL_ENABLE | DSI_CTRL_VID_MODE_EN));
+	wmb();
+	/* "remove force on all dynamic clocks": terminal CLK_CTRL == 0 */
+	dsi_write(msm_host, REG_DSI_CLK_CTRL, 0);
+	wmb();
+
+	dev_warn(&msm_host->pdev->dev,
+		 "Q28 resetterm: CTRL=%#x CLK_CTRL=%#x CLK_STATUS=%#x\n",
+		 dsi_read(msm_host, REG_DSI_CTRL),
+		 dsi_read(msm_host, REG_DSI_CLK_CTRL),
+		 dsi_read(msm_host, REG_DSI_CLK_STATUS));
+}
