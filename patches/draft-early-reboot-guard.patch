diff --git a/scripts/lib-boot-ready.sh b/scripts/lib-boot-ready.sh
new file mode 100755
index 0000000..27da2aa
--- /dev/null
+++ b/scripts/lib-boot-ready.sh
@@ -0,0 +1,68 @@
+#!/usr/bin/env bash
+# lib-boot-ready.sh — 「复位/进 fastboot 前的系统就绪门」（host 侧，经 SSH 判定当前运行的系统）
+#
+# 动机（见 reports/audit-early-reboot-20261012.md）：
+#   系统尚未起来（桌面未起、DSI/DRM 仍在 bring-up）时就发 reboot2 bootloader，
+#   偶发把设备打进「无任何 USB 通道」态（fastboot/NCM 全无、ping 不通），只能长按断电恢复
+#   （PITFALLS #143）。2026-10-12 实测：uptime≈20s 发 reboot2 → 全通道丢失；
+#   uptime=138s、桌面已起时执行 → 正常进 fastboot。
+#   旧脚本只把「SSH 可达」当就绪，而 SSH 在 uptime≈6.7s 即可用、比桌面早得多（PITFALLS #67），
+#   门太松，可在上电 <60s 触发。
+#
+# 用法（在被 patch 的脚本里）：
+#   . "$(dirname "$0")/lib-boot-ready.sh"
+#   boot_ready_or_die            # 不就绪即 die；就绪返回 0
+#
+# 就绪判据（全部通过才放行，fail-closed）：
+#   1) SSH 现问现答（fire 前复核一次）
+#   2) uptime >= BOOT_READY_MIN_UPTIME（默认 90 s）
+#   3) 桌面已起：phoc 或 phosh 在跑（现场证据里真正区分好坏的信号）
+#      非图形/RAM 诊断变体确无判据时显式 BOOT_READY_ALLOW_NODESKTOP=1 跳过 3)
+#   4) 可选：BOOT_READY_REJECT_STORM=1 时，dmesg 有 vblank/power-up-failed 风暴即拒绝
+#      （坏发态软复位路径本身不可靠，PITFALLS #150/#170）
+#
+# 逃生阀：ELDEN_FORCE_REBOOT=1 跳过本门（打印醒目告警），供确知安全的场景。
+# 依赖：调用方提供 ssh 包装 $S（形如: S '<cmd>' [timeout] -> 走 timeout+ssh）。
+: "${BOOT_READY_MIN_UPTIME:=90}"
+: "${BOOT_READY_ALLOW_NODESKTOP:=0}"
+: "${BOOT_READY_REJECT_STORM:=0}"
+
+boot_ready_or_die() {
+	local S="${S:-S}" up phoc phosh storm reason=""
+	if [ "${ELDEN_FORCE_REBOOT:-0}" = 1 ]; then
+		echo "[boot-ready] WARN ELDEN_FORCE_REBOOT=1 -- skip readiness gate (self-inflicted hang risk)" >&2
+		return 0
+	fi
+
+	# 1) fire 前复核 SSH 仍活
+	if [ "$($S 'echo up' 10)" != "up" ]; then
+		echo "[boot-ready] FAIL: SSH 未答（设备不在 Linux 或通道未起）-- 拒绝 reboot" >&2
+		echo "[boot-ready]   若目标是物理 POR 冷起样本，请走 scripts/q28-cold-run.sh，别在此强发复位。" >&2
+		exit 3
+	fi
+
+	# 2) uptime（busybox 上 pgrep -x 不可靠，桌面用 ps|grep -cx，见 PITFALLS #68）
+	up="$($S "cut -d. -f1 /proc/uptime" 10 | tr -dc '0-9')"; up="${up:-0}"
+	phoc="$($S "ps -eo comm | grep -cx phoc" 10 | tr -dc '0-9')"; phoc="${phoc:-0}"
+	phosh="$($S "ps -eo comm | grep -cx phosh" 10 | tr -dc '0-9')"; phosh="${phosh:-0}"
+
+	[ "$up" -lt "$BOOT_READY_MIN_UPTIME" ] && reason="$reason uptime=${up}s<${BOOT_READY_MIN_UPTIME}s;"
+	if [ "$BOOT_READY_ALLOW_NODESKTOP" != 1 ] && [ "$((phoc + phosh))" -lt 1 ]; then
+		reason="$reason desktop-not-up(phoc+phosh=0);"
+	fi
+
+	# 3) 可选风暴拒绝（坏发态软复位不可靠，PITFALLS #150/#170）
+	if [ "$BOOT_READY_REJECT_STORM" = 1 ]; then
+		storm="$($S "dmesg 2>/dev/null | grep -cE 'vblank wait timed out|power-up failed|command DMA timeout'" 15 | tr -dc '0-9')"; storm="${storm:-0}"
+		[ "$storm" -gt 0 ] && reason="$reason storm-sig=${storm};"
+	fi
+
+	if [ -n "$reason" ]; then
+		echo "[boot-ready] FAIL: 系统未就绪，拒绝进 fastboot/reboot。原因:${reason}" >&2
+		echo "[boot-ready]   等系统完全起来（桌面可见、uptime>=${BOOT_READY_MIN_UPTIME}s）后重跑；" >&2
+		echo "[boot-ready]   确无桌面的非图形变体：BOOT_READY_ALLOW_NODESKTOP=1；确知安全强发：ELDEN_FORCE_REBOOT=1" >&2
+		exit 4
+	fi
+	echo "[boot-ready] OK: uptime=${up}s phoc=${phoc} phosh=${phosh} -- 放行进 fastboot"
+	return 0
+}
diff --git a/scripts/q28-boot-cycle.sh b/scripts/q28-boot-cycle.sh
index 06d4cb5..710ea7b 100755
--- a/scripts/q28-boot-cycle.sh
+++ b/scripts/q28-boot-cycle.sh
@@ -20,6 +20,9 @@ mkdir -p "$OUT"
 [ -e "$IMG" ] || { echo "missing $IMG"; exit 1; }
 S() { timeout "${2:-25}" ssh -o StrictHostKeyChecking=no -o ConnectTimeout=6 "$TAB" "$1" 2>/dev/null; }
 
+# 复位/进 fastboot 前的系统就绪门（防上电未就绪即 reboot2 → 无 USB 通道挂机；见 lib-boot-ready.sh）
+. "$(dirname "$0")/lib-boot-ready.sh"
+
 echo "IMG=$IMG TAG=$TAG OUT=$OUT"
 echo "before: $(S 'echo uptime=$(cut -d" " -f1 /proc/uptime) uname=$(uname -r)')"
 
@@ -33,6 +36,9 @@ if [ "$_g" = 1 ]; then
 fi
 echo "[q28-cycle] ⚠️  暖复位循环：对 Q28 冷起结论无效（PITFALLS #166），仅诊断取证。"
 
+# 就绪门：SSH 复核 + uptime>=90s + 桌面(phoc/phosh)已起，才放行；否则拒绝（fail-closed）。
+boot_ready_or_die
+
 echo "== 1) reboot2 bootloader（进 fastboot，无需按键）=="
 S '(sleep 2; reboot2 bootloader) >/dev/null 2>&1 &' || true
 
diff --git a/scripts/q28-layout-ab.sh b/scripts/q28-layout-ab.sh
index 07ae56d..2efea49 100755
--- a/scripts/q28-layout-ab.sh
+++ b/scripts/q28-layout-ab.sh
@@ -9,6 +9,8 @@ TAB=root@192.168.7.1
 D=out/q28-layout
 SSH="ssh -o StrictHostKeyChecking=no -o ConnectTimeout=8 $TAB"
 S(){ timeout "${2:-25}" $SSH "$1" 2>/dev/null; }
+# 复位/进 fastboot 前的系统就绪门（防未就绪即 reboot2 → 无 USB 通道挂机）
+. "$(dirname "$0")/lib-boot-ready.sh"
 declare -A IMG=( [oct8]="$D/boot-q28-oct8.img" [a]="$D/boot-q28-a.img" [aa]="$D/boot-q28-aa.img" [vk64c-repro]="$D/boot-q28-vk64c-repro.img" )
 SEQ=${SEQ:-"oct8 a aa vk64c-repro vk64c-repro aa a oct8"}
 echo "[ab] SEQ=$SEQ  $(date -Is)"
@@ -18,7 +20,8 @@ for tag in $SEQ; do
   img=${IMG[$tag]:-}
   [ -n "$img" ] && [ -e "$img" ] || { echo "[ab] unknown/missing image tag=$tag"; continue; }
   echo "==== run $i tag=$tag img=$img $(date -Is)"
-  # 1) 从当前 Linux 暖复位进 bootloader
+  # 1) 从当前 Linux 暖复位进 bootloader（先过就绪门）
+  boot_ready_or_die
   S '(sleep 2; reboot2 bootloader) >/dev/null 2>&1 &' || true
   # 2) 等 fastboot
   ok=0; for _ in $(seq 1 18); do fastboot devices 2>/dev/null | grep -q . && { ok=1; break; }; sleep 5; done
diff --git a/scripts/q28-layout-one.sh b/scripts/q28-layout-one.sh
index 679c8a5..e84e792 100755
--- a/scripts/q28-layout-one.sh
+++ b/scripts/q28-layout-one.sh
@@ -8,6 +8,8 @@ D=out/q28-layout
 TAB=root@192.168.7.1
 SSH="ssh -o StrictHostKeyChecking=no -o ConnectTimeout=8 $TAB"
 S(){ timeout "${2:-25}" $SSH "$1" 2>/dev/null; }
+# 复位/进 fastboot 前的系统就绪门（防未就绪即 reboot2 → 无 USB 通道挂机）
+. "$(dirname "$0")/lib-boot-ready.sh"
 case "$TAG" in
   oct8) IMG=$D/boot-q28-oct8.img; KPAY=8efb2731 ;;
   a)    IMG=$D/boot-q28-a.img;    KPAY=? ;;
@@ -20,6 +22,7 @@ esac
 if ! timeout 8 fastboot devices 2>/dev/null | grep -q .; then
   if [ "$(S 'echo up')" = up ]; then
     echo "[one] 设备在 Linux，reboot2 bootloader…"
+    boot_ready_or_die
     S '(sleep 2; reboot2 bootloader) >/dev/null 2>&1 &' || true
     ok=0; for _ in $(seq 1 18); do timeout 8 fastboot devices 2>/dev/null | grep -q . && { ok=1; break; }; sleep 5; done
     [ $ok = 1 ] || { echo "[one] NO-FASTBOOT（设备可能已挂）"; exit 3; }
