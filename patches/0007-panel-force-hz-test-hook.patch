diff --git a/drivers/gpu/drm/panel/panel-novatek-nt36536.c b/drivers/gpu/drm/panel/panel-novatek-nt36536.c
index eecda2f3b..00130c479 100644
--- a/drivers/gpu/drm/panel/panel-novatek-nt36536.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36536.c
@@ -159,17 +159,30 @@ static int novatek_unprepare(struct drm_panel *panel)
 	return 0;
 }
 
+/*
+ * Test hook for refresh-rate bring-up: when non-zero, only the mode with this
+ * refresh rate is exposed, forcing the compositor onto it.  For a built-in
+ * driver set it on the kernel command line, e.g.
+ * "panel_novatek_nt36536.force_hz=165".  Default 0 exposes every mode.
+ */
+static unsigned int force_hz;
+module_param(force_hz, uint, 0644);
+MODULE_PARM_DESC(force_hz, "Only expose the mode with this refresh rate (0 = all)");
+
 static int novatek_get_modes(struct drm_panel *panel,
 			     struct drm_connector *connector)
 {
 	struct novatek *ctx = to_novatek(panel);
 	const struct panel_desc *desc = ctx->desc;
-	int i;
+	int i, count = 0;
 
 	for (i = 0; i < desc->num_modes; i++) {
 		const struct drm_display_mode *m = &desc->modes[i];
 		struct drm_display_mode *mode;
 
+		if (force_hz && drm_mode_vrefresh(m) != force_hz)
+			continue;
+
 		mode = drm_mode_duplicate(connector->dev, m);
 		if (!mode) {
 			dev_err(panel->dev, "failed to add mode %ux%u@%u\n",
@@ -178,18 +191,19 @@ static int novatek_get_modes(struct drm_panel *panel,
 		}
 
 		mode->type = DRM_MODE_TYPE_DRIVER;
-		if (i == 0)
+		if (count == 0)
 			mode->type |= DRM_MODE_TYPE_PREFERRED;
 
 		drm_mode_set_name(mode);
 		drm_mode_probed_add(connector, mode);
+		count++;
 	}
 
 	connector->display_info.width_mm = desc->width_mm;
 	connector->display_info.height_mm = desc->height_mm;
 	connector->display_info.bpc = desc->bpc;
 
-	return desc->num_modes;
+	return count;
 }
 
