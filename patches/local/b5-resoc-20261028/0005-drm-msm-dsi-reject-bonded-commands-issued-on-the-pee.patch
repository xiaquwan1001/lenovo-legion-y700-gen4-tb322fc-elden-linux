From 3e61c25c2daa46c2d13d062de00494dc02dc4bcd Mon Sep 17 00:00:00 2001
From: Qianhui Xu <xiaqinghuan@mail.ustc.edu.cn>
Date: Wed, 28 Oct 2026 20:06:46 +0800
Subject: [PATCH 5/6] drm/msm/dsi: reject bonded commands issued on the peer
 link

Only the master link owns the broadcast engine and its completion
interrupt, so a command sent through the peer link cannot be broadcast.
That used to be accepted silently: the transaction was assembled for the
master anyway and the controller answered with a bare -EINVAL, several
layers below the caller, with no indication of what was actually wrong.

Check the issuing link against the master link on entry to the bonded
transaction, before any hardware state is touched, and fail with a message
that names both links. The error path has no side effects, so a rejected
call leaves the pair exactly as it found it.

Signed-off-by: Qianhui Xu <xiaqinghuan@mail.ustc.edu.cn>
---
 drivers/gpu/drm/msm/dsi/dsi_manager.c | 20 +++++++++++++++++---
 1 file changed, 17 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/msm/dsi/dsi_manager.c b/drivers/gpu/drm/msm/dsi/dsi_manager.c
index 23f2d68d5..3fa1a7b23 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_manager.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_manager.c
@@ -630,15 +630,29 @@ static bool dsi_mgr_use_bonded_write(const struct mipi_dsi_msg *msg)
 	       !(msg->flags & MIPI_DSI_MSG_REQ_ACK);
 }
 
-static int dsi_mgr_bonded_cmd_xfer(const struct mipi_dsi_msg *msg)
+static int dsi_mgr_bonded_cmd_xfer(int id, const struct mipi_dsi_msg *msg)
 {
 	struct msm_dsi *master_dsi, *slave_dsi;
 	const struct msm_dsi_host_cfg_ops *ops;
-	int master_id = dsi_mgr_bonded_master_link_id(DSI_0);
+	int master_id = dsi_mgr_bonded_master_link_id(id);
 
 	if (master_id < 0 || master_id >= DSI_MAX)
 		return -EINVAL;
 
+	/*
+	 * Only the master link owns the broadcast engine and its completion
+	 * interrupt. A command issued on the peer link cannot be broadcast:
+	 * reject it here, before any hardware state is touched, instead of
+	 * letting the engines disagree and surface as a bare -EINVAL from the
+	 * controller some layers down.
+	 */
+	if (id != master_id) {
+		dev_err(&dsi_mgr_get_dsi(id)->pdev->dev,
+			"bonded command on link %d, but link %d is the master\n",
+			id, master_id);
+		return -EINVAL;
+	}
+
 	master_dsi = dsi_mgr_get_dsi(master_id);
 	slave_dsi = dsi_mgr_get_other_dsi(master_id);
 	if (!master_dsi || !slave_dsi || !master_dsi->host || !slave_dsi->host)
@@ -679,7 +693,7 @@ int msm_dsi_manager_cmd_xfer(int id, const struct mipi_dsi_msg *msg)
 	}
 
 	if (dsi_mgr_use_bonded_write(msg)) {
-		ret = dsi_mgr_bonded_cmd_xfer(msg);
+		ret = dsi_mgr_bonded_cmd_xfer(id, msg);
 		goto out_unlock;
 	}
 
-- 
