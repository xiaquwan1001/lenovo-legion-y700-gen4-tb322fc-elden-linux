From 8e1a6c5fd5686c84e5d53caa80fd4aee349e75f4 Mon Sep 17 00:00:00 2001
From: Qianhui Xu <xiaqinghuan@mail.ustc.edu.cn>
Date: Wed, 28 Oct 2026 20:03:14 +0800
Subject: [PATCH 2/6] drm/msm/dsi: add per-SoC bonded command-path config

The bonded command path carried its constants inline: the error-mask bits
in dsi_cmd_error_prepare()/dsi_cmd_error_cleanup(), the CMD_DMA_CTRL bits
staged before a broadcast, and the peer poll budget. Those are controller
facts, so they belong in the existing per-SoC table next to the regulator
and bus-clock data rather than in the driver body.

Add struct msm_dsi_bonded_cfg and hang it off struct msm_dsi_config.
SM8750 reports DSI 6G v2.9, the same revision as SM8650, so the revision
alone cannot select the table; give SM8750 an entry of its own and let an
entry that names a SoC match only that SoC, with the generic entry for the
revision staying the fallback. msm_dsi_cfg_get() therefore takes the
device node, which its only caller already has. The io_start, regulator
and bus clock data is the same as SM8650's, so only the bonded pointer
differs.

Signed-off-by: Qianhui Xu <xiaqinghuan@mail.ustc.edu.cn>
---
 drivers/gpu/drm/msm/dsi/dsi_cfg.c  | 62 +++++++++++++++++++++++++++---
 drivers/gpu/drm/msm/dsi/dsi_cfg.h  | 30 ++++++++++++++-
 drivers/gpu/drm/msm/dsi/dsi_host.c |  2 +-
 3 files changed, 86 insertions(+), 8 deletions(-)

diff --git a/drivers/gpu/drm/msm/dsi/dsi_cfg.c b/drivers/gpu/drm/msm/dsi/dsi_cfg.c
index da3fe6824..a7a5c9186 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_cfg.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_cfg.c
@@ -4,6 +4,7 @@
  */
 
 #include "dsi_cfg.h"
+#include "dsi.xml.h"
 
 static const char * const dsi_v2_bus_clk_names[] = {
 	"core_mmss", "iface", "bus",
@@ -194,6 +195,22 @@ static const struct regulator_bulk_data sm8650_dsi_regulators[] = {
 	{ .supply = "vdda", .init_load_uA = 16600 },	/* 1.2 V */
 };
 
+/*
+ * Bonded command-path data. The values are the ones this SoC's controller
+ * needs; the master link is a hardware fact of the panel wiring and is not a
+ * tunable (see sm8750_dsi_cfg).
+ */
+static const struct msm_dsi_bonded_cfg sm8750_dsi_bonded_cfg = {
+	.master_link_id = DSI_0,
+	.cmd_dma_ctrl = DSI_CMD_DMA_CTRL_BROADCAST_EN |
+			DSI_CMD_DMA_CTRL_FROM_FRAME_BUFFER,
+	.err_clear_bits = 0x001f0200,
+	.err_cleanup_bits = 0x44440400,
+	.poll_timeout_us = 5000,	/* 500 polls, 10 us apart */
+	.needs_link_clk_bump = true,
+	.needs_sw_reset = true,
+};
+
 static const struct msm_dsi_config sm8650_dsi_cfg = {
 	.io_offset = DSI_6G_REG_SHIFT,
 	.regulator_data = sm8650_dsi_regulators,
@@ -205,6 +222,24 @@ static const struct msm_dsi_config sm8650_dsi_cfg = {
 	},
 };
 
+/*
+ * SM8750 reports DSI 6G v2.9 as well, so the revision alone cannot select the
+ * table: the bonded command path is only implemented on this part, and the
+ * regulator and bus clock data is the same as SM8650's.
+ */
+static const struct msm_dsi_config sm8750_dsi_cfg = {
+	.io_offset = DSI_6G_REG_SHIFT,
+	.regulator_data = sm8650_dsi_regulators,
+	.num_regulators = ARRAY_SIZE(sm8650_dsi_regulators),
+	.bus_clk_names = dsi_v2_4_clk_names,
+	.num_bus_clks = ARRAY_SIZE(dsi_v2_4_clk_names),
+	.io_start = {
+		{ 0xae94000, 0xae96000 },
+	},
+	.compatible = "qcom,sm8750-dsi-ctrl",
+	.bonded = &sm8750_dsi_bonded_cfg,
+};
+
 static const struct msm_dsi_config kaanapali_dsi_cfg = {
 	.io_offset = DSI_6G_REG_SHIFT,
 	.regulator_data = sm8650_dsi_regulators,
@@ -343,21 +378,36 @@ static const struct msm_dsi_cfg_handler dsi_cfg_handlers[] = {
 		&sm8650_dsi_cfg, &msm_dsi_6g_v2_host_ops},
 	{MSM_DSI_VER_MAJOR_6G, MSM_DSI_6G_VER_MINOR_V2_9_0,
 		&sm8650_dsi_cfg, &msm_dsi_6g_v2_9_host_ops},
+	{MSM_DSI_VER_MAJOR_6G, MSM_DSI_6G_VER_MINOR_V2_9_0,
+		&sm8750_dsi_cfg, &msm_dsi_6g_v2_9_host_ops},
 	{MSM_DSI_VER_MAJOR_6G, MSM_DSI_6G_VER_MINOR_V2_10_0,
 		&kaanapali_dsi_cfg, &msm_dsi_6g_v2_9_host_ops},
 };
 
-const struct msm_dsi_cfg_handler *msm_dsi_cfg_get(u32 major, u32 minor)
+/*
+ * A revision is not unique per SoC: SM8650 and SM8750 both report 6G v2.9 but
+ * need different bonded data. An entry that names a SoC is therefore listed
+ * after the generic one and only matches that SoC; the lookup walks the table
+ * backwards, so the SoC-specific entry wins for its own revision.
+ */
+const struct msm_dsi_cfg_handler *msm_dsi_cfg_get(struct device *dev,
+						  u32 major, u32 minor)
 {
 	const struct msm_dsi_cfg_handler *cfg_hnd = NULL;
 	int i;
 
 	for (i = ARRAY_SIZE(dsi_cfg_handlers) - 1; i >= 0; i--) {
-		if ((dsi_cfg_handlers[i].major == major) &&
-			(dsi_cfg_handlers[i].minor == minor)) {
-			cfg_hnd = &dsi_cfg_handlers[i];
-			break;
-		}
+		if (dsi_cfg_handlers[i].major != major ||
+		    dsi_cfg_handlers[i].minor != minor)
+			continue;
+
+		if (dsi_cfg_handlers[i].cfg->compatible &&
+		    !of_device_is_compatible(dev->of_node,
+					     dsi_cfg_handlers[i].cfg->compatible))
+			continue;
+
+		cfg_hnd = &dsi_cfg_handlers[i];
+		break;
 	}
 
 	return cfg_hnd;
diff --git a/drivers/gpu/drm/msm/dsi/dsi_cfg.h b/drivers/gpu/drm/msm/dsi/dsi_cfg.h
index ccf066796..f06054b20 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_cfg.h
+++ b/drivers/gpu/drm/msm/dsi/dsi_cfg.h
@@ -41,6 +41,26 @@
 /* Maximum number of configurations matched against the same hw revision */
 #define VARIANTS_MAX			2
 
+/**
+ * struct msm_dsi_bonded_cfg - per-SoC data for the bonded command path
+ * @master_link_id: link that drives the broadcast; not the probe order
+ * @cmd_dma_ctrl: CMD_DMA_CTRL bits both engines need while staged
+ * @err_clear_bits: error-mask bits set before a command
+ * @err_cleanup_bits: side-effectful FIFO status bits written after a command
+ * @poll_timeout_us: the peer is polled, never completed through its IRQ
+ * @needs_link_clk_bump: command-time link clock vote for this generation
+ * @needs_sw_reset: this generation needs the stock controller reset sequence
+ */
+struct msm_dsi_bonded_cfg {
+	u8 master_link_id;
+	u32 cmd_dma_ctrl;
+	u32 err_clear_bits;
+	u32 err_cleanup_bits;
+	u32 poll_timeout_us;
+	bool needs_link_clk_bump;
+	bool needs_sw_reset;
+};
+
 struct msm_dsi_config {
 	u32 io_offset;
 	const struct regulator_bulk_data *regulator_data;
@@ -48,6 +68,13 @@ struct msm_dsi_config {
 	const char * const *bus_clk_names;
 	const int num_bus_clks;
 	const resource_size_t io_start[VARIANTS_MAX][DSI_MAX];
+	/*
+	 * NULL when the entry applies to every SoC reporting this revision, as
+	 * is the case for all SoCs but the one below.
+	 */
+	const char *compatible;
+	/* NULL when the SoC has no bonded command path */
+	const struct msm_dsi_bonded_cfg *bonded;
 };
 
 struct msm_dsi_host_cfg_ops {
@@ -69,7 +96,8 @@ struct msm_dsi_cfg_handler {
 	const struct msm_dsi_host_cfg_ops *ops;
 };
 
-const struct msm_dsi_cfg_handler *msm_dsi_cfg_get(u32 major, u32 minor);
+const struct msm_dsi_cfg_handler *msm_dsi_cfg_get(struct device *dev,
+						  u32 major, u32 minor);
 
 #endif /* __MSM_DSI_CFG_H__ */
 
diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index 5405173a4..e82335223 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -245,7 +245,7 @@ dsi_get_config(struct msm_dsi_host *msm_host)
 		goto disable_clks;
 	}
 
-	cfg_hnd = msm_dsi_cfg_get(major, minor);
+	cfg_hnd = msm_dsi_cfg_get(dev, major, minor);
 
 	DBG("%s: Version %x:%x\n", __func__, major, minor);
 
-- 
2.53.0

