+static int dsi_bonded_cmd_poll_slave(struct mipi_dsi_host *host)
 {
 	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
+	u32 timeout_us = dsi_bonded_cfg(msm_host)->poll_timeout_us;
