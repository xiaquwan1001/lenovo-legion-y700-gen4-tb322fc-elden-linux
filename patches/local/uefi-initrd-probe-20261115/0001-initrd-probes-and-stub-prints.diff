diff --git a/init/initramfs.c b/init/initramfs.c
index 3cee8b50ad..b5435ad52e 100644
--- a/init/initramfs.c
+++ b/init/initramfs.c
@@ -507,6 +507,98 @@ static long __init flush_buffer(void *bufv, unsigned long len)
 static unsigned long my_inptr __initdata; /* index of next byte to be processed in inbuf */
 
 #include <linux/decompress/generic.h>
+#include <linux/initrd.h>
+#include <linux/panic_notifier.h>
+
+/*
+ * ELDEN-DBG: initrd content probe.  Sampling rule must match
+ * scripts/lf2-expected.py (SAMPLES=8, BLOCK=4096, FNV-1a 32, "
+ * off_i = i*(len-blk)/(SAMPLES-1)"), so that the console values can be
+ * compared with the host-side expectation for the same file
+ * (raw 64 MiB initrd: len=64595425, sum=0x5c53688e,
+ *  tail=8eff7f5eb9feff01db29f8bf008ad60a).
+ */
+#define ELDEN_SAMPLES 8
+#define ELDEN_BLOCK   4096
+
+/* Lines we re-print at panic time (bottom of screen => photographable). */
+#define ELDEN_SUM_MAX 6
+static char elden_summary[ELDEN_SUM_MAX][192];
+static int elden_summary_n;
+
+static int elden_panic_notify(struct notifier_block *nb, unsigned long val, void *v)
+{
+	int i;
+
+	printk(KERN_EMERG "ELDEN[pn] ===== initrd probe summary (re-print) =====\n");
+	mdelay(1200);
+	for (i = 0; i < elden_summary_n; i++) {
+		printk(KERN_EMERG "%s\n", elden_summary[i]);
+		mdelay(1800);
+	}
+	printk(KERN_EMERG "ELDEN[pn] ===== end =====\n");
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block elden_panic_nb = {
+	.notifier_call = elden_panic_notify,
+};
+
+static void __init elden_summary_add(const char *line)
+{
+	if (elden_summary_n < ELDEN_SUM_MAX)
+		strscpy(elden_summary[elden_summary_n++], line, 192);
+}
+
+static bool __initdata elden_panic_registered;
+
+static u32 __init elden_fnv1a(u32 h, const u8 *p, unsigned long n)
+{
+	unsigned long i;
+
+	for (i = 0; i < n; i++)
+		h = (h ^ p[i]) * 0x01000193u;
+	return h;
+}
+
+void __init elden_probe(const char *tag, phys_addr_t phys, unsigned long len)
+{
+	const u8 *p = __va(phys);
+	unsigned long blk, off, i;
+	u32 h = 0x811c9dc5u;
+	char tail[34];
+
+	if (!len) {
+		pr_err("ELDEN[%s] no buffer (len=%lu)\n", tag, len);
+		return;
+	}
+	blk = min_t(unsigned long, ELDEN_BLOCK, len);
+	for (i = 0; i < ELDEN_SAMPLES; i++) {
+		off = (i * (len - blk)) / (ELDEN_SAMPLES - 1);
+		h = elden_fnv1a(h, p + off, blk);
+	}
+	tail[0] = '\0';
+	if (len >= 16) {
+		for (i = 0; i < 16; i++)
+			sprintf(&tail[i * 2], "%02x", p[len - 16 + i]);
+	}
+	{
+		char line[192];
+
+		scnprintf(line, sizeof(line),
+			  "ELDEN[%s] len=%lu phys=0x%llx sum=0x%08x tail=%s",
+			  tag, len, (u64)phys, h, tail);
+		pr_err("%s\n", line);
+		/* keep the line on screen long enough for a photo */
+		mdelay(1200);
+		elden_summary_add(line);
+		if (!elden_panic_registered) {
+			elden_panic_registered = 1;
+			atomic_notifier_chain_register(&panic_notifier_list,
+						       &elden_panic_nb);
+		}
+	}
+}
 
