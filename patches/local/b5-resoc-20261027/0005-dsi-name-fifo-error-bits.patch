Subject: [PATCH 0005/0005] drm/msm/dsi: name the FIFO error bits of the command path

The bonded command path masks the controller FIFO error group around every
broadcast command and clears the corresponding sticky status bits afterwards.
Both were spelled as magic numbers (0x001f0200 in ERR_INT_MASK0, 0x44440400 in
FIFO_STATUS), which is why the change was previously treated as unsubmittable:
the register bits were believed to be undocumented.

They are documented: drivers/gpu/drm/msm/generated/dsi.xml.h names the FIFO
status bits (bit 10 CMD_DMA_FIFO_UNDERFLOW, bits 18/22/26/30 the DLN0..DLN3
HS_FIFO_OVERFLOW of the four data lanes), and their OR is exactly 0x44440400.
ERR_INT_MASK0 itself has no field definitions in dsi.xml, so its side is stated
explicitly: the overflow group is bits 20:16 (bits 16:19 are the same four
lane overflows, bit 20 is masked with the group) and the command DMA FIFO
underflow is bit 9 - GENMASK(20, 16) | BIT(9) = 0x001f0200. The grouping is
not guessed: the vendor driver's mask_error_intr() masks exactly these bits as
one FIFO error group and then W1C-clears the five matching sticky status bits.

No functional change: the disassembly of dsi_host.o is byte-identical before
and after (.text compared with objcopy).

Signed-off-by: Qianhui Xu <xiaqinghuan@mail.ustc.edu.cn>
---
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -2345,16 +2345,44 @@
 	dsi_wait4video_eng_busy(to_msm_dsi_host(host));
 }
 
+/*
+ * FIFO errors of the controller, handled as one group: the high speed FIFO
+ * overflows of the four data lanes and the command DMA FIFO underflow.
+ * dsi.xml does not describe the ERR_INT_MASK0 layout, so the mask bits are
+ * spelled out: the FIFO overflow group occupies bits 20:16 (bits 16:19 are the
+ * DLN0..DLN3 overflows, bit 20 is masked with the group) and the command DMA
+ * FIFO underflow is bit 9 - the grouping follows the vendor driver's
+ * mask_error_intr(), which masks these bits as one FIFO error group.
+ */
+#define DSI_ERR_INT_MASK0_FIFO_OVERFLOW			GENMASK(20, 16)
+#define DSI_ERR_INT_MASK0_CMD_DMA_FIFO_UNDERFLOW	BIT(9)
+#define DSI_ERR_INT_MASK0_FIFO_ERRORS			\
+	(DSI_ERR_INT_MASK0_FIFO_OVERFLOW | DSI_ERR_INT_MASK0_CMD_DMA_FIFO_UNDERFLOW)
+
+/* FIFO_STATUS is write-1-to-clear; these are its FIFO error status bits. */
+#define DSI_FIFO_STATUS_FIFO_ERRORS			\
+	(DSI_FIFO_STATUS_CMD_DMA_FIFO_UNDERFLOW |	\
+	 DSI_FIFO_STATUS_DLN0_HS_FIFO_OVERFLOW |	\
+	 DSI_FIFO_STATUS_DLN1_HS_FIFO_OVERFLOW |	\
+	 DSI_FIFO_STATUS_DLN2_HS_FIFO_OVERFLOW |	\
+	 DSI_FIFO_STATUS_DLN3_HS_FIFO_OVERFLOW)
+
 static void dsi_cmd_error_prepare(struct msm_dsi_host *msm_host)
 {
 	u32 val;
 
+	/*
+	 * Mask the FIFO error group across a broadcast command: a slave that is
+	 * not ready yet may overflow its FIFO, which must not abort the whole
+	 * link.  The mask write has to complete before the stale status below is
+	 * cleared, as those status bits are sticky.
+	 */
 	val = dsi_read(msm_host, REG_DSI_ERR_INT_MASK0);
-	val |= 0x001f0200;
+	val |= DSI_ERR_INT_MASK0_FIFO_ERRORS;
 	dsi_write(msm_host, REG_DSI_ERR_INT_MASK0, val);
-	wmb(); /* Stock completes the error-mask write before stale clear. */
+	wmb();
 
-	/* Stock clear_error_status(0x20): LP RX timeout status bit 4. */
+	/* LP RX timeout (TIMEOUT_STATUS bit 4) is sticky as well. */
 	dsi_write(msm_host, REG_DSI_TIMEOUT_STATUS, BIT(4));
 }
 
@@ -2362,15 +2391,19 @@
 {
 	u32 val;
 
-	/* Stock mask_error_intr(0x2, false) W1C-clears FIFO errors. */
+	/*
+	 * Clear the FIFO status bits that latched while they were masked, then
+	 * unmask the group: these are sticky, so clearing before unmasking is
+	 * what keeps a stale overflow from firing the moment the mask lifts.
+	 */
 	val = dsi_read(msm_host, REG_DSI_FIFO_STATUS);
-	dsi_write(msm_host, REG_DSI_FIFO_STATUS, val | 0x44440400);
+	dsi_write(msm_host, REG_DSI_FIFO_STATUS, val | DSI_FIFO_STATUS_FIFO_ERRORS);
 	val = dsi_read(msm_host, REG_DSI_ERR_INT_MASK0);
-	val &= ~0x001f0200;
+	val &= ~DSI_ERR_INT_MASK0_FIFO_ERRORS;
 	dsi_write(msm_host, REG_DSI_ERR_INT_MASK0, val);
-	wmb(); /* Complete overflow unmask before stale-error clear. */
+	wmb();
 
-	/* Stock repeats clear_error_status(0x20) after command-engine off. */
+	/* Drop the LP RX timeout latched during the command as well. */
 	dsi_write(msm_host, REG_DSI_TIMEOUT_STATUS, BIT(4));
 }
 
