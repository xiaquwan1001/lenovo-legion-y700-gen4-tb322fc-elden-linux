+	if (fd < 0) {
+		fprintf(stderr, "Could not open %s: %s\n",
+				(const char *) inbufs[0].p, strerror(errno));
+		return AEE_EFAILED;
+	}
+
+	out[0] = fd;
+	out[1] = 0;
+
+	return 0;
