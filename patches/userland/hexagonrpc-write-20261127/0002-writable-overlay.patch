+static uint32_t apps_std_ftell(void *data,
+			       const struct fastrpc_io_buffer *inbufs,
+			       struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const uint32_t *fd = inbufs[0].p;
+	uint32_t *out = outbufs[0].p;
+	off_t pos;
+
+	if (overlay_is_fd(*fd)) {
+		pos = lseek(*fd - OVERLAY_FD_BASE, 0, SEEK_CUR);
+	} else {
+		struct stat st;
+
+		if (hexagonfs_fstat(ctx->fds, *fd, &st))
+			return AEE_EFAILED;
+		pos = 0;	/* mapped files are read sequentially */
+	}
+
+	if (pos < 0)
+		return AEE_EFAILED;
+
+	*out = (uint32_t) pos;
+	return 0;
+}
+
+static uint32_t apps_std_flen(void *data,
+			      const struct fastrpc_io_buffer *inbufs,
+			      struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const uint32_t *fd = inbufs[0].p;
+	uint64_t *out = outbufs[0].p;
+	struct stat st;
+
+	if (overlay_is_fd(*fd)) {
+		if (fstat(*fd - OVERLAY_FD_BASE, &st) < 0)
+			return AEE_EFAILED;
+	} else if (hexagonfs_fstat(ctx->fds, *fd, &st)) {
+		return AEE_EFAILED;
+	}
+
+	*out = (uint64_t) st.st_size;
+	return 0;
+}
+
+static uint32_t apps_std_fileExists(void *data,
+				    const struct fastrpc_io_buffer *inbufs,
+				    struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const char *path = inbufs[0].p;
+	uint32_t *out = outbufs[0].p;
+	struct stat st;
+	int fd;
+
+	if (overlay_stat(path, &st) == 0) {
+		*out = 1;
+		return 0;
+	}
+
+	fd = hexagonfs_openat(ctx->fds, ctx->rootfd, ctx->rootfd, path);
+	if (fd < 0) {
+		*out = 0;
+		return 0;
+	}
+
+	hexagonfs_close(ctx->fds, fd);
+	*out = 1;
+
+	return 0;
+}
+
+static uint32_t apps_std_fsync(void *data,
+			       const struct fastrpc_io_buffer *inbufs,
+			       struct fastrpc_io_buffer *outbufs)
+{
+	const uint32_t *fd = inbufs[0].p;
+
+	if (!overlay_is_fd(*fd))
+		return 0;
+
+	return overlay_fsync(*fd) ? AEE_EFAILED : 0;
+}
+
+static uint32_t apps_std_fremove(void *data,
+				 const struct fastrpc_io_buffer *inbufs,
+				 struct fastrpc_io_buffer *outbufs)
+{
+	const char *path = inbufs[0].p;
+
+	if (overlay_remove(path) && errno != ENOENT)
+		return AEE_EFAILED;
+
+	return 0;
+}
+
+static uint32_t apps_std_mkdir(void *data,
+			       const struct fastrpc_io_buffer *inbufs,
+			       struct fastrpc_io_buffer *outbufs)
+{
+	const char *path = inbufs[0].p;
+
+	return overlay_mkdir(path) ? AEE_EFAILED : 0;
+}
+
+static uint32_t apps_std_rmdir(void *data,
+			       const struct fastrpc_io_buffer *inbufs,
+			       struct fastrpc_io_buffer *outbufs)
+{
+	const char *path = inbufs[0].p;
+
+	if (overlay_rmdir(path) && errno != ENOENT)
+		return AEE_EFAILED;
+
+	return 0;
+}
+
+static uint32_t apps_std_ftrunc(void *data,
+				const struct fastrpc_io_buffer *inbufs,
+				struct fastrpc_io_buffer *outbufs)
+{
+	const struct {
+		uint32_t fd;
+		uint32_t len;
+	} *in = inbufs[0].p;
+
+	if (!overlay_is_fd(in->fd))
+		return AEE_EUNSUPPORTED;
+
+	return overlay_ftrunc(in->fd, in->len) ? AEE_EFAILED : 0;
+}
+
+static uint32_t apps_std_frename(void *data,
+				 const struct fastrpc_io_buffer *inbufs,
+				 struct fastrpc_io_buffer *outbufs)
+{
+	const char *from = inbufs[0].p;
+	const char *to = inbufs[1].p;
+
+	return overlay_rename(from, to) ? AEE_EFAILED : 0;
+}
