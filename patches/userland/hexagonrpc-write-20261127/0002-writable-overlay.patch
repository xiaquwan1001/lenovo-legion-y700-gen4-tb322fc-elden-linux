+/*
+ * Copy a file from the read-only mapped tree into the overlay (if it is not
+ * there yet), so the DSP can then write to it.
+ */
+static int apps_std_copyup(struct apps_std_ctx *ctx, const char *vpath)
+{
+	struct stat st;
+	char buf[4096];
+	ssize_t n;
+	int fd, src, ret;
+
+	if (overlay_stat(vpath, &st) == 0)
+		return 0;
+
+	src = hexagonfs_openat(ctx->fds, ctx->rootfd, ctx->rootfd, vpath);
+	if (src < 0)
+		return 0;	/* nothing to copy: DSP is creating a new file */
+
+	ret = overlay_open(vpath, false, true, &fd);
+	if (ret)
+		goto out_close;
+
+	while ((n = hexagonfs_read(ctx->fds, src, sizeof(buf), buf)) > 0) {
+		if (overlay_write(fd, buf, n) != n) {
+			ret = -EIO;
+			break;
+		}
+	}
+
+	overlay_close(fd);
+out_close:
+	hexagonfs_close(ctx->fds, src);
+	return ret;
+}
