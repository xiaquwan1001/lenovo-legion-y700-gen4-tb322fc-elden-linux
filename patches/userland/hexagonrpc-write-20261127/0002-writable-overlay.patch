diff -ruN base-0001/hexagonrpcd/overlay.c hrpcd-patch/hexagonrpcd/overlay.c
--- base-0001/hexagonrpcd/overlay.c	1970-01-01 08:00:00.000000000 +0800
+++ hrpcd-patch/hexagonrpcd/overlay.c	2026-11-27 07:21:55.559635795 +0800
@@ -0,0 +1,220 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+/*
+ * Writable overlay backend for hexagonrpcd.
+ *
+ * The DSP writes its sensor registry through the apps_std file service.  The
+ * mapped HexagonFS backend is read-only, so all writes are redirected into a
+ * real directory (root given by HEXAGONRPC_OVERLAY or -O), using the virtual
+ * path as the relative path.  Reads consult the overlay first and fall back to
+ * the mapped tree in the caller.
+ */
+#include <errno.h>
+#include <limits.h>
+
+#ifndef PATH_MAX_LEN
+#define PATH_MAX_LEN PATH_MAX
+#endif
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#include "overlay.h"
+
+static char *overlay_root;
+
+int overlay_init(const char *dir)
+{
+	if (dir == NULL || dir[0] == '\0')
+		return -EINVAL;
+
+	overlay_root = realpath(dir, NULL);
+	if (overlay_root == NULL) {
+		if (mkdir(dir, 0755) < 0 && errno != EEXIST)
+			return -errno;
+		overlay_root = realpath(dir, NULL);
+		if (overlay_root == NULL)
+			return -errno;
+	}
+
+	return 0;
+}
+
+bool overlay_enabled(void)
+{
+	return overlay_root != NULL;
+}
+
+bool overlay_is_fd(int fd)
+{
+	return overlay_enabled() && fd >= OVERLAY_FD_BASE;
+}
+
+const char *overlay_phys_path(const char *vpath)
+{
+	static char path[PATH_MAX_LEN];
+	const char *rel = vpath;
+
+	while (*rel == '/')
+		rel++;
+
+	if ((size_t) snprintf(path, sizeof(path), "%s/%s", overlay_root, rel)
+	    >= sizeof(path))
+		return NULL;
+
+	return path;
+}
+
+/* Create all parent directories of an overlay-relative path. */
+static int mkdir_parents(const char *vpath)
+{
+	char path[PATH_MAX_LEN];
+	const char *rel = vpath;
+	char *slash;
+
+	while (*rel == '/')
+		rel++;
+
+	if ((size_t) snprintf(path, sizeof(path), "%s/%s", overlay_root, rel)
+	    >= sizeof(path))
+		return -ENAMETOOLONG;
+
+	for (slash = strchr(path + strlen(overlay_root) + 1, '/'); slash != NULL;
+	     slash = strchr(slash + 1, '/')) {
+		*slash = '\0';
+		if (mkdir(path, 0755) < 0 && errno != EEXIST)
+			return -errno;
+		*slash = '/';
+	}
+
+	return 0;
+}
+
+int overlay_stat(const char *vpath, struct stat *st)
+{
+	const char *path = overlay_phys_path(vpath);
+
+	if (path == NULL)
+		return -ENAMETOOLONG;
+	if (stat(path, st) < 0)
+		return -errno;
+
+	return 0;
+}
+
+int overlay_open(const char *vpath, bool append, bool create, int *fd_out)
+{
+	const char *path = overlay_phys_path(vpath);
+	int flags = O_RDWR;
+	int fd, ret;
+
+	if (path == NULL)
+		return -ENAMETOOLONG;
+
+	ret = mkdir_parents(vpath);
+	if (ret)
+		return ret;
+
+	if (create)
+		flags |= O_CREAT;
+	if (append)
+		flags |= O_APPEND;
+
+	fd = open(path, flags, 0644);
+	if (fd < 0)
+		return -errno;
+
+	*fd_out = fd + OVERLAY_FD_BASE;
+
+	return 0;
+}
+
+int overlay_close(int fd)
+{
+	return close(fd - OVERLAY_FD_BASE) < 0 ? -errno : 0;
+}
+
+ssize_t overlay_read(int fd, void *buf, size_t n)
+{
+	ssize_t ret = read(fd - OVERLAY_FD_BASE, buf, n);
+
+	return ret < 0 ? -errno : ret;
+}
+
+ssize_t overlay_write(int fd, const void *buf, size_t n)
+{
+	ssize_t ret = write(fd - OVERLAY_FD_BASE, buf, n);
+
+	return ret < 0 ? -errno : ret;
+}
+
+int overlay_seek(int fd, off_t off, int whence)
+{
+	return lseek(fd - OVERLAY_FD_BASE, off, whence) < 0 ? -errno : 0;
+}
+
+int overlay_fsync(int fd)
+{
+	return fsync(fd - OVERLAY_FD_BASE) < 0 ? -errno : 0;
+}
+
+int overlay_ftrunc(int fd, off_t len)
+{
+	return ftruncate(fd - OVERLAY_FD_BASE, len) < 0 ? -errno : 0;
+}
+
+int overlay_remove(const char *vpath)
+{
+	const char *path = overlay_phys_path(vpath);
+
+	if (path == NULL)
+		return -ENAMETOOLONG;
+	if (unlink(path) < 0)
+		return -errno;
+	return 0;
+}
+
+int overlay_rename(const char *oldpath, const char *newpath)
+{
+	const char *from = overlay_phys_path(oldpath);
+	char to_buf[PATH_MAX_LEN];
+	int ret;
+
+	if (from == NULL)
+		return -ENAMETOOLONG;
+
+	ret = mkdir_parents(newpath);
+	if (ret)
+		return ret;
+
+	snprintf(to_buf, sizeof(to_buf), "%s", overlay_phys_path(newpath));
+	if (rename(from, to_buf) < 0)
+		return -errno;
+
+	return 0;
+}
+
+int overlay_mkdir(const char *vpath)
+{
+	const char *path = overlay_phys_path(vpath);
+
+	if (path == NULL)
+		return -ENAMETOOLONG;
+	if (mkdir(path, 0755) < 0 && errno != EEXIST)
+		return -errno;
+	return 0;
+}
+
+int overlay_rmdir(const char *vpath)
+{
+	const char *path = overlay_phys_path(vpath);
+
+	if (path == NULL)
+		return -ENAMETOOLONG;
+	if (rmdir(path) < 0)
+		return -errno;
+	return 0;
+}
