diff --git a/hexagonrpcd/apps_std.c b/hexagonrpcd/apps_std.c
index 7172bf0..01adb34 100644
--- a/hexagonrpcd/apps_std.c
+++ b/hexagonrpcd/apps_std.c
@@ -120,6 +120,35 @@ static uint32_t apps_std_fread(void *data,
 	return 0;
 }
 
+static uint32_t apps_std_fwrite(void *data,
+				const struct fastrpc_io_buffer *inbufs,
+				struct fastrpc_io_buffer *outbufs)
+{
+	/*
+	 * The HexagonFS mapped backend is read-only, so writes are accepted and
+	 * reported as successful but are *not* persisted.  This is enough for
+	 * firmwares that rewrite their sensor registry on attach and only need
+	 * the write to go through; the previous state is re-read on next attach.
+	 */
+	const struct {
+		uint32_t fd;
+		uint32_t buf_size;
+	} *first_in = inbufs[0].p;
+	struct {
+		uint32_t written;
+		uint32_t is_eof;
+	} *first_out = outbufs[0].p;
+
+#ifdef HEXAGONRPC_VERBOSE
+	printf("write(%u, %u) -> faked\n", first_in->fd, first_in->buf_size);
+#endif
+
+	first_out->written = first_in->buf_size;
+	first_out->is_eof = 0;
+
+	return 0;
+}
+
 static uint32_t apps_std_fseek(void *data,
 			       const struct fastrpc_io_buffer *inbufs,
 			       struct fastrpc_io_buffer *outbufs)
@@ -167,9 +196,12 @@ static uint32_t apps_std_fopen_with_env(void *data,
 
 	rw_mode = ((const char *) inbufs[4].p)[0];
 	if (rw_mode == 'w' || rw_mode == 'a') {
-		fprintf(stderr, "Tried to open %s for writing\n",
+		/*
+		 * Read-only backend: allow the open (firmware refuses to attach
+		 * otherwise) and let fwrite() report success without persisting.
+		 */
+		fprintf(stderr, "Opening %s for writing (writes are discarded)\n",
 				(const char *) inbufs[3].p);
-		return AEE_EUNSUPPORTED;
 	}
 
 	if (!strcmp(inbufs[1].p, "ADSP_LIBRARY_PATH")) {
@@ -423,7 +455,10 @@ static const struct fastrpc_function_impl apps_std_procs[] = {
 	{ .def = NULL, .impl = NULL, },
 	{ .def = NULL, .impl = NULL, },
 	{ .def = NULL, .impl = NULL, },
-	{ .def = NULL, .impl = NULL, },
+	{
+		.def = &apps_std_fwrite_def,
+		.impl = apps_std_fwrite,
+	},
 	{
 		.def = &apps_std_fseek_def,
 		.impl = apps_std_fseek,
