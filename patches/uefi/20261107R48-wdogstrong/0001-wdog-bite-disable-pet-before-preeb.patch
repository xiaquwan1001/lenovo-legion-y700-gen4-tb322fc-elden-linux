--- a/Platforms/QcomModulePkg/Library/BootLib/BootLinux.c
+++ b/Platforms/QcomModulePkg/Library/BootLib/BootLinux.c
@@ -1393,41 +1393,40 @@
     SbLen = AsciiSPrint (SbLine, sizeof (SbLine), "[K] preeb-go\n\r");
     SerialPortWrite ((UINT8 *)SbLine, SbLen);
   }
-  SbDumpLog ("preeb");
-  {
-    CHAR8  SbLine[64];
-    UINTN  SbLen;
-    SbLen = AsciiSPrint (SbLine, sizeof (SbLine), "[K] preeb-ok\n\r");
-    SerialPortWrite ((UINT8 *)SbLine, SbLen);
-  }
-
-  SB_STOP (40, "40");   // 2026-11-06R3: ShutdownUefiBootServices 之前（全流程最后一个有 gBS 的点）
-
-  // 2026-11-07R47 y700-elden: **跳转前关掉硬件看门狗**。
-  // 证据链：① 本构建的 UEFI 日志里有 `HW Wdog Setting from PCD : Enabled`（QcomWDogDxe 主动开了
-  // 硬件 WDT）；② p50/p51 三发里**交棒成立**的那个内核（其 `Kernel command line` 带
-  // `elden_bootpath=uefi`）都在 **~4.04–4.12 s** 处日志戛然而止、随后整机硬复位（`PM: Reset by
-  // PSHOLD / Hard Reset`）；③ 同一内核由 ABL 引导时能跑满（无 wdog 类事件），主线上没有
-  // `qcom_wdt` 驱动去喂它 ⇒ 最合理解释 = UEFI 开着的 HW WDT 在交棒后无人 pet，约 4 s 咬掉。
-  // 这里用 Qcom 的 KernelInterface（`gEfiKernelProtocolGuid` 的 `WDog->WdogDisable`）在
-  // **EB 之前**（协议还活着）关掉它，并上屏 + 进环留痕。
+  // 2026-11-07R48 y700-elden: **跳转前关掉/喂饱硬件看门狗**（放在 `preeb` 转储之前 ⇒ 结论会进 logfs）。
+  // R47 的实测：加 `WdogDisable()` 后死点从 4.04–4.12 s 推到 9.909 s（仍未存活）⇒ 更像
+  // 「WDT bite 超时 ≈10 s，UEFI 的 QcomWDogDxe 每隔几秒 pet 一次，最后一次 pet 离跳转多近就决定
+  // 咬在几秒后」。本发把三件事都做：置 bite 超时到最大、Disable、再 ForcePet 一次，
+  // 并把每个 EFI_STATUS 打进环（logfs 的 preeb 转储会带上）。
   {
-    CHAR8              SbLine[96];
-    UINTN              SbLen;
+    CHAR8               SbLine[128];
+    UINTN               SbLen;
     EFI_KERNEL_PROTOCOL *SbKern = NULL;
-    EFI_STATUS         SbWdogSt;
+    EFI_STATUS          SbLoc, SbBite;
 
-    SbWdogSt = gBS->LocateProtocol (&gEfiKernelProtocolGuid, NULL, (VOID **)&SbKern);
-    if (!EFI_ERROR (SbWdogSt) && (SbKern != NULL) && (SbKern->WDog != NULL)) {
+    SbLoc = gBS->LocateProtocol (&gEfiKernelProtocolGuid, NULL, (VOID **)&SbKern);
+    if (!EFI_ERROR (SbLoc) && (SbKern != NULL) && (SbKern->WDog != NULL)) {
+      SbBite = SbKern->WDog->WdogSetBiteTimeout (0x7FFFFFFF);
       SbKern->WDog->WdogDisable ();
-      SbLen = AsciiSPrint (SbLine, sizeof (SbLine), "[K] wdog-off ok\n\r");
+      SbKern->WDog->WdogForcePet ();
+      SbLen = AsciiSPrint (SbLine, sizeof (SbLine), "[K] wdog-off ok bite=%r\n\r", SbBite);
     } else {
-      SbLen = AsciiSPrint (SbLine, sizeof (SbLine), "[K] wdog-off miss st=%r\n\r", SbWdogSt);
+      SbLen = AsciiSPrint (SbLine, sizeof (SbLine), "[K] wdog-off miss loc=%r\n\r", SbLoc);
     }
     SerialPortWrite ((UINT8 *)SbLine, SbLen);
     SerialPortLogPutString (SbLine);
   }
 
+  SbDumpLog ("preeb");
+  {
+    CHAR8  SbLine[64];
+    UINTN  SbLen;
+    SbLen = AsciiSPrint (SbLine, sizeof (SbLine), "[K] preeb-ok\n\r");
+    SerialPortWrite ((UINT8 *)SbLine, SbLen);
+  }
+
+  SB_STOP (40, "40");   // 2026-11-06R3: ShutdownUefiBootServices 之前（全流程最后一个有 gBS 的点）
+
   DEBUG ((EFI_D_INFO, "\nShutting Down UEFI Boot Services: %lu ms\n",
           GetTimerCountms ()));
   /*Shut down UEFI boot services*/
