+/* R56: panel-visible markers for the ESP-first path. SerialPortLib is
+ * resolved (Andromeda.dsc.inc) to FrameBufferSerialPortLib, which paints the
+ * Display Reserved region -- the only visible channel on this platform.
+ * Sentinels: Val == ESP_MARK_NO_VAL means print the line as-is. */
+#define ESP_MARK_NO_VAL  MAX_UINT64
+
+STATIC VOID
+EspMark (CONST CHAR8 *Line, UINT64 Val)
+{
+  CHAR8 Buf[128];
+  UINTN N;
+
+  if (Val == ESP_MARK_NO_VAL) {
+    N = AsciiStrLen (Line);
+    CopyMem (Buf, Line, N);
+    Buf[N++] = '\n';
+  } else {
+    N = AsciiSPrint (Buf, sizeof (Buf) - 1, "%a %lu\n", Line, Val);
+  }
+  SerialPortWrite ((UINT8 *)Buf, N);
+}
