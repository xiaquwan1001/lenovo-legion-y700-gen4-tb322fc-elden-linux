+//
+// 2026-11-04 y700-elden 调试插桩：屏上串口步进痕迹（FrameBufferSerialPortLib 已生效）
+// 每条 = 一行 "[Pxx]\n\r"；看到最后一条就知道死在它之后的那一步。
+//
+STATIC
+VOID
+SbMark (
+  IN CONST CHAR8  *Tag
+  )
+{
+  CHAR8  Buf[32];
+  UINTN  Len;
+  for (Len = 0; Tag[Len] != 0 && Len < 8; Len++) {
+    Buf[Len] = Tag[Len];
+  }
+  Buf[Len++] = '\n';
+  Buf[Len++] = '\r';
+  SerialPortWrite ((UINT8 *)Buf, Len);
+}
