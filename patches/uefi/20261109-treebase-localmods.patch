+/*
+ * ESP-first boot (2026-11-08 R55): when this loader itself sits on a volume
+ * (e.g. the ESP) that carries \boot\boot.img (optionally \boot\dtbo.img),
+ * load the images from there and skip AVB entirely -- self-signed images
+ * cannot pass AVB. On any failure, free everything and return EFI_NOT_FOUND
+ * so that the caller falls back to the original partition-load path with
+ * behaviour unchanged.
+ *
+ * Comparison口径: GetImage() matches Info->Images[i].Name against the
+ * requested image name with AsciiStrnCmp(Name, ImageName, len(ImageName)),
+ * so "boot" / "dtbo" are the correct Names here (same as partition names
+ * "boot_a" etc. which also match by prefix).
+ */
+/* R56: panel-visible markers for the ESP-first path. SerialPortLib is
+ * resolved (Andromeda.dsc.inc) to FrameBufferSerialPortLib, which paints the
+ * Display Reserved region -- the only visible channel on this platform.
+ * Sentinels: Val == ESP_MARK_NO_VAL means print the line as-is. */
+#define ESP_MARK_NO_VAL  MAX_UINT64
+
+/* R57: every mark also lands in \espboot.log on the ESP, so the result is
+ * machine-readable even when the panel channel is dead (or when the machine
+ * powers off right after the failure). */
+STATIC EFI_FILE_PROTOCOL *mEspLog = NULL;
+
+STATIC VOID
+EspMark (CONST CHAR8 *Line, UINT64 Val)
+{
+  CHAR8 Buf[128];
+  UINTN N;
+
+  if (Val == ESP_MARK_NO_VAL) {
+    N = AsciiStrLen (Line);
+    CopyMem (Buf, Line, N);
+    Buf[N++] = '\n';
+  } else {
+    N = AsciiSPrint (Buf, sizeof (Buf) - 1, "%a %lu\n", Line, Val);
+  }
+  SerialPortWrite ((UINT8 *)Buf, N);
+
+  if (mEspLog != NULL) {
+    mEspLog->Write (mEspLog, &N, Buf);
+    mEspLog->Flush (mEspLog);
+  }
+}
