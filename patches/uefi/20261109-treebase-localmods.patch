+    continue;
+
+ReadFail:
+    if (File != NULL) {
+      File->Close (File);
+      File = NULL;
+    }
+    if (EspFiles[Idx].Required) {
+      DEBUG ((EFI_D_INFO, "ESPBOOT: read %s failed (%r), "
