+  EFI_TIME      Now;
+  STATIC UINTN   m_R68Len = 0;
+  STATIC BOOLEAN m_R68Init = FALSE;
+  STATIC UINTN   m_R68Seq = 0;
 
   Handles = NULL;
   Count   = 0;
@@ -956,13 +961,38 @@ R66Beacon (
     Total = (UINT64)(BlkIo->Media->LastBlock + 1) * (UINT64)Bs;
     Lba   = ((Total - R66_BUF_SZ) / (UINT64)Bs) + 1;   /* 记录区第 2 块：保留 SBLOG0 头 */
 
-    ZeroMem (m_R66Buf, Bs);
-    Len = AsciiSPrint (Line, sizeof (Line), "R66STG st=%d tag=%a bs=%d\n",
-                       Stage, (Tag != NULL) ? Tag : "-", (UINT32)Bs);
-    CopyMem (m_R66Buf, Line, (Len < Bs) ? Len : Bs);
+    // 2026-11-10R68 y700-elden: **每 boot 唯一 + 累积轨迹**（R66 的固定单条无法区分"跑到过"与"本发跑到"）。
+    // 首次调用：清零整块、写入带时间戳的头（两次启动的秒级时间戳不可能相同）；其后每 stage 追加。
+    // 因此本块内容**只反映最后一次跑到它的那次启动**：读到什么 st 就是那一发跑到了什么。
+    if (!m_R68Init) {
+      // 单调计数 n：先读回上一发写下的 n 再 +1 ⇒ 「本发到底有没有跑」不再依赖内容是否巧合相同（PITFALLS #586）。
+      CHAR8         *SeqStr;
+
+      ZeroMem (m_R68Buf, R66_BUF_SZ);
+      ZeroMem (m_R66Buf, R66_BUF_SZ);
+      if (!EFI_ERROR (BlkIo->ReadBlocks (BlkIo, BlkIo->Media->MediaId, Lba, Bs, m_R66Buf))) {
+        SeqStr = AsciiStrStr ((CHAR8 *)m_R66Buf, "R68LOG n=");
+        if (SeqStr != NULL) {
+          m_R68Seq = AsciiStrDecimalToUintn (SeqStr + 9) + 1;
+        }
+      }
+      if (m_R68Seq == 0) {
+        m_R68Seq = 1;
+      }
+      if (!EFI_ERROR (gRT->GetTime (&Now, NULL))) {
+        m_R68Len = AsciiSPrint ((CHAR8 *)m_R68Buf, 96, "R68LOG n=%d b=%04d%02d%02d%02d%02d%02d bs=%d ",
+                                (UINT32)m_R68Seq, Now.Year, Now.Month, Now.Day, Now.Hour, Now.Minute, Now.Second,
+                                (UINT32)Bs);
+      } else {
+        m_R68Len = AsciiSPrint ((CHAR8 *)m_R68Buf, 96, "R68LOG n=%d b=0 bs=%d ", (UINT32)m_R68Seq, (UINT32)Bs);
+      }
+      m_R68Init = TRUE;
+    }
+    m_R68Len += AsciiSPrint ((CHAR8 *)m_R68Buf + m_R68Len, R66_BUF_SZ - m_R68Len, "s%u:%a ",
+                             Stage, (Tag != NULL) ? Tag : "-");
 
-    Status = BlkIo->WriteBlocks (BlkIo, BlkIo->Media->MediaId, Lba, Bs, m_R66Buf);
-    Len    = AsciiSPrint (Line, sizeof (Line), "[K] bec st=%d %r\n\r", Stage, Status);
+    Status = BlkIo->WriteBlocks (BlkIo, BlkIo->Media->MediaId, Lba, Bs, m_R68Buf);
+    Len    = AsciiSPrint (Line, sizeof (Line), "[K] tr st=%d %r\n\r", Stage, Status);
     SerialPortWrite ((UINT8 *)Line, Len);
     break;
   }
