 STATIC UINT8  m_R66Buf[R66_BUF_SZ];
+STATIC UINT8  m_R68Buf[R66_BUF_SZ];   // 2026-11-10R68：轨迹专用（R66IsLogfs 会读写 m_R66Buf）
 
