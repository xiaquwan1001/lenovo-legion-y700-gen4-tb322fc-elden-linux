diff --git a/EmbeddedPkg/Library/PrePiLib/FwVol.c b/EmbeddedPkg/Library/PrePiLib/FwVol.c
index ed69f3e..ee34653 100644
--- a/EmbeddedPkg/Library/PrePiLib/FwVol.c
+++ b/EmbeddedPkg/Library/PrePiLib/FwVol.c
@@ -419,6 +419,29 @@ FfsProcessSection (
         FvHex ((UINT64)Status);
         FvHex ((UINT64)DstBufferSize);
         FvHex ((UINT64)ScratchBufferSize);
+        {
+          STATIC CONST UINTN  Chk[] = { 0x1000, 0x10000, 0x40000, 0x80000, 0x100000, 0x180000, 0x200000 };
+          UINT8               *Cp    = (UINT8 *)Section + ((EFI_GUID_DEFINED_SECTION *)Section)->DataOffset + 13;
+          UINTN                CpLen = SECTION_SIZE (Section) - ((EFI_GUID_DEFINED_SECTION *)Section)->DataOffset - 13;
+          UINT64               Fnv   = 0xcbf29ce484222325ULL;
+          UINTN                i;
+          UINTN                c     = 0;
+
+          for (i = 0; i < CpLen; i++) {
+            Fnv ^= Cp[i];
+            Fnv *= 0x100000001b3ULL;
+            if ((c < (sizeof (Chk) / sizeof (Chk[0]))) && ((i + 1) == Chk[c])) {
+              FvMark ("[G3]");
+              FvHex ((UINT64)(i + 1));
+              FvHex (Fnv);
+              c++;
+            }
+          }
+
+          FvMark ("[G3]");
+          FvHex ((UINT64)CpLen);
+          FvHex (Fnv);
+        }
       }
 
       if (EFI_ERROR (Status)) {
