 #include "DxeMain.h"
 
+#include <Library/SerialPortLib.h>   // y700-elden debug instrumentation
+
+//
+// 2026-11-04 y700-elden 调试插桩：屏上串口步进痕迹。
+// SerialPortLib 在本平台已映射到 FrameBufferSerialPortLib（屏上输出），
+// 这里直接调用它，不依赖 DEBUG()（RELEASE 构建 PcdDebugPropertyMask=0 会整段编译掉）。
+//
+VOID
+SbMark (
+  IN CONST CHAR8  *Tag
+  )
+{
+  CHAR8  Buf[32];
+  UINTN  Len;
+
+  for (Len = 0; Tag[Len] != 0 && Len < 8; Len++) {
+    Buf[Len] = Tag[Len];
+  }
+
+  Buf[Len++] = '\n';
+  Buf[Len++] = '\r';
+  SerialPortWrite ((UINT8 *)Buf, Len);
+}
+
