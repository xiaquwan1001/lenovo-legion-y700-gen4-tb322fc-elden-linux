+/* ---------------- y700-elden debug instrumentation ---------------- */
+STATIC VOID SbTag (IN CONST CHAR8 *Tag)
+{
+  CHAR8  Buf[16];
+  UINTN  Len;
+
+  for (Len = 0; Tag[Len] != 0 && Len < 12; Len++) {
+    Buf[Len] = Tag[Len];
+  }
+
+  Buf[Len++] = '\n';
+  Buf[Len++] = '\r';
+  SerialPortWrite ((UINT8 *)Buf, Len);
+}
+
+STATIC VOID SbHex (IN UINT64 Value)
+{
+  STATIC CONST CHAR8  Hex[] = "0123456789ABCDEF";
+  CHAR8               Buf[20];
+  UINTN               i;
+
+  Buf[0] = '0';
+  Buf[1] = 'x';
+  for (i = 0; i < 16; i++) {
+    Buf[2 + i] = Hex[(Value >> ((15 - i) * 4)) & 0xF];
+  }
+
+  Buf[18] = '\n';
+  Buf[19] = '\r';
+  SerialPortWrite ((UINT8 *)Buf, 20);
+}
+
+/* 每个 64 KiB 块一个 32 位 FNV-1a，8 个一行（共 8 行） */
+STATIC VOID SbBlocks (VOID)
+{
+  STATIC CONST CHAR8  Hex[] = "0123456789ABCDEF";
+  UINT8               *Fd = (UINT8 *)(UINTN)0xFF300000ULL;
+  CHAR8                Buf[80];
+  UINTN                Blk;
+  UINTN                Pos;
+
+  for (Blk = 0; Blk < 64; Blk++) {
+    UINT32  H = 0x811C9DC5u;
+    UINTN   i;
+    INTN    k;
+
+    for (i = 0; i < 0x10000; i++) {
+      H ^= Fd[Blk * 0x10000 + i];
+      H *= 0x01000193u;
+    }
+
+    if ((Blk % 8) == 0) {
+      Pos = 0;
+    }
+
+    for (k = 7; k >= 0; k--) {
+      Buf[Pos++] = Hex[(H >> (k * 4)) & 0xF];
+    }
+
+    Buf[Pos++] = ((Blk % 8) == 7) ? '\n' : ' ';
+    if ((Blk % 8) == 7) {
+      Buf[Pos++] = '\r';
+      SerialPortWrite ((UINT8 *)Buf, Pos);
+    }
+  }
+}
+/* ---------------------------------------------------------------- */
