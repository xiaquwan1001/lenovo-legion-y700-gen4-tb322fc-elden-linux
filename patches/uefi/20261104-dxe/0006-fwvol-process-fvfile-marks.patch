 #include <PrePi.h>
+#include <Library/SerialPortLib.h>   /* y700-elden debug marks */
+
+/* 2026-11-04 y700-elden 调试插桩：FV 解包/注册阶段痕迹 */
+
+STATIC
+VOID
+FvMark (
+  IN CONST CHAR8  *Tag
+  )
+{
+  CHAR8  Buf[16];
+  UINTN  Len;
+
+  for (Len = 0; Tag[Len] != 0 && Len < 12; Len++) {
+    Buf[Len] = Tag[Len];
+  }
+
+  Buf[Len++] = '\n';
+  Buf[Len++] = '\r';
+  SerialPortWrite ((UINT8 *)Buf, Len);
+}
+
+STATIC
+VOID
+FvHex (
+  IN UINT64  Value
+  )
+{
+  STATIC CONST CHAR8  Hex[] = "0123456789ABCDEF";
+  CHAR8               Buf[20];
+  UINTN               i;
+
+  Buf[0] = '0';
+  Buf[1] = 'x';
+  for (i = 0; i < 16; i++) {
+    Buf[2 + i] = Hex[(Value >> ((15 - i) * 4)) & 0xF];
+  }
+
+  Buf[18] = '\n';
+  Buf[19] = '\r';
+  SerialPortWrite ((UINT8 *)Buf, 20);
+}
+
