+/*
+  2026-11-04 y700-elden 调试插桩：对 DDR 中的 UEFI FD 算 FNV-1a64，
+  用来判断「FD 内容在什么时刻被改坏」。基址与 shim 的 UEFI_BASE 一致。
+*/
+#define SB_FD_BASE  0xFF300000ULL
+#define SB_FD_SIZE  0x00400000ULL
+
+STATIC
+VOID
+SbFnvFd (
+  IN CONST CHAR8  *Tag
+  )
+{
+  UINT8   *P   = (UINT8 *)(UINTN)SB_FD_BASE;
+  UINT64  Fnv = 0xcbf29ce484222325ULL;
+  UINTN   Idx;
+
+  for (Idx = 0; Idx < (UINTN)SB_FD_SIZE; Idx++) {
+    Fnv ^= P[Idx];
+    Fnv *= 0x100000001b3ULL;
+  }
+
+  SbMark (Tag);
+  SbHex (Fnv);
+}
