+/* 2026-11-04 y700-elden 调试插桩：屏上串口痕迹（定位 DxeCore 究竟有没有被调用） */
+#include <Library/SerialPortLib.h>
+
+STATIC
+VOID
+LbMark (
+  IN CONST CHAR8  *Tag
+  )
+{
+  CHAR8  Buf[16];
+  UINTN  Len;
+
+  for (Len = 0; Tag[Len] != 0 && Len < 12; Len++) {
+    Buf[Len] = Tag[Len];
+  }
+
+  Buf[Len++] = '\n';
+  Buf[Len++] = '\r';
+  SerialPortWrite ((UINT8 *)Buf, Len);
+}
+
+STATIC
+VOID
+LbHex (
+  IN UINT64  Value
+  )
+{
+  STATIC CONST CHAR8  Hex[] = "0123456789ABCDEF";
+  CHAR8               Buf[20];
+  UINTN               i;
+
+  Buf[0] = '0';
+  Buf[1] = 'x';
+  for (i = 0; i < 16; i++) {
+    Buf[2 + i] = Hex[(Value >> ((15 - i) * 4)) & 0xF];
+  }
+
+  Buf[18] = '\n';
+  Buf[19] = '\r';
+  SerialPortWrite ((UINT8 *)Buf, 20);
+}
+
