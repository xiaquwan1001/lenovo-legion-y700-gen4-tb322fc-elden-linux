@@ -35,6 +35,35 @@
 	/* Reserved */
 	.long 0
 
+/* DDR stage marks v0 */
+
+/* DDR 分级标记（2026-11-04 双通道）：stage 号写进三块 carveout 的第 stage 页（整页 0xFF），
+   复位后 Linux 侧读回 ⇒ 跨重启存活的「执行到第几步」。与 FB 色带互补：
+   FB 是实时肉眼通道（ABL 下次启动会清掉），DDR 是事后取证通道（但可能被 0xFF 污染抹掉）。 */
+#define BB_MARK_REG(base, stage)                          \
+	movz	x7, #((base) & 0xffff);                   \
+	movk	x7, #(((base) >> 16) & 0xffff), lsl #16;  \
+	movz	w8, #(stage);                             \
+	lsl	x8, x8, #12;                              \
+	add	x7, x7, x8;                               \
+	mov	x11, x7;                                  \
+	mov	x9, #-1;                                  \
+	mov	w10, #512;                                \
+1:	str	x9, [x7], #8;                            \
+	subs	w10, w10, #1;                             \
+	b.ne	1b;                                       \
+	mov	x7, x11;                                  \
+	mov	w10, #64;                                 \
+2:	dc	civac, x7;                                \
+	add	x7, x7, #64;                              \
+	subs	w10, w10, #1;                             \
+	b.ne	2b;                                       \
+	dsb	sy
+#define BB_MARK(stage)                                    \
+	BB_MARK_REG(0x84A00000, stage);                   \
+	BB_MARK_REG(0x9C300000, stage);                   \
+	BB_MARK_REG(0x89300000, stage)
+
 _Start:
 /* 屏幕里程碑（2026-11-04 第二版）：**色带**，不是整屏填充。
    实测（19:31）：DT 声明的 splash_region 是 0xFC800000/0x02B00000，但**只有前 ~1 MiB
@@ -72,6 +101,7 @@
 	movk	x19, #(((off) >> 16) & 0xffff), lsl #16;        \
