+// 2026-11-06R32: EB 之后的转储（用缓存的 BlkIo，不碰 gBS）。EB 段是 USB redriver 重初始化 +
+// I2C NACK 洪水所在（2026-11-06 末次上机 OCR 证据），恰恰是屏上必然被冲刷掉的一段。
+VOID
+SbDumpLogNoBs (
+  IN CONST CHAR8  *Tag
+  )
+{
+  UINT8  *Ring;
+  UINT8  *Rec;
+  UINTN   Len;
+  UINTN   HdrLen;
+  UINTN   RecLen;
+  CHAR8   Hdr[96];
+
+  Ring = AllocatePool (8192);
+  if (Ring == NULL) {
+    return;
+  }
+  Len    = SerialPortLogGet (Ring, 8192);
+  HdrLen = AsciiSPrint (Hdr, sizeof (Hdr), "SBLOG01 tag=%a len=%d\n--\n", Tag, Len);
+  RecLen = HdrLen + Len;
+  if (RecLen > (SB_LOG_WINDOW - 64)) {
+    RecLen = SB_LOG_WINDOW - 64;
+  }
+  Rec = AllocatePool (RecLen);
+  if (Rec != NULL) {
+    CopyMem (Rec, Hdr, HdrLen);
+    if (RecLen > HdrLen) {
+      CopyMem (Rec + HdrLen, Ring, RecLen - HdrLen);
+    }
+    (VOID)SbWriteLogWindowNoBs (Rec, (UINT32)RecLen);
+    FreePool (Rec);
+  }
+  FreePool (Ring);
+}
