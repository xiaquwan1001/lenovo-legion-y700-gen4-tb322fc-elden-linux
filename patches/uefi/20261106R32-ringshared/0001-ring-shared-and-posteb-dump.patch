 // （响应缓冲 256 B，十六进制翻倍，留前缀余量）。off/len 相对窗口基址（= 分区尾部 16 KiB）。
+//
+// 2026-11-06R32 教训：fastboot 传进来的 `Arg` **不保证只含参数** —— 实测它带着命令名/分隔符，
+// 于是「按字面剥 sbread 前缀」两种写法都被它绕过去了（两次上机都只看到 Invalid Parameter）。
+// 现在不再猜前缀：按 ':' 切段，取**尾部两个纯十六进制段**（倒数第一 = len，倒数第二 = off）。
+STATIC BOOLEAN
+SbIsHexSeg (
+  IN CONST CHAR8  *S,
+  IN UINTN         Len
+  )
+{
+  UINTN  i;
+
+  if ((S == NULL) || (Len == 0) || (Len > 15)) {
+    return FALSE;
+  }
+  for (i = 0; i < Len; i++) {
+    CHAR8  c = S[i];
+
+    if (!(((c >= '0') && (c <= '9')) || ((c >= 'a') && (c <= 'f')) || ((c >= 'A') && (c <= 'F')))) {
+      return FALSE;
+    }
+  }
+  return TRUE;
+}
