Subject: [PATCH] BdsDxe: 分区/SFS 普查 + 按 GPT 名 direct-locate ESP（修 flashed 形态 fs=1）

2026-11-09R63 y700-elden（对应 PITFALLS #571/#575）。

背景（现场事实）
  · 同一份固件：`fastboot boot` 起 `[K] esp blk=120 / fs=8 / ld=Success i=1`；
    写进 `boot_a` 后正常启动只剩 `[K] esp fs=1 / ld=Not Found i=0 / esp none`
    ⇒ 那 1 个 FAT 卷**不是**我们的 ESP（2026-11-09 Linux 侧复核：`/efi/EFI/BOOT/BOOTAA64.EFI`
    184 320 B 就在 sda18/eldenesp 上），是别的 FAT 分区被先绑出来。
  · R62（p61）的 `[K] esp fs2=` 在整份 8 MiB logfs 里 0 命中，而同世代 FD 的**内层 FV**
    （LZMA 解压后）确实含该字符串、反汇编也可见 `cmp x8,#1 / b.hi` 之后的打印路径
    ⇒ 必须用**入口无条件标记**把「代码在不在执行的二进制里」与「分支有没有走到」分开。

本补丁做两件事（fastboot 路径既有行为不变）
  1) 普查：`[K] pi n=` / `[K] pi <i>=<GPT 分区名>` / 每条 `[K] fs i= p= nm=`（SFS 卷 → 分区号/名）
     ⇒ 一发就能分辨「分区层压根没出来」与「分区在、FAT 没绑」。
  2) 兜底：按 GPT 分区名（eldenesp）定位 `PartitionInfo` 句柄 → `ConnectController(TRUE)`
     → 按分区 GUID 认回对应的 `SimpleFileSystem` 卷 → `LoadImage`，不依赖 ConnectAll 时序。

判据
  `[K] esp in v=R63`（入口）→ `[K] pi n=` / `[K] fs i=… nm=…` → `[K] espb name=1 conn=… n=…`
  → `[K] espb ld=Success` → ESP 上的 loader 跑起来。

--- a/MdeModulePkg/Universal/BdsDxe/BdsEntry.c
+++ b/MdeModulePkg/Universal/BdsDxe/BdsEntry.c
@@ -19,6 +19,7 @@
 #include <Protocol/SimpleFileSystem.h> // 2026-11-08R54 y700-elden
 #include <Protocol/BlockIo.h>          // 2026-11-08R54 y700-elden
 #include <Library/DevicePathLib.h>     // 2026-11-08R54 y700-elden
+#include <Protocol/PartitionInfo.h>     // 2026-11-09R63 y700-elden
 #include <Protocol/Cpu.h>          // 2026-11-06R18 y700-elden
 #include <Protocol/DebugSupport.h> // 2026-11-06R18 y700-elden
 // 2026-11-06R18 y700-elden: ArmPkg 的 DefaultExceptionHandlerLib.h 不在本模块 include 路径里，
@@ -844,6 +845,239 @@
   SerialPortWrite ((UINT8 *)Line, Len);
 }
 
+// 2026-11-09R63 y700-elden: 分区/SFS 普查 + 「按 GPT 名直接定位 ESP」兜底。
+//
+// 动机：flashed 形态（写 boot_a）下 `[K] esp fs=1`，而同一份件 `fastboot boot` 起是 `fs=8`
+// （PITFALLS #571）。日志里唯一的 Fat 装载后紧接着就是 `fs=1`，且 `ld=Not Found i=0`
+// ⇒ 那 1 个 FAT 卷**不是**我们的 ESP（ESP 上 \EFI\BOOT\BOOTAA64.EFI 确实在，Linux 侧
+// `/efi/EFI/BOOT/BOOTAA64.EFI` 184 320 B，2026-11-09 复核）。
+// 同机型第三方（retro98boy/mu_wide_platforms `lenovo-y700-gen4-addon`，2026-11-08/09）在 BDS
+// 阶段显式连接存储、逐 LUN 才扫分区。本函数先走更窄的一条：**按 GPT 分区名定位**，
+// 不依赖 SimpleFileSystem 枚举时序；同时把「固件到底看见哪些分区/哪些卷」打成判据行，
+// 一次上机就能分辨「分区层没出来」与「分区在、FAT 没绑」两种完全不同的原因。
+//
+// 判据行（全部在连接动作之后无条件打印）：
+//   [K] pi n=<PartitionInfo 句柄数>       / [K] pi <i>=<分区名>（最多 24 条）
+//   [K] fs i=<n> p=<分区号> nm=<分区名>   （每个 SimpleFileSystem 卷一条）
+//   [K] espb name=<0|1> conn=<Status> n=<匹配到的卷数>
+STATIC
+BOOLEAN
+R63DpPart (
+  IN  EFI_DEVICE_PATH_PROTOCOL  *Dp,
+  OUT UINT32                    *Num,
+  OUT EFI_GUID                  *Guid
+  )
+{
+  HARDDRIVE_DEVICE_PATH  *Hd;
+
+  while ((Dp != NULL) && (!IsDevicePathEnd (Dp))) {
+    if ((DevicePathType (Dp) == MEDIA_DEVICE_PATH) && (DevicePathSubType (Dp) == MEDIA_HARDDRIVE_DP)) {
+      Hd = (HARDDRIVE_DEVICE_PATH *)Dp;
+      if (Num != NULL) {
+        *Num = Hd->PartitionNumber;
+      }
+
+      if (Guid != NULL) {
+        if (Hd->SignatureType == SIGNATURE_TYPE_GUID) {
+          CopyMem (Guid, Hd->Signature, sizeof (EFI_GUID));
+        } else {
+          ZeroMem (Guid, sizeof (EFI_GUID));
+        }
+      }
+
+      return TRUE;
+    }
+
+    Dp = NextDevicePathNode (Dp);
+  }
+
+  return FALSE;
+}
+
+STATIC
+BOOLEAN
+R63NameEq (
+  IN CHAR16       *Name,
+  IN CONST CHAR8  *Want
+  )
+{
+  UINTN  I;
+  CHAR16 C;
+
+  for (I = 0; Want[I] != 0; I++) {
+    C = Name[I];
+    if (C == 0) {
+      return FALSE;
+    }
+
+    if ((C >= L'A') && (C <= L'Z')) {
+      C = (CHAR16)(C - L'A' + L'a');
+    }
+
+    if (C != (CHAR16)Want[I]) {
+      return FALSE;
+    }
+  }
+
+  return TRUE;
+}
+
+STATIC
+BOOLEAN
+R63EspByName (
+  OUT EFI_HANDLE  *SfsOut
+  )
+{
+  EFI_STATUS                   Status;
+  EFI_HANDLE                   *PiHandles;
+  EFI_HANDLE                   *FsHandles;
+  UINTN                        PiCount;
+  UINTN                        FsCount;
+  UINTN                        K;
+  UINTN                        J;
+  EFI_PARTITION_INFO_PROTOCOL  *Pi;
+  EFI_DEVICE_PATH_PROTOCOL     *Dp;
+  EFI_GUID                     EspGuid;
+  EFI_GUID                     Guid;
+  UINT32                       PartNum;
+  CHAR8                        Nm[20];
+  CHAR8                        Line[160];
+  UINTN                        Len;
+  UINTN                        N;
+  BOOLEAN                      HaveEsp;
+  EFI_HANDLE                   EspHandle;
+  UINTN                        Match;
+
+  *SfsOut   = NULL;
+  PiHandles = NULL;
+  PiCount   = 0;
+  HaveEsp   = FALSE;
+  EspHandle = NULL;
+  Match     = 0;
+  ZeroMem (&EspGuid, sizeof (EspGuid));
+
+  Status = gBS->LocateHandleBuffer (ByProtocol, &gEfiPartitionInfoProtocolGuid, NULL, &PiCount, &PiHandles);
+  if (EFI_ERROR (Status)) {
+    PiCount   = 0;
+    PiHandles = NULL;
+  }
+
+  Len = AsciiSPrint (Line, sizeof (Line), "[K] pi n=%d\n\r", (UINT32)PiCount);
+  SerialPortWrite ((UINT8 *)Line, Len);
+
+  // 全量扫一遍找 eldenesp（打印只取前 24 条，免得把环刷爆）
+  for (K = 0; K < PiCount; K++) {
+    Pi = NULL;
+    if (EFI_ERROR (gBS->HandleProtocol (PiHandles[K], &gEfiPartitionInfoProtocolGuid, (VOID **)&Pi)) || (Pi == NULL)) {
+      continue;
+    }
+
+    Nm[0] = 0;
+    N     = 0;
+    if (Pi->Type == PARTITION_TYPE_GPT) {
+      while ((N < 14) && (Pi->Info.Gpt.PartitionName[N] != 0)) {
+        Nm[N] = (CHAR8)Pi->Info.Gpt.PartitionName[N];
+        N++;
+      }
+
+      Nm[N] = 0;
+    }
+
+    if (K < 24) {
+      Len = AsciiSPrint (Line, sizeof (Line), "[K] pi %d=%a\n\r", (UINT32)K, Nm);
+      SerialPortWrite ((UINT8 *)Line, Len);
+    }
+
+    if ((!HaveEsp) && (Pi->Type == PARTITION_TYPE_GPT) && R63NameEq (Pi->Info.Gpt.PartitionName, "eldenesp")) {
+      HaveEsp   = TRUE;
+      EspHandle = PiHandles[K];
+      CopyMem (&EspGuid, &Pi->Info.Gpt.UniquePartitionGUID, sizeof (EFI_GUID));
+    }
+  }
+
+  // 每个 SimpleFileSystem 卷是谁（分区号 + 名字）—— 这一行直接回答「那 1 个卷是哪个」。
+  FsHandles = NULL;
+  FsCount   = 0;
+  Status    = gBS->LocateHandleBuffer (ByProtocol, &gEfiSimpleFileSystemProtocolGuid, NULL, &FsCount, &FsHandles);
+  if (!EFI_ERROR (Status)) {
+    for (J = 0; J < FsCount; J++) {
+      Nm[0]   = 0;
+      PartNum = 0;
+      ZeroMem (&Guid, sizeof (Guid));
+      Dp = DevicePathFromHandle (FsHandles[J]);
+      if (!R63DpPart (Dp, &PartNum, &Guid)) {
+        continue;
+      }
+
+      for (K = 0; K < PiCount; K++) {
+        EFI_GUID  Pg;
+        UINT32    Pn;
+
+        Dp = DevicePathFromHandle (PiHandles[K]);
+        if (!R63DpPart (Dp, &Pn, &Pg) || !CompareGuid (&Pg, &Guid)) {
+          continue;
+        }
+
+        Pi = NULL;
+        if (!EFI_ERROR (gBS->HandleProtocol (PiHandles[K], &gEfiPartitionInfoProtocolGuid, (VOID **)&Pi)) &&
+            (Pi != NULL) && (Pi->Type == PARTITION_TYPE_GPT)) {
+          N = 0;
+          while ((N < 14) && (Pi->Info.Gpt.PartitionName[N] != 0)) {
+            Nm[N] = (CHAR8)Pi->Info.Gpt.PartitionName[N];
+            N++;
+          }
+
+          Nm[N] = 0;
+        }
+
+        break;
+      }
+
+      Len = AsciiSPrint (Line, sizeof (Line), "[K] fs i=%d p=%d nm=%a\n\r", (UINT32)J, (UINT32)PartNum, Nm);
+      SerialPortWrite ((UINT8 *)Line, Len);
+    }
+
+    FreePool (FsHandles);
+  }
+
+  // 显式连接那个分区（Fat 就会挂出来），再按分区 GUID 认卷。
+  Status = EFI_NOT_FOUND;
+  if (HaveEsp && (EspHandle != NULL)) {
+    Status = gBS->ConnectController (EspHandle, NULL, NULL, TRUE);
+
+    FsHandles = NULL;
+    FsCount   = 0;
+    if (!EFI_ERROR (gBS->LocateHandleBuffer (ByProtocol, &gEfiSimpleFileSystemProtocolGuid, NULL, &FsCount, &FsHandles))) {
+      for (J = 0; J < FsCount; J++) {
+        ZeroMem (&Guid, sizeof (Guid));
+        Dp = DevicePathFromHandle (FsHandles[J]);
+        if (R63DpPart (Dp, &PartNum, &Guid) && CompareGuid (&Guid, &EspGuid)) {
+          *SfsOut = FsHandles[J];
+          Match++;
+        }
+      }
+
+      FreePool (FsHandles);
+    }
+  }
+
+  Len = AsciiSPrint (
+                       Line,
+                       sizeof (Line),
+                       "[K] espb name=%d conn=%r n=%d\n\r",
+                       HaveEsp ? 1 : 0,
+                       Status,
+                       (UINT32)Match
+                       );
+  SerialPortWrite ((UINT8 *)Line, Len);
+
+  if (PiHandles != NULL) {
+    FreePool (PiHandles);
+  }
+
+  return (BOOLEAN)(*SfsOut != NULL);
+}
+
 STATIC
 BOOLEAN
 R54TryEspBoot (
@@ -864,6 +1098,11 @@
   Path        = L"\\EFI\\BOOT\\BOOTAA64.EFI";
   Found       = FALSE;
   ImageHandle = NULL;
+
+  // 2026-11-09R63：入口无条件标记（判「补丁在不在执行的这份 BdsDxe 里」，PITFALLS #575）。
+  Len = AsciiSPrint (Line, sizeof (Line), "[K] esp in v=R63\n\r");
+  SerialPortWrite ((UINT8 *)Line, Len);
+
   // 2026-11-08R61 y700-elden: 先重挂异常处理器，再碰 ESP（见 R61HookException 注释）。
   R61HookException ();
 
@@ -958,6 +1197,25 @@
   }
 
   if (!Found) {
+    // 2026-11-09R63：枚举不到就走「按 GPT 名定位」兜底（不依赖 ConnectAll 时序）。
+    EFI_HANDLE  EspSfs;
+
+    EspSfs = NULL;
+    if (R63EspByName (&EspSfs)) {
+      Dp = FileDevicePath (EspSfs, Path);
+      if (Dp != NULL) {
+        Status = gBS->LoadImage (TRUE, gImageHandle, Dp, NULL, 0, &ImageHandle);
+        Len    = AsciiSPrint (Line, sizeof (Line), "[K] espb ld=%r\n\r", Status);
+        SerialPortWrite ((UINT8 *)Line, Len);
+        FreePool (Dp);
+        if (!EFI_ERROR (Status)) {
+          Found = TRUE;
+        }
+      }
+    }
+  }
+
+  if (!Found) {
     Len = AsciiSPrint (Line, sizeof (Line), "[K] esp none\n\r");
     SerialPortWrite ((UINT8 *)Line, Len);
     return FALSE;
