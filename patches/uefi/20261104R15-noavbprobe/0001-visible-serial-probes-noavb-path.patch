   MarkPtnActive (BootableSlot->Suffix);
 out:
   // 2026-11-04R14 y700-elden: RELEASE strips DEBUG(); show the slot-state decision.
-  AsciiPrint ("[V] slot0=%d st=%r\n\r", (INT32)BootableSlot->Suffix[0], Status);
+  // 2026-11-04R15: AsciiPrint is invisible (R7 把 ConOut 换 no-op)，改走 SerialPortWrite。
+  {
+    CHAR8  SbBuf[96];
+    UINTN  SbLen;
+    SbLen = AsciiSPrint (SbBuf, sizeof (SbBuf), "[V] slot0=%d st=%r\n\r",
+                         (INT32)BootableSlot->Suffix[0], Status);
+    SerialPortWrite ((UINT8 *)SbBuf, SbLen);
+  }
   if (Status != EFI_SUCCESS) {
     /* clear bootable slot */
     BootableSlot->Suffix[0] = '\0';
