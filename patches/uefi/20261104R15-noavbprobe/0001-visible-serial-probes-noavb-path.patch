diff --git a/Platforms/QcomModulePkg/Library/avb/VerifiedBoot.c b/Platforms/QcomModulePkg/Library/avb/VerifiedBoot.c
index f6a38c24..f8ed0e3c 100644
--- a/Platforms/QcomModulePkg/Library/avb/VerifiedBoot.c
+++ b/Platforms/QcomModulePkg/Library/avb/VerifiedBoot.c
@@ -68,6 +68,28 @@
 #include <Library/MenuKeysDetection.h>
 #include <Library/VerifiedBootMenu.h>
 #include <Library/LEOEMCertificate.h>
+#include <Library/SerialPortLib.h>  // 2026-11-04R15 y700-elden
+#include <Library/PrintLib.h>       // 2026-11-04R15 y700-elden
+
+// 2026-11-04R15 y700-elden: RELEASE 把 DEBUG() 编掉，而 R7 已把 gST->ConOut->OutputString
+// 换成 no-op（防空屏滚动二次异常），所以连 AsciiPrint 都不会出现在屏上。唯一可见通道
+// = SerialPortWrite（FrameBufferSerialPortLib 直接写帧缓冲），与 [I]/[E]/[L] 同一条路。
+STATIC
+VOID
+SbVProbe (
+  CONST CHAR8  *Fmt,
+  ...
+  )
+{
+  CHAR8    Buf[160];
+  UINTN    Len;
+  VA_LIST  Marker;
+
+  VA_START (Marker, Fmt);
+  Len = AsciiVSPrint (Buf, sizeof (Buf), Fmt, Marker);
+  VA_END (Marker);
+  SerialPortWrite ((UINT8 *)Buf, Len);
+}
 
 STATIC CONST CHAR8 *VerityMode = " androidboot.veritymode=";
 STATIC CONST CHAR8 *VerifiedState = " androidboot.verifiedbootstate=";
@@ -437,6 +459,7 @@ LoadBootImageNoAuth (BootInfo *Info, UINT32 *PageSize, BOOLEAN *FastbootPath)
 
     BootIntoRecovery = Info->BootIntoRecovery;
   }
+  SbVProbe ("[V] hdr=%r sz=%x bi=%d\n\r", Status, ImageHdrSize, Info->Images[0].ImageBuffer != NULL);
 
   Info->HeaderVersion = ((boot_img_hdr *)(ImageHdrBuffer))->header_version;
 
@@ -459,6 +482,7 @@ LoadBootImageNoAuth (BootInfo *Info, UINT32 *PageSize, BOOLEAN *FastbootPath)
   Status = CheckImageHeader (ImageHdrBuffer, ImageHdrSize,
                              VendorImageHdrBuffer, VendorImageHdrSize,
                              &ImageSizeActual, PageSize, BootIntoRecovery);
+  SbVProbe ("[V] chk=%r a=%x p=%d hv=%d\n\r", Status, ImageSizeActual, *PageSize, Info->HeaderVersion);
   if (Status != EFI_SUCCESS) {
     DEBUG ((EFI_D_ERROR, "Invalid boot image header:%r\n", Status));
     goto Err;
@@ -467,6 +491,7 @@ LoadBootImageNoAuth (BootInfo *Info, UINT32 *PageSize, BOOLEAN *FastbootPath)
   if (!BootImageLoaded) {
     Status = LoadImage (Info->Pname, (VOID **)&(Info->Images[0].ImageBuffer),
                         ImageSizeActual, *PageSize);
+    SbVProbe ("[V] pld=%r\n\r", Status);
     if (Status != EFI_SUCCESS) {
       DEBUG ((EFI_D_ERROR, "ERROR: Failed to load image from partition: %r\n",
               Status));
@@ -486,6 +511,7 @@ LoadBootImageNoAuth (BootInfo *Info, UINT32 *PageSize, BOOLEAN *FastbootPath)
 
   if (Info->HeaderVersion >= BOOT_HEADER_VERSION_THREE) {
     Status = NoAVBLoadVendorBootImage (Info);
+    SbVProbe ("[V] vbi=%r\n\r", Status);
     if (Status != EFI_SUCCESS) {
         DEBUG ((EFI_D_ERROR,
                "ERROR: Failed to load vendor_boot Image : %r\n", Status));
@@ -533,6 +559,7 @@ LoadImageNoAuth (BootInfo *Info)
   BOOLEAN FastbootPath;
 
   Status = LoadBootImageNoAuth (Info, &PageSize, &FastbootPath);
+  SbVProbe ("[V] na=%r i=%d\n\r", Status, Info->NumLoadedImages);
   if (Status != EFI_SUCCESS) {
     return Status;
   }
@@ -564,6 +591,7 @@ LoadImageNoAuth (BootInfo *Info)
     ++(*ImgIdx);
   }
 
+  SbVProbe ("[V] dt=%r i=%d\n\r", Status, *ImgIdx);
   return EFI_SUCCESS;
 
 Err:
@@ -622,6 +650,7 @@ LoadImageNoAuthWrapper (BootInfo *Info)
     }
   }
 
+  SbVProbe ("[V] wr=%r\n\r", Status);
   return Status;
 }
 
@@ -1677,6 +1706,8 @@ LoadImageAndAuth (BootInfo *Info)
     return EFI_INVALID_PARAMETER;
   }
 
+  SbVProbe ("[V] ms=%d rec=%d\n\r", Info->MultiSlotBoot, Info->BootIntoRecovery);
+
   /* Get Partition Name*/
   if (!Info->MultiSlotBoot) {
     if (Info->BootIntoRecovery) {
@@ -1732,7 +1763,7 @@ LoadImageAndAuth (BootInfo *Info)
   // 2026-11-04R14 y700-elden: RELEASE strips DEBUG(); print the two values that
   // decide whether a verification error is tolerated.  AsciiPrint = UefiLib (already
   // linked into LinuxLoader); SerialPortLib/PrintLib are not.
-  AsciiPrint ("[V] avb=%d unl=%d\n\r", AVBVersion, IsUnlocked ());
+  SbVProbe ("[V] avb=%d unl=%d\n\r", AVBVersion, IsUnlocked ());
 
   /* Load and Authenticate */
   switch (AVBVersion) {
@@ -1752,6 +1783,7 @@ LoadImageAndAuth (BootInfo *Info)
     DEBUG ((EFI_D_ERROR, "Unsupported AVB version %d\n", AVBVersion));
     Status = EFI_UNSUPPORTED;
   }
+  SbVProbe ("[V] sw=%r v=%d\n\r", Status, AVBVersion);
 
   // if MDTP is active Display Recovery UI
   if (Status != EFI_SUCCESS && MdtpActive) {
