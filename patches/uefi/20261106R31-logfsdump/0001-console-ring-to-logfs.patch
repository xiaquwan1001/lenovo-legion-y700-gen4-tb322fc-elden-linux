+// 2026-11-06R31 y700-elden: `oem sbread:<off>:<len>` —— 从 `logfs` 尾部诊断窗口读回十六进制。
+// 目的：让「屏上日志 → logfs」这条链**自证**，不依赖设备能否起 Linux。len 默认 64，上限 96
+// （响应缓冲 256 B，十六进制翻倍，留前缀余量）。off/len 相对窗口基址（= 分区尾部 16 KiB）。
+STATIC VOID
+CmdOemSbRead (IN CONST CHAR8 *Arg, IN VOID *Data, IN UINT32 Size)
+{
+  EFI_STATUS  Status;
+  UINT8       Buf[96];
+  CHAR8       Resp[256];
+  UINT32      Offset;
+  UINT32      Len;
+  UINT32      i;
+  UINTN       Pos;
+
+  Offset = 0;
+  Len    = 64;
+  if (Arg != NULL) {
+    CONST CHAR8  *P = Arg;
+
+    // 命令表已吃掉 "oem sbread"，剩下的形如 ":<off>:<len>"、":<off>" 或 "<off>:<len>"。
+    while (*P == ':') {
+      P++;
+    }
+    if (*P != '\0') {
+      Offset = (UINT32)AsciiStrHexToUintn (P);
+      P      = AsciiStrStr (P, ":");
+      if (P != NULL) {
+        while (*P == ':') {
+          P++;
+        }
+        if (*P != '\0') {
+          Len = (UINT32)AsciiStrHexToUintn (P);
+        }
+      }
+    }
+  }
+  if ((Len == 0) || (Len > sizeof (Buf))) {
+    FastbootFail ("sbread: len out of range");
+    return;
+  }
+
+  Status = SbReadLogWindow (Offset, Buf, Len);
+  if (EFI_ERROR (Status)) {
+    AsciiSPrint (Resp, sizeof (Resp), "sbread st=%r", Status);
+    FastbootFail (Resp);
+    return;
+  }
+
+  Pos = AsciiSPrint (Resp, sizeof (Resp), "sb o=%x l=%x ", Offset, Len);
+  for (i = 0; (i < Len) && ((Pos + 2) < sizeof (Resp)); i++) {
+    Pos += AsciiSPrint (Resp + Pos, sizeof (Resp) - Pos, "%02x", Buf[i]);
+  }
+  FastbootOkay (Resp);
+}
