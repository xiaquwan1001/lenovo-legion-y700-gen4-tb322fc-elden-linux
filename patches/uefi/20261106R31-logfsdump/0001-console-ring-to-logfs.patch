 STATIC UINTN  m_TextRows = 0;   // 预算内可用**文字行**数 = m_FbRows/(FONT_HEIGHT*SCALE_FACTOR)
 STATIC UINTN  m_TextCols = 0;   // 每行字符数 = gWidth/((FONT_WIDTH+1)*SCALE_FACTOR)
 
+// 2026-11-06R31 y700-elden: 控制台**环形日志**。屏上输出会被后续内容冲掉、EB 之后面板还会被熄，
+// 屏是唯一会“滚走”的证据源。这里把每一条屏上写都抄一份到 RAM 环（最多 8 KiB），
+// 再由 BootLinux 把它写到 `logfs` 分区尾部 16 KiB（持久化：重启/掉电后仍在，Linux 里 dd 即可读）。
+#define SB_LOG_CAP  8192
+STATIC UINT8  m_SbLogRing[SB_LOG_CAP];
+STATIC UINTN  m_SbLogHead  = 0;   // 下一个写入位置
+STATIC UINTN  m_SbLogTotal = 0;   // 累计写入字节数（封顶）
+
+STATIC VOID
+SbLogPut (
+  UINT8  c
+  )
+{
+  m_SbLogRing[m_SbLogHead] = c;
+  m_SbLogHead = (m_SbLogHead + 1) % SB_LOG_CAP;
+  if (m_SbLogTotal < 0x7FFFFFFF) {
+    m_SbLogTotal++;
+  }
+}
+
+// 导出：把环里最近的 min(累计, Cap, Max) 字节按时间顺序拷出，返回字节数。
+UINTN
+EFIAPI
+SerialPortLogGet (
+  OUT UINT8  *Buf,
+  IN  UINTN   Max
+  )
+{
+  UINTN  n, start, i;
+
+  if ((Buf == NULL) || (Max == 0)) {
+    return 0;
+  }
+  n = (m_SbLogTotal < SB_LOG_CAP) ? m_SbLogTotal : SB_LOG_CAP;
+  if (n > Max) {
+    n = Max;
+  }
+  start = (m_SbLogHead + SB_LOG_CAP - n) % SB_LOG_CAP;
+  for (i = 0; i < n; i++) {
+    Buf[i] = m_SbLogRing[(start + i) % SB_LOG_CAP];
+  }
+  return n;
+}
