+// 2026-11-06R31 y700-elden: 持久化诊断日志的读/写（`logfs` 分区尾部 SB_LOG_WINDOW 字节窗口）。
+// 布局：窗口基址 = (LastBlock + 1) * BlockSize - SB_LOG_WINDOW，与写入时一致。
+STATIC EFI_STATUS
+SbLogWindowBlkIo (
+  OUT EFI_BLOCK_IO_PROTOCOL  **BlkIoOut
+  )
+{
+  EFI_STATUS        Status;
+  PartiSelectFilter HandleFilter;
+  HandleInfo        HandleInfoList[1];
+  UINT32            MaxHandles;
+  UINT32            BlkIOAttrib;
+
+  BlkIOAttrib  = BLK_IO_SEL_PARTITIONED_GPT;
+  BlkIOAttrib |= BLK_IO_SEL_MEDIA_TYPE_NON_REMOVABLE;
+  BlkIOAttrib |= BLK_IO_SEL_MATCH_PARTITION_TYPE_GUID;
+
+  HandleFilter.RootDeviceType = NULL;
+  HandleFilter.PartitionType  = (EFI_GUID *)&gEfiLogFSPartitionGuid;
+  HandleFilter.VolumeName     = NULL;
+
+  MaxHandles = ARRAY_SIZE (HandleInfoList);
+  Status     = GetBlkIOHandles (BlkIOAttrib, &HandleFilter, HandleInfoList, &MaxHandles);
+  if (EFI_ERROR (Status) || (MaxHandles != 1)) {
+    return EFI_NOT_FOUND;
+  }
+  *BlkIoOut = HandleInfoList[0].BlkIo;
+  return EFI_SUCCESS;
+}
+
+EFI_STATUS
+SbWriteLogWindow (
+  IN VOID    *Msg,
+  IN UINT32   MsgSize
+  )
+{
+  EFI_STATUS             Status;
+  EFI_BLOCK_IO_PROTOCOL  *BlkIo;
+  UINTN                 BlockSize;
+  UINT64                 Base;
+  UINT8                 *Buf;
+
+  if ((Msg == NULL) || (MsgSize == 0) || (MsgSize > SB_LOG_WINDOW)) {
+    return EFI_INVALID_PARAMETER;
+  }
+  Status = SbLogWindowBlkIo (&BlkIo);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+  BlockSize = BlkIo->Media->BlockSize;
+  if ((BlockSize == 0) || (((UINT64)BlkIo->Media->LastBlock + 1) * BlockSize <= SB_LOG_WINDOW)) {
+    return EFI_UNSUPPORTED;
+  }
+  Base = ((UINT64)BlkIo->Media->LastBlock + 1) * BlockSize - SB_LOG_WINDOW;
+
+  Buf = AllocatePool (SB_LOG_WINDOW);
+  if (Buf == NULL) {
+    return EFI_OUT_OF_RESOURCES;
+  }
+  ZeroMem (Buf, SB_LOG_WINDOW);
+  CopyMem (Buf, Msg, MsgSize);
+  Status = BlkIo->WriteBlocks (BlkIo, BlkIo->Media->MediaId, Base, SB_LOG_WINDOW, Buf);
+  FreePool (Buf);
+  return Status;
+}
+
+EFI_STATUS
+SbReadLogWindow (
+  IN UINT32   Offset,
+  OUT VOID   *Buf,
+  IN UINT32   Len
+  )
+{
+  EFI_STATUS             Status;
+  EFI_BLOCK_IO_PROTOCOL  *BlkIo;
+  UINTN                 BlockSize;
+  UINT64                 Base;
+
+  if ((Buf == NULL) || (Len == 0) || ((Offset + Len) > SB_LOG_WINDOW)) {
+    return EFI_INVALID_PARAMETER;
+  }
+  Status = SbLogWindowBlkIo (&BlkIo);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+  BlockSize = BlkIo->Media->BlockSize;
+  Base      = ((UINT64)BlkIo->Media->LastBlock + 1) * BlockSize - SB_LOG_WINDOW;
+
+  // 2026-11-06R31: ReadBlocks 的 BufferSize 必须是块大小的整数倍（实测非整倍返回
+  // EFI_BAD_BUFFER_SIZE）。按块对齐读进 bounce buffer，再拷出调用方要的那段。
+  {
+    UINT32  AlignedOff;
+    UINT32  AlignedLen;
+    UINT8  *Tmp;
+
+    AlignedOff = Offset & ~(UINT32)(BlockSize - 1);
+    AlignedLen = (Offset + Len + (UINT32)BlockSize - 1) & ~(UINT32)(BlockSize - 1);
+    if (AlignedLen > SB_LOG_WINDOW) {
+      AlignedLen = SB_LOG_WINDOW;
+    }
+    Tmp = AllocatePool (AlignedLen);
+    if (Tmp == NULL) {
+      return EFI_OUT_OF_RESOURCES;
+    }
+    Status = BlkIo->ReadBlocks (BlkIo, BlkIo->Media->MediaId, Base + AlignedOff, AlignedLen, Tmp);
+    if (!EFI_ERROR (Status)) {
+      CopyMem (Buf, Tmp + (Offset - AlignedOff), Len);
+    }
+    FreePool (Tmp);
+    return Status;
+  }
+}
