 #include <Library/MemoryMapHelperLib.h>
 
+// 2026-11-06R31 y700-elden: 屏上日志的持久化转储。
+// 背景：屏是唯一“会滑走”的通道 —— p31–p33 三代都是好不容易打印出来但被后续内容冲掉；
+// EB 之后面板直接被驱动退出流程熄掉（PITFALLS #531）。NV 变量在本机又不跨上电保留（#511）。
+// 因此把控制台环形日志（FrameBufferSerialPortLib 维护）写到 `logfs` 分区尾部 16 KiB：
+// 磁盘上的东西重启/掉电后都在，Linux 里 `dd if=/dev/disk/by-partlabel/logfs …` 就能读到。
+UINTN  EFIAPI SerialPortLogGet (OUT UINT8 *Buf, IN UINTN Max);
+
+// 记录格式（纯 ASCII，可直接 strings 读）：
+//   SBLOG01 tag=<entry|preeb> len=<n>\n--\n<最近 n 字节的屏上输出>
+VOID
+SbDumpLog (
+  IN CONST CHAR8  *Tag
+  )
+{
+  UINT8  *Ring;
+  UINT8  *Rec;
+  UINTN   Cap;
+  UINTN   Len;
+  UINTN   HdrLen;
+  UINTN   RecLen;
+  CHAR8   Hdr[96];
+
+  Cap = 8192;
+  Ring = AllocatePool (Cap);
+  if (Ring == NULL) {
+    return;
+  }
+  Len = SerialPortLogGet (Ring, Cap);
+
+  HdrLen = AsciiSPrint (Hdr, sizeof (Hdr), "SBLOG01 tag=%a len=%d\n--\n", Tag, Len);
+  RecLen = HdrLen + Len;
+  if (RecLen > (SB_LOG_WINDOW - 64)) {
+    RecLen = SB_LOG_WINDOW - 64;
+  }
+
+  Rec = AllocatePool (RecLen);
+  if (Rec != NULL) {
+    CopyMem (Rec, Hdr, HdrLen);
+    if (RecLen > HdrLen) {
+      CopyMem (Rec + HdrLen, Ring, RecLen - HdrLen);
+    }
+    (VOID)SbWriteLogWindow (Rec, (UINT32)RecLen);
+    FreePool (Rec);
+  }
+  FreePool (Ring);
+}
