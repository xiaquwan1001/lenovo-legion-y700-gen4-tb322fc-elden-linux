   Timeout = (UINT64)mLMenuTimeout;
-  while (Timeout > 0) {
+  /* 2026-11-10R73 y700-elden: 循环条件**不能**用 Timeout —— 按键后把 Timeout 置 0 会让 while 立刻退出，
+   * 随即按当时高亮项启动（2026-11-10 上机实证：按音量键 → 标题变 autoboot cancelled → 一下进系统）。
+   * 改为常真循环：超时只在**没有按键**时生效；按键之后必须按 Power（SCAN_SUSPEND）确认才启动。 */
+  while (TRUE) {
     UINT32 Key = LMenuKey ();
 
-    if (Key != SCAN_NULL) {
+    if ((Key != SCAN_NULL) && (Key != Last)) {
+      LLog ("[L] menu key", (UINT64)Key);
       if (!Keyed) {
         /* 第一次按键 ⇒ 关掉自动启动（此后只在按确认键时启动） */
         Keyed   = TRUE;
@@ -620,27 +624,30 @@
                      "Boot menu   (Vol +/- move, Power = OK, autoboot cancelled)");
         LMenuDrawRow (0, Title2, BGR_BLACK, COMMON);
       }
-    }
-    if (Key != Last) {
-      if (Key != SCAN_NULL) {
-        LLog ("[L] menu key", (UINT64)Key);
-        if (Key == SCAN_DOWN) {
-          Sel = (Sel + 1) % mLMenuCount;
-          LMenuDrawSelect (Sel);
-        } else if (Key == SCAN_UP) {
-          Sel = (Sel + mLMenuCount - 1) % mLMenuCount;
-          LMenuDrawSelect (Sel);
-        } else if (Key == SCAN_SUSPEND) {
-          Last = Key;
-          break;
-        }
-        AsciiSPrint (Line, sizeof (Line) - 1, "[L] menu sel %d", (UINT32)Sel);
-        LLog (Line, MAX_UINT64);
+      if (Key == SCAN_DOWN) {
+        Sel = (Sel + 1) % mLMenuCount;
+        LMenuDrawSelect (Sel);
+      } else if (Key == SCAN_UP) {
+        Sel = (Sel + mLMenuCount - 1) % mLMenuCount;
+        LMenuDrawSelect (Sel);
+      } else if (Key == SCAN_SUSPEND) {
+        LLog ("[L] menu confirm", MAX_UINT64);
