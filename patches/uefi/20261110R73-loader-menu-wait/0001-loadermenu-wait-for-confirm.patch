+      AsciiSPrint (Line, sizeof (Line) - 1, "[L] menu sel %d", (UINT32)Sel);
+      LLog (Line, MAX_UINT64);
       Last = Key;
+    } else if (Key == SCAN_NULL) {
+      Last = SCAN_NULL;
     }
-    /* 未按键时每秒重画一次标题上的剩余秒数（原实现只在开局画一次，看不出在走） */
-    if (!Keyed || (Timeout > 0)) {
+
+    if (!Keyed) {
+      if (Timeout == 0) {
+        /* menu.cfg 没给 #timeout ⇒ 保持旧行为：零等待取第 0 项 */
+        Sel = 0;
+        break;
+      }
+      /* 未按键时每秒重画一次标题上的剩余秒数（原实现只在开局画一次，看不出在走） */
       Elapsed = (GetTimerCountms () - Start) / 1000;
       if (Elapsed != Tick) {
         Tick = Elapsed;
