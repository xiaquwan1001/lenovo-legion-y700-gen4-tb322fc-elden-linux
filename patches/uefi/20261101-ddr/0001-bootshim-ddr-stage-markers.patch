diff --git a/BootShim/BootShim.S b/BootShim/BootShim.S
index 76dcb4f9..31f9bb8b 100644
--- a/BootShim/BootShim.S
+++ b/BootShim/BootShim.S
@@ -34,6 +34,29 @@ _StackSize:
 	.long 0
 
 _Start:
+/* ---- DDR 黑匣子 stage 标记（2026-11-01，--shim ddrmarks）----
+   单调编码：整页填 0xFF = 「到过该 stage」，读侧按 popcount>=6 字节占比判
+   （本机 DDR 复位后约 26-32% 字节只发生 1->0 翻转，见 reports/uefi-ddr-blackbox-20261101.md）。
+   落回 Android 时只有这两块 carveout 实测「不被 Android 踩」（13:37 对照）：
+     0xFEF00000  splash_region 尾部  0x89300000  dsm-partition-2
+   stage 页号：1=shim 入口 2=FD 拷完 4=即将跳入 FD。
+   注意：先写 splash 尾部，因为写 oem-vm(0xF7D00000) 会立刻复位（疑似受 Gunyah 保护）。 */
+#define BB_MARK_REG(base, stage)                          \
+	movz	x7, #((base) & 0xffff);                   \
+	movk	x7, #(((base) >> 16) & 0xffff), lsl #16;  \
+	movz	w8, #(stage);                             \
+	lsl	x8, x8, #12;                              \
+	add	x7, x7, x8;                               \
+	mov	x9, #-1;                                  \
+	mov	w10, #512;                                \
+1:	str	x9, [x7], #8;                            \
+	subs	w10, w10, #1;                             \
+	b.ne	1b
+#define BB_MARK(stage)                                    \
+	BB_MARK_REG(0xFEF00000, stage);                   \
+	BB_MARK_REG(0x89300000, stage)
+
+	BB_MARK(1)
 	mov		x4, x1
 	ldr		x5, _StackBase
 	cmp		x4, x5
@@ -45,9 +68,31 @@ _CopyLoop:
 	stp		x2, x3, [x5], #16
 	subs	x6, x6, #16
 	b.ne	_CopyLoop
+	BB_MARK(2)
+
+/*
+ * Cache maintenance before executing the copied image:
+ * the stp loop above may leave dirty D-cache lines at the destination
+ * (UEFI_BASE..UEFI_BASE+UEFI_SIZE) if XBL entered with the D-cache
+ * enabled. Clean+invalidate them to PoC so DRAM holds the payload,
+ * then invalidate the whole I-cache so no stale instructions are
+ * fetched at the new entry point.
+ */
 	ldr		x5, _StackBase
+	ldr		x6, _StackSize
+_CivacLoop:
+	dc		civac, x5
+	add		x5, x5, #64
+	subs	x6, x6, #64
+	b.ne	_CivacLoop
+	dsb		sy
+	ic		iallu
+	dsb		sy
+	isb
 
 _Entry:
+	BB_MARK(4)
+	ldr		x5, _StackBase
 	br		x5
 
 _Dead:
