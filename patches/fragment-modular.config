# fragment-modular.config — 迭代快环：把「载荷驱动」从 =y 翻成 =m
#
# 目的：让这些驱动的改动不再需要重编内核+重做 boot 镜像+重启，
#       而是 `scripts/mod-loop.sh <dir>` = 编模块 → 推设备 → rmmod/modprobe（~30s）。
#
# 已实测（2026-10-04，merge_config + olddefconfig 冒烟）全部干净翻成 =m，
# 无 bool 子项把父项拉回 =y；模块数 1319 → 1355。
#
# 用法（一次性，之后驱动改动走 mod-loop）：
#   FRAG=patches/fragment-modular.config SNAP=patches/config-vk-modular \
#     bash scripts/apply-kernel-fragment.sh
#   scripts/build-kernel.sh full && scripts/build-boot.sh
#
# 注意：
#  * 音频（QDSP6/WCD939X/SC8280XP）与 ATH12K 在启动早期就需要，
#    模块须随持久根 /lib/modules 在 init 里加载（camera-modules-load.sh 同机制）。
#  * BT：不用改源码也能模块化。hci_qca.c 不是独立驱动，它是 hci_uart.ko 的
#    协议实现（`drivers/bluetooth/Makefile: hci_uart-$(CONFIG_BT_HCIUART_QCA) += hci_qca.o`）。
#    所以正确切法是 `BT_HCIUART=m`（hci_uart.ko 连同 h4/qca 协议一起成为模块），
#    `BT_HCIUART_QCA` 保持 bool=y（父项是 m 时 bool 子项仍可为 y，并入该模块）。
#    副作用可接受：`select BT_QCA` 会把 helper 库 `btqca.o` 钉成 =y（内置，
#    5 个 EXPORT_SYMBOL_GPL 供 hci_uart.ko 用）。
#    热改 hci_qca.c = `scripts/mod-loop.sh drivers/bluetooth --reload hci_uart`，
#    前提是先 `rfkill block bluetooth` + 停 bluetoothd（否则 rmmod 忙）。
#    2026-10-26 已在 7.3 日常树（build/vk151）翻 =m 并上机验证（vk163）。
#  * 显示（DRM_MSM/panel）不放这里 —— 见 fragment-modular-video.config，
#    分开评估，因为它会牺牲启动早期的显示输出。

CONFIG_SND_SOC_QDSP6=m
CONFIG_SND_SOC_SC8280XP=m
CONFIG_SND_SOC_WCD939X=m
CONFIG_SND_SOC_WCD939X_SDW=m
CONFIG_SND_SOC_WCD_COMMON=m
CONFIG_SND_SOC_WCD_CLASSH=m
CONFIG_SND_SOC_WCD_MBHC=m

CONFIG_ATH12K=m
# PITFALLS #125：ATH12K=m 会经 `select PCI_PWRCTRL_PWRSEQ` 把 PCIe 电源序列驱动降为 =m；
# 该驱动必须在 PCIe host probe 之前就绪，=m 且未随 initramfs 早加载 ⇒ PCIe/WCN 起不来、
# wifi 全无（2026-10-10 vk89 实测复现：无 wlan0、lspci 空、payload 里无 pwrseq 模块）。
# 故**显式钉回 =y**（不要删）。
CONFIG_PCI_PWRCTRL_PWRSEQ=y

# --- Bluetooth（含 hci_qca 协议；见文件头说明） ---
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_QCA=y

CONFIG_INPUT_AW86927=m
CONFIG_TOUCHSCREEN_NOVATEK_NVT36XXX_SPI=m
CONFIG_BACKLIGHT_AW99706=m

# 相机已是 =m（仅登记，无需改动）
# CONFIG_VIDEO_QCOM_CAMSS=m / CONFIG_I2C_QCOM_CCI=m / CONFIG_VIDEO_S5KJNS=m ...
