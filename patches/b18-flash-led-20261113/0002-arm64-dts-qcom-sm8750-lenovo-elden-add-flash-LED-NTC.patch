From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Qianhui Xu <xiaqinghuan@mail.ustc.edu.cn>
Date: Fri, 13 Nov 2026 12:00:00 +0800
Subject: [PATCH 2/2] arm64: dts: qcom: sm8750-lenovo-elden: add flash LED NTC
 thermal zone

The stock firmware has a dedicated NTC next to the flash LED: pmk8550
VADC channel sid 1 / AMUX2 (0x145, 100k pull-up), and a "flash-led-ntc"
thermal zone that the stock thermal HAL watches.  The mainline board
file exposes neither, so the NTC is not readable and long-flash thermal
behaviour cannot be observed (upstream leds-qcom-flash keeps its own
real-time derating from the PMIC THERM_THRSH/STATUS registers, so this
zone is for monitoring only, not for safety).

Add the VADC channel and a monitoring-only thermal zone (passive trip at
the stock 125 C).  The zone node name must match the thermal-zones
schema pattern (<= 10 chars + "-thermal"), so it is "flash-ntc-thermal"
rather than the stock "flash-led-ntc".

Gate: CHECK_DTBS=y qcom/sm8750-lenovo-elden.dtb: 0 diagnostics (with
CONFIG_QCOM_SPMI_ADC5 enabled).  On-device readback still pending (the
0x145 sid mapping is copied from stock and unverified).

Signed-off-by: Qianhui Xu <xiaqinghuan@mail.ustc.edu.cn>
---
--- a/arch/arm64/boot/dts/qcom/sm8750-lenovo-elden.dts
+++ b/arch/arm64/boot/dts/qcom/sm8750-lenovo-elden.dts
@@ -26,6 +26,27 @@
 
 	/* Stock CPU/GPU thermal HAL junction limit: 105 C, 5 C hysteresis. */
 	thermal-zones {
+		/*
+		 * Stock has a dedicated NTC next to the flash LED (pmk8550 VADC
+		 * AMUX2, pre-scaled 100k pull-up).  Upstream leds-qcom-flash does
+		 * its own real-time derating from the PMIC THERM_THRSH/STATUS
+		 * registers, so this zone is for monitoring only, not for safety.
+		 */
+		flash-ntc-thermal {
+			polling-delay-passive = <0>;
+			polling-delay = <0>;
+
+			thermal-sensors = <&pmk8550_vadc 0x145>;
+
+			trips {
+				flash_led_ntc_passive: trip-passive {
+					temperature = <125000>;
+					hysteresis = <1000>;
+					type = "passive";
+				};
+			};
+		};
+
 		/*
 		 * Graded passive cooling (recalibrated 2026-10-02).
 		 * State == cpufreq/devfreq cdev level (higher = lower freq).
@@ -3176,3 +3197,14 @@
 		qcom,tx-port-mapping = <2 2 3 4>;
 	};
 };
+
+&pmk8550_vadc {
+	/* Flash LED NTC, same channel (sid 1 / AMUX2 100k PU) the stock DTS uses. */
+	channel@145 {
+		reg = <0x145>;
+		label = "pm8550_flash_led_ntc";
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+		qcom,pre-scaling = <1 1>;
+	};
+};
