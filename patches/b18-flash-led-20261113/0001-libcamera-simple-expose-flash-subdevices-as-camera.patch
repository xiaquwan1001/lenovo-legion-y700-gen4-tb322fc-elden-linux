+	/*
+	 * Merge the flash subdevices' V4L2 controls into the camera's control
+	 * set.  The IPA-installed controlInfo_ uses the core control id map;
+	 * rebuild it with a map that also contains the flash control ids (the
+	 * ControlId instances are owned by the flash subdevices, which live as
+	 * long as the pipeline handler).
+	 */
+	if (!flashDevices_.empty()) {
+		ControlInfoMap::Map ctrlMap;
+		for (const auto &[id, info] : controlInfo_) {
+			ctrlMap.emplace(id, info);
+			controlInfoIdMap_.emplace(id->id(), id);
+		}
+		for (V4L2Subdevice *sd : flashDevices_) {
+			for (const auto &[id, info] : sd->controls()) {
+				ctrlMap.emplace(id, info);
+				controlInfoIdMap_.emplace(id->id(), id);
+			}
+		}
+		controlInfo_ = ControlInfoMap(std::move(ctrlMap), controlInfoIdMap_);
+	}
+
 	video_ = pipe->video(entities_.back().entity);
