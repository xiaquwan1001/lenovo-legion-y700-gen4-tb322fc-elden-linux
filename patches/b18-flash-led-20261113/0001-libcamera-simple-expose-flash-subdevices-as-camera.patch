+	/*
+	 * Bind flash/torch entities (MEDIA_ENT_F_FLASH) to each camera.  There
+	 * is no association between a flash subdevice and a sensor in the
+	 * media graph that libcamera could rely on, and boards with an actual
+	 * flash have a single rear camera, so attach every flash entity to
+	 * every camera.  The flash controls are merged into the camera's
+	 * control set in init().
+	 */
+	for (std::unique_ptr<SimpleCameraData> &data : pipelines) {
+		for (const auto &[entity, entityData] : entities_) {
+			if (entity->function() == MEDIA_ENT_F_FLASH && entityData.subdev)
+				data->addFlashDevice(entityData.subdev.get());
+		}
+	}
