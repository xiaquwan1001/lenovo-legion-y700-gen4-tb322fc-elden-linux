+/**
+ * \brief Attach a flash/torch subdevice to this camera
+ * \param[in] sd The V4L2 subdevice of a MEDIA_ENT_F_FLASH media entity
+ *
+ * The subdevice is owned by the pipeline handler and stays open for the
+ * lifetime of the camera.  Controls are merged into the camera's control set
+ * in init().
+ */
+void SimpleCameraData::addFlashDevice(V4L2Subdevice *sd)
+{
+	LOG(SimplePipeline, Debug)
+		<< "Binding flash device '" << sd->deviceNode() << "'";
+	flashDevices_.push_back(sd);
+}
+
+/**
+ * \brief Apply request controls that belong to the flash subdevices
+ * \param[in] controls The request's control list
+ *
+ * Returns the number of flash controls found, so the caller can filter them
+ * out before handing the remaining controls to the IPA.
+ */
+unsigned int SimpleCameraData::applyFlashControls(const ControlList &controls)
+{
+	unsigned int applied = 0;
+
+	for (const auto &[ctrlId, value] : controls) {
+		const auto itId = controlInfoIdMap_.find(ctrlId);
+		if (itId == controlInfoIdMap_.end())
+			continue;
+		const ControlId *cid = itId->second;
+
+		for (V4L2Subdevice *sd : flashDevices_) {
+			if (sd->controls().find(cid) == sd->controls().end())
+				continue;
+
+			ControlList flashCtrls(sd->controls());
+			flashCtrls.set(cid->id(), value);
+			int ret = sd->setControls(&flashCtrls);
+			if (ret)
+				LOG(SimplePipeline, Warning)
+					<< "Failed to set flash control "
+					<< cid->name() << ": " << strerror(-ret);
+			applied++;
+			break;
+		}
+	}
+
+	return applied;
+}
