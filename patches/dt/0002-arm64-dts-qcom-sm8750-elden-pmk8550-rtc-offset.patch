diff --git a/arch/arm64/boot/dts/qcom/sm8750-lenovo-elden.dts b/arch/arm64/boot/dts/qcom/sm8750-lenovo-elden.dts
index aa28614..a1c5f5c 100644
--- a/arch/arm64/boot/dts/qcom/sm8750-lenovo-elden.dts
+++ b/arch/arm64/boot/dts/qcom/sm8750-lenovo-elden.dts
@@ -2564,6 +2564,25 @@ &pmih0108_eusb2_repeater {
 	vdd3-supply = <&vreg_l5b_3p1>;
 };
 
+/* PMIC RTC.  The qcom offset lives in SDAM2 (the upstream pattern, cf.
+ * sc8280xp-crd.dts) so that setting the clock does not move the raw PMIC
+ * counter.  Without an offset cell (or "allow-set-time") rtc-pm8xxx's
+ * set_time() returns -ENODEV, and CONFIG_RTC_HCTOSYS then restores the
+ * stale PMIC value (1970) on every boot.
+ */
+&pmk8550_rtc {
+	nvmem-cells = <&rtc_offset>;
+	nvmem-cell-names = "offset";
+
+	status = "okay";
+};
+
+&pmk8550_sdam_2 {
+	rtc_offset: rtc-offset@b0 {
+		reg = <0xb0 0x4>;
+	};
+};
+
 &pon_pwrkey {
 	status = "okay";
 };
