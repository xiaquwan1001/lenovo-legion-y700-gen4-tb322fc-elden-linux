+# base BoardConfig's llvmpipe/swrast/r300/zink set, which forces
+# MESON_GEN_LLVM_STUB -> -Dllvm=enabled -> libLLVM22 (hours). Narrowing to a
+# single driver avoids the LLVM stub and cuts the build to minutes.
+BOARD_MESA3D_GALLIUM_DRIVERS := freedreno
+BOARD_MESA3D_VULKAN_DRIVERS := freedreno
