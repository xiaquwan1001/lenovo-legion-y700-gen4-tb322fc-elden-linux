#!/bin/sh
# PID 1 for the in-RAM Alpine rootfs on Lenovo TB322FC (mainline bring-up).
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mountpoint -q /dev || mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm /run /tmp
mount -t devpts -o gid=5,mode=620 devpts /dev/pts
mount -t tmpfs tmpfs /dev/shm
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
mount -t configfs configfs /sys/kernel/config
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null

# cgroup2 single hierarchy — required by LXC/Waydroid containers. Mounted here
# so it is moved into the new root by switch_root and reused by /init there.
mkdir -p /sys/fs/cgroup
mountpoint -q /sys/fs/cgroup || mount -t cgroup2 none /sys/fs/cgroup 2>/dev/null

# binderfs — Android/Waydroid binder devices (binder/hwbinder/vndbinder are
# created via binder-control by waydroid's setupBinderNodes at init/session).
mkdir -p /dev/binderfs
mountpoint -q /dev/binderfs || mount -t binder binder /dev/binderfs 2>/dev/null

echo 8 > /proc/sys/kernel/printk
hostname elden

# Are we on the initramfs (RAM root) or already on a disk root? Guards below
# must not run again after switch_root (else /persist would mount over root).
roottype=$(stat -f -c %T / 2>/dev/null)
case "$roottype" in
	rootfs|tmpfs|ramfs) on_initramfs=1 ;;
	*) on_initramfs=0 ;;
esac
echo "[init] root fs type=$roottype on_initramfs=$on_initramfs" > /dev/kmsg
# --- elden sleep policy (PITFALLS §64) -------------------------------------
# Prefer s2idle: "deep" (PSCI system suspend) is not supported by this tree and
# hangs the machine on first suspend. Only switch if the kernel offers s2idle.
if [ -w /sys/power/mem_sleep ] && grep -q "s2idle" /sys/power/mem_sleep 2>/dev/null; then
	echo s2idle > /sys/power/mem_sleep 2>/dev/null
	echo "[init] sleep policy: mem_sleep=$(cat /sys/power/mem_sleep)" > /dev/kmsg
fi
# Make a soft lockup fatal so a hang is preserved in ramoops (pstore).
[ "$on_initramfs" = 0 ] && echo 1 > /proc/sys/kernel/softlockup_panic 2>/dev/null
# --- end elden sleep policy --------------------------------------------------

# Persistent data partition: LUN4 trailing 'last_parti' repurposed as ext4 'linux'
# (/dev/sde79, ~2.3 GiB). Only mount at /persist when running from the RAM
# initramfs; when /dev/sde79 itself is the root, this must be skipped.
if [ "$on_initramfs" = 1 ]; then
	mkdir -p /persist
	(
		i=0
		while [ ! -b /dev/sde79 ] && [ $i -lt 100 ]; do sleep 0.1; i=$((i+1)); done
		if mount -t ext4 -o rw,noatime /dev/sde79 /persist 2>/dev/null; then
			echo "[init] /persist mounted from /dev/sde79" > /dev/kmsg
		else
			echo "[init] WARNING: /dev/sde79 not mounted at /persist" > /dev/kmsg
		fi
	) &
fi

# Boot a persistent on-disk root when requested:
#   elden_root=LABEL=linux | UUID=... | /dev/sde79 ...
# Falls back to the in-RAM Alpine environment if discovery/switch_root fails.
elden_root=""
for arg in $(cat /proc/cmdline); do
	case "$arg" in
		elden_root=*) elden_root=${arg#elden_root=} ;;
		ubuntu_root=*) elden_root=${arg#ubuntu_root=} ;;
	esac
done

if [ "$on_initramfs" = 1 ] && [ -n "$elden_root" ]; then
	root_dev=""
	i=0
	while [ -z "$root_dev" ] && [ "$i" -lt 150 ]; do
		case "$elden_root" in
			UUID=*) root_dev=$(blkid -t "$elden_root" -o device 2>/dev/null | head -n1); [ -n "$root_dev" ] || root_dev=$(findfs "$elden_root" 2>/dev/null) ;;
			LABEL=*) root_dev=$(blkid -L "${elden_root#LABEL=}" 2>/dev/null); [ -n "$root_dev" ] || root_dev=$(findfs "$elden_root" 2>/dev/null) ;;
			PARTLABEL=*) root_dev=$(blkid -t "$elden_root" -o device 2>/dev/null | head -n1) ;;
			/dev/*) [ -b "$elden_root" ] && root_dev=$elden_root ;;
		esac
		[ -n "$root_dev" ] || sleep 0.1
		i=$((i + 1))
	done

	mkdir -p /newroot
	if [ -n "$root_dev" ] && mount -t ext4 -o rw,noatime "$root_dev" /newroot; then
		newinit=""
		[ -x /newroot/init ] && newinit=/init
		[ -z "$newinit" ] && [ -x /newroot/sbin/init ] && newinit=/sbin/init
		if [ -n "$newinit" ]; then
			echo "[init] switching root to $root_dev ($newinit)" > /dev/kmsg
			mkdir -p /newroot/dev /newroot/proc /newroot/sys /newroot/run
			umount /tmp 2>/dev/null || true
			mount --move /dev /newroot/dev
			mount --move /proc /newroot/proc
			mount --move /sys /newroot/sys
			mount --move /run /newroot/run
			exec switch_root /newroot "$newinit"
		fi
	fi
	echo "[init] WARNING: elden_root failed ($elden_root)" > /dev/kmsg
	umount /newroot 2>/dev/null || true
fi

echo "[init] Alpine rootfs up, kernel $(uname -r)" > /dev/kmsg

# USB: NCM network + ACM console composite (see /usr/local/sbin/usb-gadget).
# Waits for the dwc3 UDC to appear, so run it in the background and set up
# networking once usb0 exists.
ip link set lo up
(
	/usr/local/sbin/usb-gadget start
	i=0
	while [ ! -d /sys/class/net/usb0 ] && [ $i -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
	if [ -d /sys/class/net/usb0 ]; then
		ip link set usb0 up
		ip addr add 192.168.7.1/24 dev usb0
		udhcpd -S /etc/udhcpd.conf
		echo "[init] usb0 up: 192.168.7.1, ssh root@192.168.7.1 (no password)" > /dev/kmsg
	else
		echo "[init] WARNING: usb0 never appeared" > /dev/kmsg
	fi
) &

# sshd (host keys generated at image build time)
# sshd refuses to start unless /var/empty is root-owned and not group/world
# writable. A tree copied with tar/rsync may carry foreign uids, so enforce it.
mkdir -p /var/empty
chown 0:0 /var/empty 2>/dev/null
chmod 755 /var/empty 2>/dev/null
/usr/sbin/sshd -E /run/sshd.log

dmesg > /run/dmesg-boot.txt

respawn() {
	while true; do
		[ -c "/dev/$1" ] && setsid getty -n -l /bin/sh -L "$1" 115200 vt100
		sleep 1
	done
}
# B1 environment probe: harvest firmware/DT/config and inventory UFS.
if [ "$on_initramfs" = 1 ] && [ -x /root/probe.sh ]; then
	( /root/probe.sh > /root/probe.log 2>&1; echo "[init] probe finished" > /dev/kmsg ) &
fi

# --- system D-Bus: single early owner (NM/UPower/polkit depend on it) ---
if [ "$on_initramfs" = 0 ]; then
	mkdir -p /run/dbus
	chown root:messagebus /usr/libexec/dbus-daemon-launch-helper 2>/dev/null
	chmod 4750 /usr/libexec/dbus-daemon-launch-helper 2>/dev/null
	if [ ! -S /run/dbus/system_bus_socket ]; then
		setsid dbus-daemon --system >/run/dbus.log 2>&1
		i=0
		while [ ! -S /run/dbus/system_bus_socket ] && [ "$i" -lt 50 ]; do sleep 0.1; i=$((i+1)); done
	fi
	echo "[init] system dbus: $([ -S /run/dbus/system_bus_socket ] && echo up || echo FAILED)" > /dev/kmsg
fi
[ "$on_initramfs" = 0 ] && [ -x /usr/local/sbin/ath12k-retry.sh ] && setsid /usr/local/sbin/ath12k-retry.sh >/run/ath12k-retry.log 2>&1 &
[ "$on_initramfs" = 0 ] && [ -x /usr/local/sbin/net-up.sh ] && setsid /usr/local/sbin/net-up.sh >/run/net-up.log 2>&1 &
[ "$on_initramfs" = 0 ] && [ -x /usr/local/sbin/time-sync.sh ] && setsid /usr/local/sbin/time-sync.sh >/dev/null 2>&1 &
[ "$on_initramfs" = 0 ] && [ -x /usr/local/sbin/charge-watch.sh ] && setsid /usr/local/sbin/charge-watch.sh >/run/charge-watch.log 2>&1 &
[ "$on_initramfs" = 0 ] && [ -x /usr/local/sbin/bt-up.sh ] && setsid /usr/local/sbin/bt-up.sh >/run/bt-up.log 2>&1 &
respawn ttyGS0 &
# GS1: 带外 root shell，与 kernel console(GS0) 分开，回显不被 dmesg 污染
respawn ttyGS1 &
if [ "$on_initramfs" = 0 ] && [ -x /usr/local/sbin/start-desktop.sh ]; then
	/usr/local/sbin/start-desktop.sh &
else
	respawn tty1 &
fi

trap 'reboot -f' INT TERM
while true; do sleep 3600; done
